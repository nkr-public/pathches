+}
+
+export interface GenericSearchProps<TValues extends object = SearchValues, TRow = unknown> {
+  readonly metadata: SearchTableMetadata | OracleTableMetadata;
+  readonly persistenceProvider?: SearchPersistenceProvider | null;
+  readonly translateProvider?: TranslateProvider;
+  readonly dataProvider?: SearchDataProvider<TRow>;
+  readonly operatorRegistry?: OperatorRegistry;
+  readonly fieldRenderers?: Partial<Record<Extract<keyof TValues, string>, FieldRenderer>>;
+  readonly optionProviders?: Partial<Record<Extract<keyof TValues, string>, OptionProvider>>;
+  readonly layout?: LayoutOptions;
