+import * as factory from '@dec/cr-factory';
+import type { FieldRule, TableMetaData } from '@dec/cr-factory';
+import { normalizeOracleMetadata, type SearchTableMetadata } from '@dec/ui/search';
+
+const JDBC_CODES: Record<string, number> = {
+  BIT: -7, TINYINT: -6, SMALLINT: 5, INTEGER: 4, BIGINT: -5, FLOAT: 6, REAL: 7, DOUBLE: 8,
+  NUMERIC: 2, DECIMAL: 3, NUMBER: 2, CHAR: 1, VARCHAR: 12, LONGVARCHAR: -1, NCHAR: -15, NVARCHAR: -9,
+  DATE: 91, TIME: 92, TIMESTAMP: 93, BLOB: 2004, CLOB: 2005, NCLOB: 2011, BOOLEAN: 16,
+  OTHER: 1111, ARRAY: 2003, STRUCT: 2002, REF: 2006,
+};
+
+const ORACLE_CODES: Record<string, number> = {
+  VARCHAR2: 12, NVARCHAR2: -9, CHAR: 1, NCHAR: -15, NUMBER: 2, FLOAT: 6, BINARY_FLOAT: 100, BINARY_DOUBLE: 101,
+  DATE: 93, TIMESTAMP: 93, TIMESTAMP_WITH_TZ: -101, TIMESTAMP_WITH_LTZ: -102,
+  CLOB: 2005, BLOB: 2004, BFILE: -13, RAW: -3, LONG: -1, ROWID: -8, UROWID: -8,
+  INTERVAL_YEAR_TO_MONTH: -103, INTERVAL_DAY_TO_SECOND: -104, XMLTYPE: 2009, JSON: 1111,
+};
+
+const BY_FIELD_TYPE: Record<FieldRule['type'], number> = { string: 12, number: 2, boolean: 16, date: 93 };
+const UNSPECIFIED_SCALE = -127;
+
+function jdbcCodeOf(f: FieldRule): number {
+  if (f.jdbcType && f.jdbcType in JDBC_CODES) return JDBC_CODES[f.jdbcType];
+  if (f.columnType && f.columnType in ORACLE_CODES) return ORACLE_CODES[f.columnType];
+  return BY_FIELD_TYPE[f.type];
+}
+
+export function toSearchMetadata(table: TableMetaData): SearchTableMetadata {
+  const fields = table.fields;
+  const indexOfColumn = new Map(fields.map((f, i) => [f.columnName ?? f.field, i]));
+  const codes = fields.map(jdbcCodeOf);
+  const isNumeric = (code: number) => [2, 3, 4, 5, 6, 7, 8, -5, -6, 100, 101].includes(code);
+  const keys = fields.flatMap((f, i) => (f.isPrimaryKey || table.primaryKey.includes(f.columnName ?? '') ? [i] : []));
+  const indexes = (table.indexes ?? []).flatMap((ix) => {
+    const columns = ix.columns.map((c) => indexOfColumn.get(c));
+    return columns.every((c): c is number => c !== undefined) && columns.length > 0 ? [{ unique: ix.unique, columns }] : [];
+  });
+  return normalizeOracleMetadata({
+    name: table.tableName,
+    numRows: table.nbRows,
+    labels: fields.map((f) => f.field),
+    dNames: fields.map((f) => f.columnName ?? f.field),
+    dTypes: codes,
+    precisions: fields.map((f) => f.size ?? f.max ?? 0),
+    scales: fields.map((f, i) => f.decimalPrecision ?? (isNumeric(codes[i]) && !(f.size ?? f.max) ? UNSPECIFIED_SCALE : 0)),
+    defaults: fields.map((f) => f.nullable),
+    keys,
+    indexes,
+  });
+}
+
+function isTable(v: unknown): v is TableMetaData {
+  return typeof v === 'object' && v !== null && 'tableName' in v && Array.isArray((v as TableMetaData).fields);
+}
+
+export const TABLE_DEFINITIONS: readonly TableMetaData[] = Object.entries(factory)
+  .filter(([key, value]) => key !== 'UserDef' && isTable(value))
+  .map(([, value]) => value as TableMetaData);
+
+const cache = new Map<string, SearchTableMetadata>();
+export function searchMetadataFor(tableName: string): SearchTableMetadata | undefined {
+  const hit = cache.get(tableName);
+  if (hit) return hit;
+  const def = TABLE_DEFINITIONS.find((t) => t.tableName === tableName);
+  if (!def) return undefined;
+  const meta = toSearchMetadata(def);
+  cache.set(tableName, meta);
+  return meta;
+}
