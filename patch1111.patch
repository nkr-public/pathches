-import { fileURLToPath } from "node:url";
-import { join } from "node:path";
-import { compileDefinitions } from "./compiler.ts";
-
-const root = fileURLToPath(new URL("..", import.meta.url));
-const memoryBefore = process.memoryUsage().heapUsed;
-
-try {
-  const report = compileDefinitions({
-    resourcesDir: join(root, "resources"),
-    outDir: join(root, "src", "defs"),
-    stateFile: join(root, ".cache", "definitions-state.json"),
-    force: process.argv.includes("--force")
-  });
-  const rows = Object.entries(report.tables).map(([table, s]) => ({
-    table,
-    status: report.compiled.includes(table) ? "compiled" : "skipped",
-    fingerprint: s.fingerprint,
-    jsonBytes: s.metrics.sourceBytes,
-    binaryBytes: s.metrics.binaryBytes,
-    binaryGzip: s.metrics.binaryGzipBytes,
-    moduleBytes: s.metrics.moduleBytes,
-    moduleGzip: s.metrics.moduleGzipBytes,
-    decodeUs: s.metrics.decodeMicros
-  }));
-  console.table(rows);
-  if (report.removed.length > 0) console.log(`removed stale modules: ${report.removed.join(", ")}`);
-  const heapKb = Math.round((process.memoryUsage().heapUsed - memoryBefore) / 1024);
-  console.log(`compiled ${report.compiled.length}, skipped ${report.skipped.length}, removed ${report.removed.length} in ${report.durationMs.toFixed(1)} ms, heap delta ${heapKb} KiB`);
-} catch (e) {
-  console.error(e instanceof Error ? e.message : e);
