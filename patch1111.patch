+  readonly byType?: Readonly<Partial<Record<SearchColumnMetadata["dataType"], FieldRenderer>>>;
+}
+
+export class FieldRendererRegistry {
+  private readonly byField = new Map<string, FieldRenderer>();
+  private readonly byOperator = new Map<string, FieldRenderer>();
+  private readonly byType = new Map<string, FieldRenderer>([
+    ["STRING", TextSearchInput],
+    ["NUMBER", NumberSearchInput],
+    ["DATE", DateSearchInput],
+    ["TIME", TimeSearchInput],
+    ["TIMESTAMP", DateTimeSearchInput],
+    ["BOOLEAN", BooleanSearchInput]
+  ]);
+
+  constructor(options: FieldRendererRegistryOptions = {}) {
+    Object.entries(options.byField ?? {}).forEach(([k, v]) => this.byField.set(k, v));
+    Object.entries(options.byOperator ?? {}).forEach(([k, v]) => this.byOperator.set(k, v));
+    Object.entries(options.byType ?? {}).forEach(([k, v]) => v && this.byType.set(k, v));
+  }
