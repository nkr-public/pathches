+export type JdbcCategory = "numeric" | "text" | "date" | "time" | "timestamp" | "boolean" | "binary" | "other";
+
+export type InputKind = "number" | "text" | "date" | "time" | "datetime" | "checkbox" | "none";
+
+export type SearchOperator =
+  | "EQUALS"
+  | "NOT_EQUALS"
+  | "GREATER_THAN"
+  | "GREATER_OR_EQUAL"
+  | "LESS_THAN"
+  | "LESS_OR_EQUAL"
+  | "BETWEEN"
+  | "IN"
+  | "NOT_IN"
+  | "CONTAINS"
+  | "NOT_CONTAINS"
+  | "STARTS_WITH"
+  | "ENDS_WITH"
+  | "LIKE"
+  | "IS_NULL"
+  | "IS_NOT_NULL";
+
+export interface JdbcTypeInfo {
+  readonly code: number;
+  readonly name: string;
+  readonly category: JdbcCategory;
+  readonly known: boolean;
+}
+
+const entries: Array<[number, string, JdbcCategory]> = [
+  [-7, "BIT", "boolean"],
+  [-6, "TINYINT", "numeric"],
+  [5, "SMALLINT", "numeric"],
+  [4, "INTEGER", "numeric"],
+  [-5, "BIGINT", "numeric"],
+  [6, "FLOAT", "numeric"],
+  [7, "REAL", "numeric"],
+  [8, "DOUBLE", "numeric"],
+  [2, "NUMERIC", "numeric"],
+  [3, "DECIMAL", "numeric"],
+  [1, "CHAR", "text"],
+  [12, "VARCHAR", "text"],
+  [-1, "LONGVARCHAR", "text"],
+  [-15, "NCHAR", "text"],
+  [-9, "NVARCHAR", "text"],
+  [-16, "LONGNVARCHAR", "text"],
+  [91, "DATE", "date"],
+  [92, "TIME", "time"],
+  [93, "TIMESTAMP", "timestamp"],
+  [2013, "TIME_WITH_TIMEZONE", "time"],
+  [2014, "TIMESTAMP_WITH_TIMEZONE", "timestamp"],
+  [-2, "BINARY", "binary"],
+  [-3, "VARBINARY", "binary"],
+  [-4, "LONGVARBINARY", "binary"],
+  [0, "NULL", "other"],
+  [1111, "OTHER", "other"],
+  [2000, "JAVA_OBJECT", "other"],
+  [2001, "DISTINCT", "other"],
+  [2002, "STRUCT", "other"],
+  [2003, "ARRAY", "other"],
+  [2004, "BLOB", "binary"],
+  [2005, "CLOB", "text"],
+  [2006, "REF", "other"],
+  [70, "DATALINK", "other"],
+  [16, "BOOLEAN", "boolean"],
+  [-8, "ROWID", "other"],
+  [2011, "NCLOB", "text"],
+  [2009, "SQLXML", "other"],
+  [2012, "REF_CURSOR", "other"],
+  [-10, "ORACLE_CURSOR", "other"],
+  [-13, "ORACLE_BFILE", "binary"],
+  [100, "ORACLE_BINARY_FLOAT", "numeric"],
+  [101, "ORACLE_BINARY_DOUBLE", "numeric"],
+  [-100, "ORACLE_TIMESTAMPNS", "timestamp"],
+  [-101, "ORACLE_TIMESTAMPTZ", "timestamp"],
+  [-102, "ORACLE_TIMESTAMPLTZ", "timestamp"],
+  [-103, "ORACLE_INTERVALYM", "other"],
+  [-104, "ORACLE_INTERVALDS", "other"],
+  [-14, "ORACLE_PLSQL_INDEX_TABLE", "other"],
+  [999, "ORACLE_FIXED_CHAR", "text"],
+  [2016, "ORACLE_JSON", "text"]
+];
+
+const registry = new Map<number, JdbcTypeInfo>(entries.map(([code, name, category]) => [code, Object.freeze({ code, name, category, known: true })]));
+
+export function resolveJdbcType(code: number): JdbcTypeInfo {
+  return registry.get(code) ?? { code, name: `UNKNOWN(${code})`, category: "other", known: false };
+}
+
+export function jdbcTypeName(code: number): string {
+  return resolveJdbcType(code).name;
+}
+
+const inputKinds: Record<JdbcCategory, InputKind> = {
+  numeric: "number",
+  text: "text",
+  date: "date",
+  time: "time",
+  timestamp: "datetime",
+  boolean: "checkbox",
+  binary: "none",
+  other: "text"
+};
+
+export function inputKindFor(category: JdbcCategory): InputKind {
+  return inputKinds[category];
+}
+
+const comparison: SearchOperator[] = ["EQUALS", "NOT_EQUALS", "GREATER_THAN", "GREATER_OR_EQUAL", "LESS_THAN", "LESS_OR_EQUAL", "BETWEEN", "IN", "NOT_IN"];
+const textual: SearchOperator[] = ["EQUALS", "NOT_EQUALS", "IN", "NOT_IN", "CONTAINS", "NOT_CONTAINS", "STARTS_WITH", "ENDS_WITH", "LIKE"];
+
+export function operatorsFor(category: JdbcCategory, nullable: boolean): SearchOperator[] {
+  let base: SearchOperator[];
+  switch (category) {
+    case "numeric":
+    case "date":
+    case "time":
+    case "timestamp":
+      base = comparison;
+      break;
+    case "text":
+    case "other":
+      base = textual;
+      break;
+    case "boolean":
+      base = ["EQUALS", "NOT_EQUALS"];
+      break;
+    case "binary":
+      base = [];
+      break;
+  }
+  return nullable ? [...base, "IS_NULL", "IS_NOT_NULL"] : [...base];
+}
