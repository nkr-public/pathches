+  );
+  const baseFields = useMemo(() => {
+    const allowed = props.fields ? new Set<string>(props.fields) : null;
+    return searchable.filter((c) => !allowed || allowed.has(c.name)).map((c) => c.name);
+  }, [searchable, props.fields]);
+  const [fieldOrder, setFieldOrder] = useState<readonly string[]>(baseFields);
+  const [visible, setVisible] = useState<ReadonlySet<string>>(() => new Set(props.defaultVisibleFields ?? baseFields));
+  useEffect(() => {
+    setFieldOrder((prev) => {
+      const known = prev.filter((f) => baseFields.includes(f));
+      const added = baseFields.filter((f) => !known.includes(f));
+      return known.length === prev.length && added.length === 0 ? prev : [...known, ...added];
+    });
+  }, [baseFields]);
+
+  const labels = useMemo(() => new Map(metadata.columns.map((c) => [c.name, resolveLabel(c, translations)])), [metadata, translations]);
+  const operatorLabels = useMemo(() => {
+    const out: Record<string, string> = {};
+    for (const d of registry.all()) out[d.id] = translations?.operators?.[d.id] ?? d.label;
+    return out;
+  }, [registry, translations]);
+
+  const renderers = useMemo(() => new FieldRendererRegistry({ byField: props.fieldRenderers as Record<string, FieldRenderer> | undefined }), [props.fieldRenderers]);
