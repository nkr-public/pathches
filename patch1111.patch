-    `import { GenericSearch, normalizeOracleMetadata, type GenericSearchProps } from ${JSON.stringify(importFrom)};`,
-    ``,
-    `export const ${metaConst} = normalizeOracleMetadata(${JSON.stringify(raw, null, 2)});`,
-    ``,
-    `export interface ${valuesType} {`,
