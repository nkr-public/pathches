Index: packages/cr-tools/scripts/compiler.ts
===================================================================
diff --git a/packages/cr-tools/scripts/compiler.ts b/packages/cr-tools/scripts/compiler.ts
deleted file mode 100644
--- a/packages/cr-tools/scripts/compiler.ts	(revision 6fafa08c0cb0a2f78ae4817ecc93056dcd4b4a32)
+++ /dev/null	(revision 6fafa08c0cb0a2f78ae4817ecc93056dcd4b4a32)
@@ -1,171 +0,0 @@
-import { createHash } from "node:crypto";
-import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
-import { basename, dirname, join } from "node:path";
-import { gzipSync } from "node:zlib";
-import { encodeTableDefinition } from "../src/codec/BinaryEncoder.ts";
-import { decodeTableDefinition } from "../src/codec/BinaryDecoder.ts";
-import { BINARY_VERSION } from "../src/codec/BinaryVersion.ts";
-import {
-  canonicalize,
-  fingerprintTableDefinition,
-  validateTableDefinition,
-  type TableDefinition
-} from "../src/model/TableDefinition.ts";
-
-export const COMPILER_VERSION = 2;
-
-export interface CompileOptions {
-  readonly resourcesDir: string;
-  readonly outDir: string;
-  readonly stateFile: string;
-  readonly force?: boolean;
-}
-
-export interface TableMetrics {
-  readonly sourceBytes: number;
-  readonly binaryBytes: number;
-  readonly moduleBytes: number;
-  readonly moduleGzipBytes: number;
-  readonly binaryGzipBytes: number;
-  readonly decodeMicros: number;
-}
-
-export interface TableState {
-  readonly sourceHash: string;
-  readonly fingerprint: string;
-  readonly metrics: TableMetrics;
-}
-
-interface CompileState {
-  readonly compilerVersion: number;
-  readonly binaryVersion: number;
-  readonly tables: Record<string, TableState>;
-}
-
-export interface CompileReport {
-  readonly compiled: string[];
-  readonly skipped: string[];
-  readonly removed: string[];
-  readonly tables: Record<string, TableState>;
-  readonly durationMs: number;
-}
-
-export class CompileError extends Error {
-  constructor(file: string, cause: unknown) {
-    super(`${file}: ${cause instanceof Error ? cause.message : String(cause)}`);
-    this.name = "CompileError";
-  }
-}
-
-const IDENTIFIER = /^[A-Za-z_$][A-Za-z0-9_$]*$/;
-
-export function discoverResources(resourcesDir: string): string[] {
-  if (!existsSync(resourcesDir)) return [];
-  return readdirSync(resourcesDir, { withFileTypes: true })
-    .filter((e) => e.isFile() && e.name.endsWith(".json"))
-    .map((e) => e.name)
-    .sort();
-}
-
-export function generateModule(definition: TableDefinition, fingerprint: string): string {
-  const id = definition.name;
-  const lines = [
-    `import type { TableDefinition } from "../model/TableDefinition.js";`,
-    ``,
-    `export const ${id}_FINGERPRINT = ${JSON.stringify(fingerprint)};`,
-    ``,
-    `export const ${id} = ${JSON.stringify(definition, null, 2)} as const satisfies TableDefinition;`,
-    ``,
-    `export type ${id}_COLUMN = (typeof ${id}.labels)[number];`,
-    ``
-  ];
-  return lines.join("\n");
-}
-
-export function compileDefinition(file: string, text: string): { definition: TableDefinition; binary: Uint8Array; fingerprint: string; decodeMicros: number } {
-  let parsed: unknown;
-  try {
-    parsed = JSON.parse(text);
-  } catch (e) {
-    throw new CompileError(file, e);
-  }
-  try {
-    const definition = validateTableDefinition(parsed);
-    const expectedName = basename(file, ".json");
-    if (definition.name !== expectedName) throw new Error(`table name "${definition.name}" does not match file name "${expectedName}"`);
-    if (!IDENTIFIER.test(definition.name)) throw new Error(`table name "${definition.name}" is not a valid identifier`);
-    const binary = encodeTableDefinition(definition);
-    const again = encodeTableDefinition(definition);
-    if (Buffer.compare(Buffer.from(binary), Buffer.from(again)) !== 0) throw new Error("binary encoding is not deterministic");
-    const start = performance.now();
-    const decoded = decodeTableDefinition(binary);
-    const decodeMicros = Math.round((performance.now() - start) * 1000);
-    if (canonicalize(decoded) !== canonicalize(definition)) throw new Error("binary round-trip mismatch");
-    return { definition: decoded, binary, fingerprint: fingerprintTableDefinition(decoded), decodeMicros };
-  } catch (e) {
-    throw new CompileError(file, e);
-  }
-}
-
-function readState(stateFile: string): CompileState | undefined {
-  if (!existsSync(stateFile)) return undefined;
-  try {
-    const state = JSON.parse(readFileSync(stateFile, "utf8")) as CompileState;
-    if (state.compilerVersion !== COMPILER_VERSION || state.binaryVersion !== BINARY_VERSION) return undefined;
-    return state;
-  } catch {
-    return undefined;
-  }
-}
-
-export function compileDefinitions(options: CompileOptions): CompileReport {
-  const start = performance.now();
-  const previous = options.force ? undefined : readState(options.stateFile);
-  const files = discoverResources(options.resourcesDir);
-  mkdirSync(options.outDir, { recursive: true });
-  const tables: Record<string, TableState> = {};
-  const compiled: string[] = [];
-  const skipped: string[] = [];
-  const removed: string[] = [];
-
-  for (const file of files) {
-    const name = basename(file, ".json");
-    const text = readFileSync(join(options.resourcesDir, file), "utf8");
-    const sourceHash = createHash("sha256").update(text).digest("hex");
-    const target = join(options.outDir, `${name}.ts`);
-    const prior = previous?.tables[name];
-    if (prior && prior.sourceHash === sourceHash && existsSync(target)) {
-      tables[name] = prior;
-      skipped.push(name);
-      continue;
-    }
-    const result = compileDefinition(file, text);
-    const module = generateModule(result.definition, result.fingerprint);
-    writeFileSync(target, module);
-    tables[name] = {
-      sourceHash,
-      fingerprint: result.fingerprint,
-      metrics: {
-        sourceBytes: Buffer.byteLength(text),
-        binaryBytes: result.binary.length,
-        moduleBytes: Buffer.byteLength(module),
-        moduleGzipBytes: gzipSync(module, { level: 9 }).length,
-        binaryGzipBytes: gzipSync(result.binary, { level: 9 }).length,
-        decodeMicros: result.decodeMicros
-      }
-    };
-    compiled.push(name);
-  }
-
-  for (const entry of readdirSync(options.outDir)) {
-    if (entry.endsWith(".ts") && !(basename(entry, ".ts") in tables)) {
-      rmSync(join(options.outDir, entry));
-      removed.push(basename(entry, ".ts"));
-    }
-  }
-
-  mkdirSync(dirname(options.stateFile), { recursive: true });
-  const state: CompileState = { compilerVersion: COMPILER_VERSION, binaryVersion: BINARY_VERSION, tables };
-  writeFileSync(options.stateFile, JSON.stringify(state, null, 2) + "\n");
-  return { compiled, skipped, removed, tables, durationMs: performance.now() - start };
-}
