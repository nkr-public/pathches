+          <button
+            type="button"
+            className={`dsh-icon dsh-icon--solo${errorCount > 0 ? " dsh-icon--alert" : ""}`}
+            style={{ "--tone": errorCount > 0 ? "var(--dsh-err)" : "var(--dsh-muted)" } as CSSProperties}
+            aria-label={`${m.notifications} (${errorCount})`}
+            aria-expanded={bellOpen}
+            onClick={() => setBellOpen((x) => !x)}
+          >
+            <BellIcon size={15} strokeWidth={2} />
+            <Tip text={`${m.notifications} · ${errorCount}`} align="end" />
+            {errorCount > 0 && <span className="dsh-badge">{errorCount > 99 ? "99+" : errorCount}</span>}
+          </button>
+          {bellOpen && (
+            <div className="dsh-panel" role="dialog" aria-label={m.notifications}>
+              <div className="dsh-panel-head">
+                <span>
+                  <AlertTriangle size={13} /> {m.notifications}
+                </span>
+                {errorCount > 0 && (
+                  <button type="button" className="dsh-link" onClick={p.onClearErrors}>
+                    {m.clearAll}
+                  </button>
+                )}
+              </div>
+              {errorCount === 0 ? (
+                <div className="dsh-panel-empty">
+                  <CheckCircle2 size={18} />
+                  {m.noErrors}
+                </div>
+              ) : (
+                <ul className="dsh-panel-list">
+                  {p.errors.map((e) => (
+                    <li key={e.id} className="dsh-err">
+                      <XCircle size={14} className="dsh-err-icon" />
+                      <div className="dsh-err-body">
+                        <span className="dsh-err-msg">{e.message}</span>
+                        <span className="dsh-err-meta">{[e.source, formatTime(e.time)].filter(Boolean).join(" · ")}</span>
+                      </div>
+                      <button type="button" className="dsh-err-close" aria-label={m.dismiss} onClick={() => p.onDismissError(e.id)}>
+                        <X size={13} />
+                        <Tip text={m.dismiss} align="end" />
+                      </button>
+                    </li>
+                  ))}
+                </ul>
+              )}
+            </div>
+          )}
+        </div>
+        {running ? (
+          <button type="button" className="dsh-go dsh-go--stop" onClick={p.onCancel} disabled={p.disabled}>
+            <Square size={13} strokeWidth={2.6} fill="currentColor" />
+            <span className="dsh-go-shine" aria-hidden />
+            <span>{m.stop}</span>
+            <Tip text={m.stop} align="end" />
+          </button>
+        ) : (
+          <button type="button" className="dsh-go" onClick={p.onSearch} disabled={p.disabled}>
+            <Search size={15} strokeWidth={2.6} />
+            <span className="dsh-go-shine" aria-hidden />
+            <span>{m.search}</span>
+            <Tip text={`${m.search} · Ctrl+Enter`} align="end" />
+          </button>
+        )}
+      </div>
+    </div>
+  );
+});
