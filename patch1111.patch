+
+const metadataCache = new WeakMap<object, SearchTableMetadata>();
+
+function isNormalized(m: SearchTableMetadata | OracleTableMetadata): m is SearchTableMetadata {
+  return (m as SearchTableMetadata).byName instanceof Map;
+}
+
+export function useSearchMetadata(m: SearchTableMetadata | OracleTableMetadata): SearchTableMetadata {
+  if (isNormalized(m)) return m;
+  let n = metadataCache.get(m);
+  if (!n) {
+    n = normalizeOracleMetadata(m);
+    metadataCache.set(m, n);
+  }
+  return n;
+}
+
