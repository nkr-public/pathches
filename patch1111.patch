+export interface FieldLayoutMetrics {
+  readonly fieldId: string;
+  readonly minWidth: number;
+  readonly preferredWidth: number;
+  readonly maxWidth: number;
+  readonly priority: number;
+  readonly order: number;
+  readonly flexible: boolean;
+}
+
+export interface LayoutItem {
+  readonly fieldId: string;
+  readonly row: number;
+  readonly column: number;
+  readonly x: number;
+  readonly width: number;
+}
+
+export interface LayoutRow {
+  readonly items: readonly LayoutItem[];
+  readonly usedWidth: number;
+  readonly freeWidth: number;
+}
+
+export interface SearchLayout {
+  readonly containerWidth: number;
+  readonly gap: number;
+  readonly rows: readonly LayoutRow[];
+  readonly items: ReadonlyMap<string, LayoutItem>;
+  readonly order: readonly string[];
+  readonly utilization: number;
+}
+
+export type LayoutMode = "ordered" | "optimized";
+
+export interface SearchLayoutEngine {
+  calculate(fields: readonly FieldLayoutMetrics[], containerWidth: number, gap: number): SearchLayout;
+}
+
+export interface LayoutOptions {
+  readonly mode?: LayoutMode;
+  readonly gap?: number;
+  readonly minFieldWidth?: number;
+  readonly maxFieldWidth?: number;
+  readonly preservePriority?: boolean;
+  readonly stretch?: boolean;
+}
+
+interface Box {
+  readonly m: FieldLayoutMetrics;
+  readonly min: number;
+  readonly pref: number;
+  readonly max: number;
+}
+
+function clampBoxes(fields: readonly FieldLayoutMetrics[], width: number, options: LayoutOptions): Box[] {
+  const gMin = options.minFieldWidth ?? 0;
+  const gMax = options.maxFieldWidth ?? Number.POSITIVE_INFINITY;
+  return fields.map((m) => {
+    const max = Math.max(1, Math.min(width, gMax, m.maxWidth > 0 ? m.maxWidth : Number.POSITIVE_INFINITY));
+    const min = Math.min(max, Math.max(1, gMin, m.minWidth));
+    const pref = Math.min(max, Math.max(min, m.preferredWidth));
+    return { m, min, pref, max };
+  });
+}
+
+function rowWidth(row: Box[], gap: number): number {
+  return row.reduce((s, b) => s + b.pref, 0) + gap * Math.max(0, row.length - 1);
+}
+
+function finalizeRow(row: Box[], rowIndex: number, width: number, gap: number, stretch: boolean): LayoutRow {
+  const widths = row.map((b) => b.pref);
+  const gaps = gap * Math.max(0, row.length - 1);
+  let free = width - gaps - widths.reduce((s, w) => s + w, 0);
+  if (free < 0) {
+    for (let pass = 0; pass < 4 && free < -0.5; pass++) {
+      const shrinkable = row.map((b, i) => widths[i] - b.min);
+      const total = shrinkable.reduce((s, v) => s + v, 0);
+      if (total <= 0) break;
+      const ratio = Math.min(1, -free / total);
+      row.forEach((_, i) => (widths[i] -= shrinkable[i] * ratio));
+      free = width - gaps - widths.reduce((s, w) => s + w, 0);
+    }
+    if (free < 0) {
+      const scale = Math.max(0, width - gaps) / widths.reduce((s, w) => s + w, 0);
+      row.forEach((_, i) => (widths[i] *= scale));
+      free = 0;
+    }
+  } else if (stretch) {
+    for (let pass = 0; pass < row.length && free > 0.5; pass++) {
+      const growable = row.map((b, i) => (b.m.flexible ? b.max - widths[i] : 0));
+      const candidates = growable.filter((g) => g > 0.5).length;
+      if (candidates === 0) break;
+      const share = free / candidates;
+      row.forEach((_, i) => {
+        if (growable[i] > 0.5) widths[i] += Math.min(share, growable[i]);
+      });
+      free = width - gaps - widths.reduce((s, w) => s + w, 0);
+    }
+  }
+  let x = 0;
+  const items = row.map((b, i) => {
+    const w = Math.floor(widths[i]);
+    const item = { fieldId: b.m.fieldId, row: rowIndex, column: i, x, width: w };
+    x += w + gap;
+    return item;
+  });
+  const used = items.reduce((s, it) => s + it.width, 0) + gaps;
+  return { items, usedWidth: used, freeWidth: Math.max(0, width - used) };
+}
+
+function packOrdered(boxes: Box[], width: number, gap: number): Box[][] {
+  const rows: Box[][] = [];
+  let current: Box[] = [];
+  let used = 0;
+  for (const b of boxes) {
+    const need = current.length === 0 ? b.pref : used + gap + b.pref;
+    if (current.length > 0 && need > width) {
+      rows.push(current);
+      current = [b];
+      used = b.pref;
+    } else {
+      current.push(b);
+      used = need;
+    }
+  }
+  if (current.length > 0) rows.push(current);
+  return rows;
+}
+
+function packOptimized(boxes: Box[], width: number, gap: number, preservePriority: boolean): Box[][] {
+  const buckets = new Map<number, Box[]>();
+  for (const b of boxes) {
+    const key = preservePriority ? b.m.priority : 0;
+    const list = buckets.get(key);
+    if (list) list.push(b);
+    else buckets.set(key, [b]);
+  }
+  const keys = [...buckets.keys()].sort((a, b) => b - a);
+  const result: Box[][] = [];
+  for (const key of keys) {
+    const items = buckets.get(key)!.slice().sort((a, b) => b.pref - a.pref || a.m.order - b.m.order);
+    const rows: { boxes: Box[]; free: number }[] = [];
+    for (const b of items) {
+      let best = -1;
+      let bestFree = Number.POSITIVE_INFINITY;
+      for (let i = 0; i < rows.length; i++) {
+        const remaining = rows[i].free - gap - b.pref;
+        if (remaining >= 0 && remaining < bestFree) {
+          best = i;
+          bestFree = remaining;
+          if (remaining === 0) break;
+        }
+      }
+      if (best >= 0) {
+        rows[best].boxes.push(b);
+        rows[best].free = bestFree;
+      } else {
+        rows.push({ boxes: [b], free: width - b.pref });
+      }
+    }
+    for (const r of rows) r.boxes.sort((a, b) => a.m.order - b.m.order);
+    rows.sort((a, b) => a.boxes[0].m.order - b.boxes[0].m.order);
+    result.push(...rows.map((r) => r.boxes));
+  }
+  return result;
+}
+
+export function createLayoutEngine(options: LayoutOptions = {}): SearchLayoutEngine {
+  return {
+    calculate(fields, containerWidth, gap) {
+      const width = Math.max(1, Math.floor(containerWidth));
+      const boxes = clampBoxes(fields, width, options).sort((a, b) => a.m.order - b.m.order);
+      const packed = options.mode === "optimized" ? packOptimized(boxes, width, gap, options.preservePriority ?? false) : packOrdered(boxes, width, gap);
+      const rows = packed.map((r, i) => finalizeRow(r, i, width, gap, options.stretch ?? true));
+      const items = new Map<string, LayoutItem>();
+      const order: string[] = [];
+      rows.forEach((r) => r.items.forEach((it) => (items.set(it.fieldId, it), order.push(it.fieldId))));
+      const preferredUse = packed.length === 0 ? 1 : packed.reduce((s, r) => s + Math.min(width, rowWidth(r, gap)), 0) / (packed.length * width);
+      return { containerWidth: width, gap, rows, items, order, utilization: preferredUse };
+    }
+  };
+}
+
+export function layoutsEqual(a: SearchLayout | null, b: SearchLayout | null): boolean {
+  if (a === b) return true;
+  if (!a || !b || a.items.size !== b.items.size || a.containerWidth !== b.containerWidth) return false;
+  for (const [id, it] of a.items) {
+    const o = b.items.get(id);
+    if (!o || o.row !== it.row || o.column !== it.column || o.width !== it.width || o.x !== it.x) return false;
+  }
+  return true;
+}
