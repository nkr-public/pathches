+  const values = useMemo(() => toSearchValues(query, registry) as TValues, [query, registry]);
+  const activeCount = useMemo(() => [...primaries.values()].filter((c) => c.enabled && c.values.some((v) => v !== "")).length, [primaries]);
+
+  const renderedFields = useMemo(
+    () => fieldOrder.filter((f) => !props.isFieldVisible || props.isFieldVisible(f as Extract<keyof TValues, string>, values)),
