+import { memo } from "react";
+import type { SearchTableMetadata } from "../core/metadata.js";
+import type { OperatorFilterOptions, OperatorRegistry } from "../core/operators.js";
+import { isGroup, type SearchCondition, type SearchGroup } from "../core/query.js";
+import type { FieldRendererRegistry } from "./inputs.js";
+import type { SearchMessages } from "./messages.js";
+
+export interface AdvancedPanelProps {
+  readonly query: SearchGroup;
+  readonly metadata: SearchTableMetadata;
+  readonly registry: OperatorRegistry;
+  readonly renderers: FieldRendererRegistry;
+  readonly operatorOptions: OperatorFilterOptions;
+  readonly labels: ReadonlyMap<string, string>;
+  readonly operatorLabels: Readonly<Record<string, string>>;
+  readonly messages: SearchMessages;
+  readonly onCombinator: (groupId: string, combinator: "AND" | "OR") => void;
+  readonly onAddCondition: (groupId: string, field: string) => void;
+  readonly onAddGroup: (groupId: string) => void;
+  readonly onRemove: (id: string) => void;
+  readonly onDuplicate: (id: string) => void;
+  readonly onToggle: (id: string, enabled: boolean) => void;
+  readonly onOperator: (id: string, operator: string) => void;
+  readonly onValues: (id: string, values: string[]) => void;
+  readonly onField: (id: string, field: string) => void;
+}
+
+const Condition = memo(function Condition({ c, p }: { c: SearchCondition; p: AdvancedPanelProps }) {
+  const column = p.metadata.byName.get(c.field);
+  if (!column) {
+    return (
+      <div className="dec-search__adv-condition" role="group">
+        <span className="dec-search__error">{p.messages.missingColumn.replace("{field}", c.field)}</span>
+        <button type="button" className="dec-search__button" onClick={() => p.onRemove(c.id)}>
+          {p.messages.remove}
+        </button>
+      </div>
+    );
+  }
+  const ops = p.registry.forColumn(column, p.operatorOptions);
+  const op = ops.find((o) => o.id === c.operator) ?? p.registry.get(c.operator);
+  const Renderer = op ? p.renderers.resolve(column, op) : null;
+  const label = p.labels.get(c.field) ?? c.field;
+  return (
+    <div className="dec-search__adv-condition" role="group" aria-label={label}>
+      <input type="checkbox" checked={c.enabled} aria-label={p.messages.enabled} onChange={(e) => p.onToggle(c.id, e.target.checked)} />
+      <select className="dec-search__select" aria-label={p.messages.field} value={c.field} onChange={(e) => p.onField(c.id, e.target.value)}>
+        {p.metadata.columns
+          .filter((col) => col.dataType !== "UNSUPPORTED")
+          .map((col) => (
+            <option key={col.name} value={col.name}>
+              {p.labels.get(col.name) ?? col.name}
+            </option>
+          ))}
+      </select>
+      <select className="dec-search__operator" aria-label={p.messages.operator} value={c.operator} onChange={(e) => p.onOperator(c.id, e.target.value)}>
+        {ops.map((o) => (
+          <option key={o.id} value={o.id}>
+            {p.operatorLabels[o.id] ?? o.label}
+          </option>
+        ))}
+      </select>
+      {Renderer && op && <Renderer id={`adv-${c.id}`} column={column} operator={op} values={c.values} onChange={(v) => p.onValues(c.id, v)} label={label} />}
+      <button type="button" className="dec-search__button" onClick={() => p.onDuplicate(c.id)}>
+        {p.messages.duplicate}
+      </button>
+      <button type="button" className="dec-search__button" onClick={() => p.onRemove(c.id)}>
+        {p.messages.remove}
+      </button>
+    </div>
+  );
+});
+
+function Group({ g, p, root }: { g: SearchGroup; p: AdvancedPanelProps; root: boolean }) {
+  const first = p.metadata.columns.find((c) => c.dataType !== "UNSUPPORTED")?.name;
+  return (
+    <div className="dec-search__group" role="group" aria-label={p.messages.group}>
+      <div className="dec-search__group-header">
+        <select className="dec-search__select" aria-label={p.messages.combinator} value={g.combinator} onChange={(e) => p.onCombinator(g.id, e.target.value as "AND" | "OR")}>
+          <option value="AND">{p.messages.and}</option>
+          <option value="OR">{p.messages.or}</option>
+        </select>
+        {first && (
+          <button type="button" className="dec-search__button" onClick={() => p.onAddCondition(g.id, first)}>
+            {p.messages.addCondition}
+          </button>
+        )}
+        <button type="button" className="dec-search__button" onClick={() => p.onAddGroup(g.id)}>
+          {p.messages.addGroup}
+        </button>
+        {!root && (
+          <>
+            <button type="button" className="dec-search__button" onClick={() => p.onDuplicate(g.id)}>
+              {p.messages.duplicate}
+            </button>
+            <button type="button" className="dec-search__button" onClick={() => p.onRemove(g.id)}>
+              {p.messages.removeGroup}
+            </button>
+          </>
+        )}
+      </div>
+      {g.children.map((c) => (isGroup(c) ? <Group key={c.id} g={c} p={p} root={false} /> : <Condition key={c.id} c={c} p={p} />))}
+    </div>
+  );
+}
+
+export default function AdvancedPanel(p: AdvancedPanelProps) {
+  return (
+    <section className="dec-search__advanced" aria-label={p.messages.advanced}>
+      <Group g={p.query} p={p} root />
+    </section>
+  );
+}
