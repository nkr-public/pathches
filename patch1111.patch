diff --git a/packages/cr-tools/scripts/generate-search.ts b/packages/cr-tools/scripts/generate-search.ts
deleted file mode 100644
--- a/packages/cr-tools/scripts/generate-search.ts	(revision 6fafa08c0cb0a2f78ae4817ecc93056dcd4b4a32)
+++ /dev/null	(revision 6fafa08c0cb0a2f78ae4817ecc93056dcd4b4a32)
@@ -1,91 +0,0 @@
-import { existsSync, mkdirSync, readdirSync, readFileSync, statSync, unlinkSync, writeFileSync } from "node:fs";
-import { dirname, join, resolve } from "node:path";
-import { fileURLToPath } from "node:url";
-import { generateSearchComponents, type GenerateOptions } from "../src/search/generator.ts";
-
-export interface GenerateSearchFilesOptions extends GenerateOptions {
-  readonly inputs: readonly string[];
-  readonly outDir: string;
-  readonly tables?: readonly string[];
-}
-
-export interface GenerateSearchFilesReport {
-  readonly written: readonly string[];
-  readonly unchanged: readonly string[];
-  readonly removed: readonly string[];
-}
-
-function collect(inputs: readonly string[]): string[] {
-  const files: string[] = [];
-  for (const input of inputs) {
-    if (statSync(input).isDirectory()) {
-      for (const f of readdirSync(input).sort()) {
-        const p = join(input, f);
-        if (f.endsWith(".json") && statSync(p).isFile()) files.push(p);
-      }
-    } else {
-      files.push(input);
-    }
-  }
-  return files;
-}
-
-function writeIfChanged(path: string, content: string, report: { written: string[]; unchanged: string[] }): void {
-  if (existsSync(path) && readFileSync(path, "utf8") === content) report.unchanged.push(path);
-  else {
-    writeFileSync(path, content, "utf8");
-    report.written.push(path);
-  }
-}
-
-export function generateSearchFiles(options: GenerateSearchFilesOptions): GenerateSearchFilesReport {
-  const wanted = options.tables && options.tables.length > 0 ? new Set(options.tables.map((t) => t.toUpperCase())) : null;
-  const metadata = collect(options.inputs)
-    .map((f) => {
-      try {
-        return JSON.parse(readFileSync(f, "utf8")) as { name?: unknown };
-      } catch (e) {
-        throw new Error(`Unable to parse ${f}: ${(e as Error).message}`);
-      }
-    })
-    .filter((m) => typeof m.name === "string" && (!wanted || wanted.has((m.name as string).toUpperCase())));
-  const batch = generateSearchComponents(metadata, options);
-  mkdirSync(options.outDir, { recursive: true });
-  const report = { written: [] as string[], unchanged: [] as string[], removed: [] as string[] };
-  const expected = new Set(batch.components.map((c) => c.fileName));
-  for (const c of batch.components) writeIfChanged(join(options.outDir, c.fileName), c.source, report);
-  if (!wanted) {
-    writeIfChanged(join(options.outDir, "index.ts"), batch.index, report);
-    for (const f of readdirSync(options.outDir)) {
-      if (f.endsWith(".tsx") && f.startsWith(options.componentPrefix ?? "Search") && !expected.has(f)) {
-        unlinkSync(join(options.outDir, f));
-        report.removed.push(join(options.outDir, f));
-      }
-    }
-  }
-  return report;
-}
-
-function arg(name: string): string[] {
-  const out: string[] = [];
-  const argv = process.argv.slice(2);
-  argv.forEach((a, i) => {
-    if (a === `--${name}` && argv[i + 1]) out.push(argv[i + 1]);
-    else if (a.startsWith(`--${name}=`)) out.push(a.slice(name.length + 3));
-  });
-  return out;
-}
-
-if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
-  const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
-  const inputs = arg("input");
-  const report = generateSearchFiles({
-    inputs: inputs.length > 0 ? inputs.map((i) => resolve(i)) : [join(root, "resources")],
-    outDir: resolve(arg("out")[0] ?? join(root, "src", "search", "generated")),
-    importFrom: arg("import")[0] ?? "../base.js",
-    tables: arg("table").flatMap((t) => t.split(","))
-  });
-  console.log(`search components: written ${report.written.length}, unchanged ${report.unchanged.length}, removed ${report.removed.length}`);
-  report.written.forEach((f) => console.log(`  + ${f}`));
-  report.removed.forEach((f) => console.log(`  - ${f}`));
-}
