+import type { SearchColumnMetadata, SearchTableMetadata } from "./metadata.js";
+import type { SearchGroup } from "./query.js";
+
+export interface SearchTranslations {
+  readonly labels?: readonly (string | null | undefined)[];
+  readonly operators?: Readonly<Record<string, string>>;
+  readonly messages?: Readonly<Record<string, string>>;
+}
+
+export interface TranslateProvider {
+  readonly language: string;
+  get(tableName: string): SearchTranslations | null | undefined;
+  subscribe?(listener: () => void): () => void;
+}
+
+export function resolveLabel(column: SearchColumnMetadata, translations: SearchTranslations | null | undefined): string {
+  const t = translations?.labels?.[column.index];
+  if (typeof t === "string" && t.trim() !== "") return t;
+  if (column.displayName.trim() !== "") return column.displayName;
+  return column.name;
+}
+
+export function createStaticTranslateProvider(language: string, tables: Readonly<Record<string, SearchTranslations>>): TranslateProvider & {
+  setLanguage(language: string, tables: Readonly<Record<string, SearchTranslations>>): void;
+} {
+  let current = { language, tables };
+  const listeners = new Set<() => void>();
+  return {
+    get language() {
+      return current.language;
+    },
+    get(tableName) {
+      return current.tables[tableName] ?? null;
+    },
+    subscribe(listener) {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+    setLanguage(nextLanguage, nextTables) {
+      current = { language: nextLanguage, tables: nextTables };
+      listeners.forEach((l) => l());
+    }
+  };
+}
+
+export interface SearchSort {
+  readonly field: string;
+  readonly direction: "ASC" | "DESC";
+}
+
+export interface SearchExecutionOptions {
+  readonly page?: number;
+  readonly pageSize?: number;
+  readonly sort?: readonly SearchSort[];
+  readonly signal?: AbortSignal;
+  readonly metadata?: SearchTableMetadata;
+}
+
+export interface SearchResult<T> {
+  readonly rows: readonly T[];
+  readonly total?: number;
+  readonly page?: number;
+  readonly pageSize?: number;
+}
+
+export interface SearchDataProvider<T> {
+  execute(query: SearchGroup, options?: SearchExecutionOptions): Promise<SearchResult<T>>;
+}
+
+export interface CachedDataProviderOptions {
+  readonly maxEntries?: number;
+  readonly ttlMs?: number;
+  readonly retries?: number;
+  readonly retryDelayMs?: number;
+}
+
+function abortError(): Error {
+  const e = new Error("Aborted");
+  e.name = "AbortError";
+  return e;
+}
+
+function delay(ms: number, signal?: AbortSignal): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (signal?.aborted) return reject(abortError());
+    const t = setTimeout(resolve, ms);
+    signal?.addEventListener("abort", () => (clearTimeout(t), reject(abortError())), { once: true });
+  });
+}
+
+export function withRetry<T>(provider: SearchDataProvider<T>, retries = 2, retryDelayMs = 250): SearchDataProvider<T> {
+  return {
+    async execute(query, options) {
+      let attempt = 0;
+      for (;;) {
+        try {
+          return await provider.execute(query, options);
+        } catch (e) {
+          if ((e as Error).name === "AbortError" || options?.signal?.aborted || attempt >= retries) throw e;
+          await delay(retryDelayMs * 2 ** attempt++, options?.signal);
+        }
+      }
+    }
+  };
+}
+
+export function withResultCache<T>(provider: SearchDataProvider<T>, options: CachedDataProviderOptions = {}): SearchDataProvider<T> & { clear(): void } {
+  const max = options.maxEntries ?? 20;
+  const ttl = options.ttlMs ?? 30_000;
+  const cache = new Map<string, { at: number; value: SearchResult<T> }>();
+  return {
+    clear: () => cache.clear(),
+    async execute(query, opts) {
+      const key = JSON.stringify([query, opts?.page, opts?.pageSize, opts?.sort]);
+      const hit = cache.get(key);
+      if (hit && Date.now() - hit.at < ttl) return hit.value;
+      const value = await provider.execute(query, opts);
+      cache.delete(key);
+      cache.set(key, { at: Date.now(), value });
+      while (cache.size > max) cache.delete(cache.keys().next().value as string);
+      return value;
+    }
+  };
+}
+
+export interface SearchOption {
+  readonly value: string;
+  readonly label: string;
+}
+
+export interface OptionRequest {
+  readonly search?: string;
+  readonly page?: number;
+  readonly pageSize?: number;
+  readonly signal?: AbortSignal;
+}
+
+export interface OptionPage {
+  readonly options: readonly SearchOption[];
+  readonly hasMore?: boolean;
+}
+
+export type OptionProvider =
+  | readonly SearchOption[]
+  | {
+      readonly key?: string;
+      readonly searchable?: boolean;
+      readonly paginated?: boolean;
+      load(request: OptionRequest): OptionPage | readonly SearchOption[] | Promise<OptionPage | readonly SearchOption[]>;
+      resolve?(values: readonly string[], signal?: AbortSignal): Promise<readonly SearchOption[]> | readonly SearchOption[];
+    };
+
+function toPage(r: OptionPage | readonly SearchOption[]): OptionPage {
+  return Array.isArray(r) ? { options: r as readonly SearchOption[] } : (r as OptionPage);
+}
+
+export class OptionCache {
+  private readonly entries = new Map<string, { at: number; promise: Promise<OptionPage> }>();
+
+  constructor(private readonly ttlMs = 60_000, private readonly maxEntries = 200) {}
+
+  async load(cacheKey: string, provider: OptionProvider, request: OptionRequest): Promise<OptionPage> {
+    if (Array.isArray(provider)) {
+      const list = provider as readonly SearchOption[];
+      const s = request.search?.toLowerCase() ?? "";
+      return { options: s ? list.filter((o) => o.label.toLowerCase().includes(s) || o.value.toLowerCase().includes(s)) : list };
+    }
+    const p = provider as Exclude<OptionProvider, readonly SearchOption[]>;
+    const key = `${p.key ?? cacheKey}|${request.search ?? ""}|${request.page ?? 0}|${request.pageSize ?? ""}`;
+    const hit = this.entries.get(key);
+    if (hit && Date.now() - hit.at < this.ttlMs) return hit.promise;
+    const promise = Promise.resolve(p.load(request)).then(toPage);
+    this.entries.set(key, { at: Date.now(), promise });
+    promise.catch(() => this.entries.delete(key));
+    while (this.entries.size > this.maxEntries) this.entries.delete(this.entries.keys().next().value as string);
+    return promise;
+  }
+
+  async resolve(cacheKey: string, provider: OptionProvider, values: readonly string[], signal?: AbortSignal): Promise<readonly SearchOption[]> {
+    if (values.length === 0) return [];
+    if (!Array.isArray(provider) && (provider as { resolve?: unknown }).resolve) {
+      return (provider as { resolve: (v: readonly string[], s?: AbortSignal) => Promise<readonly SearchOption[]> | readonly SearchOption[] }).resolve(values, signal);
+    }
+    const page = await this.load(cacheKey, provider, { signal });
+    const map = new Map(page.options.map((o) => [o.value, o]));
+    return values.map((v) => map.get(v) ?? { value: v, label: v });
+  }
+
+  clear(): void {
+    this.entries.clear();
+  }
+}
