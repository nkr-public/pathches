@@ -1,96 +0,0 @@
-import { execFileSync, execSync } from "node:child_process";
-import { existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync } from "node:fs";
-import { tmpdir } from "node:os";
-import { join } from "node:path";
-import { fileURLToPath } from "node:url";
-import { gzipSync } from "node:zlib";
-
-const root = fileURLToPath(new URL("..", import.meta.url));
-const state = JSON.parse(readFileSync(join(root, ".cache", "definitions-state.json"), "utf8")) as {
-  tables: Record<string, { fingerprint: string }>;
-};
-const tables = Object.keys(state.tables).sort();
-const failures: string[] = [];
-const check = (condition: unknown, message: string) => {
-  if (!condition) failures.push(message);
-};
-
-for (const f of ["index.js", "index.cjs", "index.d.ts"]) check(existsSync(join(root, "dist", f)), `missing dist/${f}`);
-for (const t of tables) {
-  for (const ext of [".js", ".cjs", ".d.ts"]) check(existsSync(join(root, "dist", "defs", t + ext)), `missing dist/defs/${t}${ext}`);
-  const esm = readFileSync(join(root, "dist", "defs", `${t}.js`), "utf8");
-  const cjs = readFileSync(join(root, "dist", "defs", `${t}.cjs`), "utf8");
-  check(!/\bimport\b|\brequire\(/.test(esm) && !/\brequire\(/.test(cjs), `dist/defs/${t} must not import other modules`);
-  for (const other of tables) if (other !== t) check(!esm.includes(`"${other}"`), `dist/defs/${t} references ${other}`);
-}
-const indexEsm = readFileSync(join(root, "dist", "index.js"), "utf8");
-for (const t of tables) check(!indexEsm.includes(state.tables[t]!.fingerprint), `dist/index.js eagerly embeds ${t}`);
-
-const npm = process.platform === "win32" ? "npm.cmd" : "npm";
-const dry = JSON.parse(execSync(`${npm} pack --dry-run --json --ignore-scripts`, { cwd: root, encoding: "utf8" })) as Array<{ files: Array<{ path: string }> }>;
-const packed = dry[0]!.files.map((f) => f.path.replace(/\\/g, "/"));
-for (const p of packed) {
-  check(!p.startsWith("resources/") && !p.startsWith("src/") && !p.startsWith("scripts/"), `package contains ${p}`);
-  check(!p.endsWith(".json") || p === "package.json", `package contains raw JSON ${p}`);
-}
-
-const work = mkdtempSync(join(tmpdir(), "cr-tools-verify-"));
-try {
-  execSync(`${npm} pack --ignore-scripts --pack-destination "${work}"`, { cwd: root, stdio: "ignore" });
-  const tarball = readdirSync(work).find((f) => f.endsWith(".tgz"))!;
-  const pkgDir = join(work, "node_modules", "@dec", "cr-tools");
-  mkdirSync(pkgDir, { recursive: true });
-  execFileSync("tar", ["-xzf", join(work, tarball), "-C", pkgDir, "--strip-components=1"]);
-  const archived = readdirSync(pkgDir, { recursive: true }).map((p) => String(p).replace(/\\/g, "/"));
-  check(!archived.some((p) => p.startsWith("resources") || (p.endsWith(".json") && p !== "package.json")), "archive contains raw resources");
-  check(!existsSync(join(pkgDir, "resources")), "archive contains resources directory");
-
-  const expectations = JSON.stringify(Object.fromEntries(tables.map((t) => [t, state.tables[t]!.fingerprint])));
-  const esmCode = `
-    const lib = await import("@dec/cr-tools");
-    const expected = ${expectations};
-    for (const [t, fp] of Object.entries(expected)) {
-      const mod = await import("@dec/cr-tools/defs/" + t);
-      const def = mod[t];
-      if (mod[t + "_FINGERPRINT"] !== fp || lib.fingerprintTableDefinition(def) !== fp) throw new Error("ESM fingerprint mismatch " + t);
-      const bytes = lib.encodeTableDefinition(def);
-      if (!lib.tableDefinitionsEqual(lib.decodeTableDefinition(bytes), def)) throw new Error("ESM round-trip " + t);
-      lib.inspect(def).getColumns();
-    }
-    console.log("esm ok");`;
-  const cjsCode = `
-    const lib = require("@dec/cr-tools");
-    const expected = ${expectations};
-    for (const [t, fp] of Object.entries(expected)) {
-      const mod = require("@dec/cr-tools/defs/" + t);
-      if (mod[t + "_FINGERPRINT"] !== fp || lib.fingerprintTableDefinition(mod[t]) !== fp) throw new Error("CJS fingerprint mismatch " + t);
-      lib.inspect(mod[t]).getColumns();
-    }
-    console.log("cjs ok");`;
-  const run = (args: string[]) => execFileSync(process.execPath, args, { cwd: work, encoding: "utf8" }).trim();
-  try {
-    check(run(["--input-type=module", "-e", esmCode]) === "esm ok", "ESM import failed");
-  } catch (e) {
-    failures.push(`ESM import failed: ${(e as Error).message}`);
-  }
-  try {
-    check(run(["--input-type=commonjs", "-e", cjsCode]) === "cjs ok", "CJS require failed");
-  } catch (e) {
-    failures.push(`CJS require failed: ${(e as Error).message}`);
-  }
-
-  const size = (p: string) => statSync(join(root, "dist", p)).size;
-  const gz = (p: string) => gzipSync(readFileSync(join(root, "dist", p)), { level: 9 }).length;
-  console.table(
-    ["index.js", "index.cjs", ...tables.flatMap((t) => [`defs/${t}.js`, `defs/${t}.cjs`])].map((p) => ({ file: p, bytes: size(p), gzip: gz(p) }))
-  );
-  console.log(`package files: ${packed.join(", ")}`);
-} finally {
-  rmSync(work, { recursive: true, force: true });
-}
-
-if (failures.length > 0) {
-  for (const f of failures) console.error(`FAIL ${f}`);
-  process.exit(1);
-}
-console.log(`verified ${tables.length} table definition(s)`);
