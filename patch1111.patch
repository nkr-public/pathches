+import type { SearchTableMetadata } from "./metadata.js";
+import { defaultOperatorRegistry, type OperatorRegistry } from "./operators.js";
+import { isSearchGroup, normalizeQuery, reconcileQuery, type SearchCondition, type SearchGroup } from "./query.js";
+
+export const SAVED_SEARCH_VERSION = 2;
+
+export interface SavedSearchUi {
+  readonly visibleFields?: readonly string[];
+  readonly fieldOrder?: readonly string[];
+  readonly layoutMode?: "ordered" | "optimized";
+  readonly advanced?: boolean;
+  readonly [key: string]: unknown;
+}
+
+export interface SavedSearch {
+  readonly id: string;
+  readonly name: string;
+  readonly tableName: string;
+  readonly version: number;
+  readonly createdAt: string;
+  readonly updatedAt: string;
+  readonly query: SearchGroup;
+  readonly ui?: SavedSearchUi;
+  readonly fingerprint?: string;
+}
+
+export interface SearchPersistenceProvider {
+  save(query: SavedSearch): Promise<void>;
+  load(id: string): Promise<SavedSearch | null>;
+  list(tableName: string): Promise<SavedSearch[]>;
+  delete(id: string): Promise<void>;
+}
+
+export class SearchPersistenceError extends Error {
+  constructor(message: string, cause?: unknown) {
+    super(message, { cause });
+    this.name = "SearchPersistenceError";
+  }
+}
+
+export type SavedSearchMigration = (input: Record<string, unknown>) => Record<string, unknown>;
+
+export const SAVED_SEARCH_MIGRATIONS: Readonly<Record<number, SavedSearchMigration>> = {
+  1: (input) => {
+    const ui = (input.ui ?? {}) as Record<string, unknown>;
+    return {
+      ...input,
+      version: 2,
+      ui: { ...ui, visibleFields: ui.visibleFields ?? input.visibleFields, fieldOrder: ui.fieldOrder ?? input.fieldOrder }
+    };
+  }
+};
+
+export function migrateSavedSearch(input: unknown, migrations: Readonly<Record<number, SavedSearchMigration>> = SAVED_SEARCH_MIGRATIONS): SavedSearch {
+  if (typeof input !== "object" || input === null) throw new SearchPersistenceError("Saved search must be an object");
+  let current = { ...(input as Record<string, unknown>) };
+  let version = typeof current.version === "number" ? current.version : 1;
+  if (version > SAVED_SEARCH_VERSION) throw new SearchPersistenceError(`Saved search version ${version} is newer than supported ${SAVED_SEARCH_VERSION}`);
+  while (version < SAVED_SEARCH_VERSION) {
+    const m = migrations[version];
+    if (!m) throw new SearchPersistenceError(`No migration from saved search version ${version}`);
+    current = m(current);
+    version = typeof current.version === "number" ? current.version : version + 1;
+  }
+  if (typeof current.id !== "string" || typeof current.tableName !== "string" || typeof current.name !== "string") {
+    throw new SearchPersistenceError("Saved search requires id, name and tableName");
+  }
+  const rawQuery = current.query as Record<string, unknown> | undefined;
+  const query = rawQuery && rawQuery.id === undefined ? { ...rawQuery, id: "root" } : rawQuery;
+  if (!isSearchGroup(query)) throw new SearchPersistenceError(`Saved search "${current.id}" has an invalid query`);
+  const now = new Date().toISOString();
+  return {
+    id: current.id,
+    name: current.name,
+    tableName: current.tableName,
+    version: SAVED_SEARCH_VERSION,
+    createdAt: typeof current.createdAt === "string" ? current.createdAt : now,
+    updatedAt: typeof current.updatedAt === "string" ? current.updatedAt : now,
+    query: normalizeQuery(query),
+    ...(current.ui ? { ui: current.ui as SavedSearchUi } : {}),
+    ...(typeof current.fingerprint === "string" ? { fingerprint: current.fingerprint } : {})
+  };
+}
+
+export interface RestoredSearch {
+  readonly saved: SavedSearch;
+  readonly query: SearchGroup;
+  readonly visibleFields: readonly string[] | undefined;
+  readonly fieldOrder: readonly string[] | undefined;
+  readonly incompatible: readonly { readonly condition: SearchCondition; readonly reason: string }[];
+  readonly missingFields: readonly string[];
+}
+
+export function restoreSavedSearch(input: unknown, metadata: SearchTableMetadata, registry: OperatorRegistry = defaultOperatorRegistry): RestoredSearch {
+  const saved = migrateSavedSearch(input);
+  if (saved.tableName !== metadata.name) throw new SearchPersistenceError(`Saved search targets ${saved.tableName}, not ${metadata.name}`);
+  const { query, removed } = reconcileQuery(saved.query, metadata, registry);
+  const known = (list?: readonly string[]) => list?.filter((f) => metadata.byName.has(f));
+  const missing = new Set<string>();
+  [...(saved.ui?.visibleFields ?? []), ...(saved.ui?.fieldOrder ?? [])].forEach((f) => !metadata.byName.has(f) && missing.add(f));
+  removed.forEach((r) => r.reason === "missingColumn" && missing.add(r.condition.field));
+  return {
+    saved,
+    query,
+    visibleFields: known(saved.ui?.visibleFields),
+    fieldOrder: known(saved.ui?.fieldOrder),
+    incompatible: removed,
+    missingFields: [...missing]
+  };
+}
+
+function sortSaved(list: SavedSearch[]): SavedSearch[] {
+  return list.sort((a, b) => a.name.localeCompare(b.name) || a.id.localeCompare(b.id));
+}
+
+function parseSaved(text: string): SavedSearch | null {
+  try {
+    return migrateSavedSearch(JSON.parse(text));
+  } catch {
+    return null;
+  }
+}
+
+export class InMemoryPersistenceProvider implements SearchPersistenceProvider {
+  private readonly store = new Map<string, string>();
+
+  async save(query: SavedSearch): Promise<void> {
+    this.store.set(query.id, JSON.stringify(query));
+  }
+
+  async load(id: string): Promise<SavedSearch | null> {
+    const raw = this.store.get(id);
+    return raw === undefined ? null : parseSaved(raw);
+  }
+
+  async list(tableName: string): Promise<SavedSearch[]> {
+    return sortSaved([...this.store.values()].map(parseSaved).filter((s): s is SavedSearch => s !== null && s.tableName === tableName));
+  }
+
+  async delete(id: string): Promise<void> {
+    this.store.delete(id);
+  }
+}
+
+export interface StorageLike {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+  removeItem(key: string): void;
+  key(index: number): string | null;
+  readonly length: number;
+}
+
+export class LocalStoragePersistenceProvider implements SearchPersistenceProvider {
+  private readonly prefix: string;
+  private readonly storage: StorageLike;
+
+  constructor(options: { prefix?: string; storage?: StorageLike } = {}) {
+    this.prefix = options.prefix ?? "dec-search:";
+    const s = options.storage ?? (globalThis as { localStorage?: StorageLike }).localStorage;
+    if (!s) throw new SearchPersistenceError("localStorage is not available");
+    this.storage = s;
+  }
+
+  async save(query: SavedSearch): Promise<void> {
+    try {
+      this.storage.setItem(this.prefix + query.id, JSON.stringify(query));
+    } catch (e) {
+      throw new SearchPersistenceError(`Unable to save search "${query.id}"`, e);
+    }
+  }
+
+  async load(id: string): Promise<SavedSearch | null> {
+    const raw = this.storage.getItem(this.prefix + id);
+    return raw === null ? null : parseSaved(raw);
+  }
+
+  async list(tableName: string): Promise<SavedSearch[]> {
+    const out: SavedSearch[] = [];
+    for (let i = 0; i < this.storage.length; i++) {
+      const k = this.storage.key(i);
+      if (!k || !k.startsWith(this.prefix)) continue;
+      const s = parseSaved(this.storage.getItem(k) ?? "");
+      if (s && s.tableName === tableName) out.push(s);
+    }
+    return sortSaved(out);
+  }
+
+  async delete(id: string): Promise<void> {
+    this.storage.removeItem(this.prefix + id);
+  }
+}
+
+interface OpfsFileHandle {
+  getFile(): Promise<{ text(): Promise<string> }>;
+  createWritable(): Promise<{ write(data: string): Promise<void>; close(): Promise<void> }>;
+}
+
+interface OpfsDirectoryHandle {
+  getDirectoryHandle(name: string, options?: { create?: boolean }): Promise<OpfsDirectoryHandle>;
+  getFileHandle(name: string, options?: { create?: boolean }): Promise<OpfsFileHandle>;
+  removeEntry(name: string): Promise<void>;
+  entries(): AsyncIterableIterator<[string, { kind: string }]>;
+}
+
+export type OpfsRootProvider = () => Promise<OpfsDirectoryHandle>;
+
+export function isOpfsAvailable(): boolean {
+  const nav = (globalThis as { navigator?: { storage?: { getDirectory?: unknown } } }).navigator;
+  return typeof nav?.storage?.getDirectory === "function";
+}
+
+export class OpfsPersistenceProvider implements SearchPersistenceProvider {
+  private dir: Promise<OpfsDirectoryHandle> | null = null;
+  private readonly directory: string;
+  private readonly root: OpfsRootProvider | null;
+
+  constructor(options: { directory?: string; root?: OpfsRootProvider } = {}) {
+    this.directory = options.directory ?? "dec-search";
+    this.root =
+      options.root ??
+      (isOpfsAvailable()
+        ? () => (globalThis as unknown as { navigator: { storage: { getDirectory(): Promise<OpfsDirectoryHandle> } } }).navigator.storage.getDirectory()
+        : null);
+  }
+
+  get available(): boolean {
+    return this.root !== null;
+  }
+
+  private handle(): Promise<OpfsDirectoryHandle> {
+    if (!this.root) return Promise.reject(new SearchPersistenceError("Origin Private File System is not available"));
+    if (!this.dir) {
+      this.dir = this.root().then((r) => r.getDirectoryHandle(this.directory, { create: true }));
+      this.dir.catch(() => (this.dir = null));
+    }
+    return this.dir;
+  }
+
+  private fileName(id: string): string {
+    return `${encodeURIComponent(id)}.json`;
+  }
+
+  async save(query: SavedSearch): Promise<void> {
+    try {
+      const dir = await this.handle();
+      const file = await dir.getFileHandle(this.fileName(query.id), { create: true });
+      const w = await file.createWritable();
+      await w.write(JSON.stringify(query));
+      await w.close();
+    } catch (e) {
+      throw e instanceof SearchPersistenceError ? e : new SearchPersistenceError(`Unable to save search "${query.id}" to OPFS`, e);
+    }
+  }
+
+  async load(id: string): Promise<SavedSearch | null> {
+    const dir = await this.handle();
+    try {
+      const file = await dir.getFileHandle(this.fileName(id));
+      return parseSaved(await (await file.getFile()).text());
+    } catch (e) {
+      if ((e as { name?: string }).name === "NotFoundError") return null;
+      throw new SearchPersistenceError(`Unable to load search "${id}" from OPFS`, e);
+    }
+  }
+
+  async list(tableName: string): Promise<SavedSearch[]> {
+    const dir = await this.handle();
+    const out: SavedSearch[] = [];
+    for await (const [name, entry] of dir.entries()) {
+      if (entry.kind !== "file" || !name.endsWith(".json")) continue;
+      const file = await dir.getFileHandle(name);
+      const s = parseSaved(await (await file.getFile()).text());
+      if (s && s.tableName === tableName) out.push(s);
+    }
+    return sortSaved(out);
+  }
+
+  async delete(id: string): Promise<void> {
+    const dir = await this.handle();
+    try {
+      await dir.removeEntry(this.fileName(id));
+    } catch (e) {
+      if ((e as { name?: string }).name !== "NotFoundError") throw new SearchPersistenceError(`Unable to delete search "${id}" from OPFS`, e);
+    }
+  }
+}
+
+export interface ApiPersistenceOptions {
+  readonly baseUrl: string;
+  readonly fetch?: typeof fetch;
+  readonly headers?: () => Record<string, string> | Promise<Record<string, string>>;
+}
+
+export class ApiPersistenceProvider implements SearchPersistenceProvider {
+  private readonly base: string;
+  private readonly fetcher: typeof fetch;
+
+  constructor(private readonly options: ApiPersistenceOptions) {
+    this.base = options.baseUrl.replace(/\/+$/, "");
+    const f = options.fetch ?? (globalThis as { fetch?: typeof fetch }).fetch;
+    if (!f) throw new SearchPersistenceError("fetch is not available");
+    this.fetcher = f;
+  }
+
+  private async request(path: string, init: RequestInit = {}): Promise<Response> {
+    const headers = { Accept: "application/json", ...(init.body ? { "Content-Type": "application/json" } : {}), ...((await this.options.headers?.()) ?? {}) };
+    let res: Response;
+    try {
+      res = await this.fetcher.call(globalThis, `${this.base}${path}`, { ...init, headers });
+    } catch (e) {
+      throw new SearchPersistenceError(`Network error on ${path}`, e);
+    }
+    return res;
+  }
+
+  private async fail(res: Response, action: string): Promise<never> {
+    throw new SearchPersistenceError(`${action} failed with HTTP ${res.status}`);
+  }
+
+  async save(query: SavedSearch): Promise<void> {
+    const res = await this.request(`/${encodeURIComponent(query.id)}`, { method: "PUT", body: JSON.stringify(query) });
+    if (!res.ok) await this.fail(res, "Save");
+  }
+
+  async load(id: string): Promise<SavedSearch | null> {
+    const res = await this.request(`/${encodeURIComponent(id)}`);
+    if (res.status === 404) return null;
+    if (!res.ok) await this.fail(res, "Load");
+    return migrateSavedSearch(await res.json());
+  }
+
+  async list(tableName: string): Promise<SavedSearch[]> {
+    const res = await this.request(`?tableName=${encodeURIComponent(tableName)}`);
+    if (!res.ok) await this.fail(res, "List");
+    const body = (await res.json()) as unknown[];
+    if (!Array.isArray(body)) throw new SearchPersistenceError("List response must be an array");
+    return sortSaved(
+      body
+        .map((b) => {
+          try {
+            return migrateSavedSearch(b);
+          } catch {
+            return null;
+          }
+        })
+        .filter((s): s is SavedSearch => s !== null && s.tableName === tableName)
+    );
+  }
+
+  async delete(id: string): Promise<void> {
+    const res = await this.request(`/${encodeURIComponent(id)}`, { method: "DELETE" });
+    if (!res.ok && res.status !== 404) await this.fail(res, "Delete");
+  }
+}
+
+export function createDefaultPersistenceProvider(): SearchPersistenceProvider {
+  try {
+    return new LocalStoragePersistenceProvider();
+  } catch {
+    return new InMemoryPersistenceProvider();
+  }
+}
