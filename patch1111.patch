+import type { SearchTableMetadata } from "./metadata.js";
+import { defaultOperatorRegistry, type OperatorIssue, type OperatorRegistry, type SearchOperator } from "./operators.js";
+
+export interface SearchCondition {
+  readonly id: string;
+  readonly field: string;
+  readonly operator: SearchOperator;
+  readonly values: readonly string[];
+  readonly enabled: boolean;
+}
+
+export type SearchCombinator = "AND" | "OR";
+
+export interface SearchGroup {
+  readonly id: string;
+  readonly combinator: SearchCombinator;
+  readonly children: readonly SearchExpression[];
+  readonly enabled?: boolean;
+}
+
+export type SearchExpression = SearchCondition | SearchGroup;
+
+export function isGroup(e: SearchExpression): e is SearchGroup {
+  return Array.isArray((e as SearchGroup).children);
+}
+
+let sequence = 0;
+
+export function createId(prefix = "c"): string {
+  const c = (globalThis as { crypto?: { randomUUID?: () => string } }).crypto;
+  return c?.randomUUID ? `${prefix}-${c.randomUUID()}` : `${prefix}-${Date.now().toString(36)}-${(sequence++).toString(36)}`;
+}
+
+export function createGroup(combinator: SearchCombinator = "AND", children: readonly SearchExpression[] = [], id = createId("g")): SearchGroup {
+  return { id, combinator, children };
+}
+
+export function createCondition(
+  metadata: SearchTableMetadata,
+  field: string,
+  registry: OperatorRegistry = defaultOperatorRegistry,
+  partial: Partial<Omit<SearchCondition, "field">> = {}
+): SearchCondition {
+  const column = metadata.byName.get(field);
+  if (!column) throw new Error(`Unknown field "${field}" in ${metadata.name}`);
+  const operator = partial.operator ?? registry.defaultFor(column, { showNullOperatorsForNotNull: true })?.id ?? "EQ";
+  const values = partial.values ?? registry.adaptValues(operator, operator, []);
+  return { id: partial.id ?? createId("c"), field, operator, values, enabled: partial.enabled ?? true };
+}
+
+function mapTree(group: SearchGroup, fn: (e: SearchExpression) => SearchExpression | null): SearchGroup {
+  let changed = false;
+  const children: SearchExpression[] = [];
+  for (const child of group.children) {
+    let next = fn(child);
+    if (next && isGroup(next)) {
+      const inner = mapTree(next, fn);
+      if (inner !== next) next = inner;
+    }
+    if (next !== child) changed = true;
+    if (next) children.push(next);
+  }
+  return changed ? { ...group, children } : group;
+}
+
+export function findExpression(group: SearchGroup, id: string): SearchExpression | undefined {
+  if (group.id === id) return group;
+  for (const c of group.children) {
+    if (c.id === id) return c;
+    if (isGroup(c)) {
+      const f = findExpression(c, id);
+      if (f) return f;
+    }
+  }
+  return undefined;
+}
+
+export function addExpression(root: SearchGroup, expression: SearchExpression, parentId: string = root.id, index?: number): SearchGroup {
+  const insert = (g: SearchGroup): SearchGroup => {
+    const children = [...g.children];
+    children.splice(index ?? children.length, 0, expression);
+    return { ...g, children };
+  };
+  if (root.id === parentId) return insert(root);
+  return mapTree(root, (e) => (isGroup(e) && e.id === parentId ? insert(e) : e));
+}
+
+export function updateCondition(root: SearchGroup, id: string, patch: Partial<Omit<SearchCondition, "id">>): SearchGroup {
+  return mapTree(root, (e) => (!isGroup(e) && e.id === id ? { ...e, ...patch } : e));
+}
+
+export function updateGroup(root: SearchGroup, id: string, patch: Partial<Pick<SearchGroup, "combinator" | "enabled">>): SearchGroup {
+  if (root.id === id) return { ...root, ...patch };
+  return mapTree(root, (e) => (isGroup(e) && e.id === id ? { ...e, ...patch } : e));
+}
+
+export function removeExpression(root: SearchGroup, id: string): SearchGroup {
+  return mapTree(root, (e) => (e.id === id ? null : e));
+}
+
+function cloneWithNewIds(e: SearchExpression): SearchExpression {
+  return isGroup(e) ? { ...e, id: createId("g"), children: e.children.map(cloneWithNewIds) } : { ...e, id: createId("c") };
+}
+
+export function duplicateExpression(root: SearchGroup, id: string): SearchGroup {
+  const dup = (g: SearchGroup): SearchGroup | null => {
+    const i = g.children.findIndex((c) => c.id === id);
+    if (i >= 0) {
+      const children = [...g.children];
+      children.splice(i + 1, 0, cloneWithNewIds(g.children[i]));
+      return { ...g, children };
+    }
+    for (let k = 0; k < g.children.length; k++) {
+      const c = g.children[k];
+      if (isGroup(c)) {
+        const r = dup(c);
+        if (r) {
+          const children = [...g.children];
+          children[k] = r;
+          return { ...g, children };
+        }
+      }
+    }
+    return null;
+  };
+  return dup(root) ?? root;
+}
+
+export function changeOperator(root: SearchGroup, id: string, operator: SearchOperator, registry: OperatorRegistry = defaultOperatorRegistry): SearchGroup {
+  return mapTree(root, (e) => (!isGroup(e) && e.id === id ? { ...e, operator, values: registry.adaptValues(e.operator, operator, e.values) } : e));
+}
+
+export function isConditionEmpty(c: SearchCondition, registry: OperatorRegistry = defaultOperatorRegistry): boolean {
+  const d = registry.get(c.operator);
+  if (d && d.valueCount === 0) return false;
+  return c.values.length === 0 || c.values.every((v) => v === "");
+}
+
+export function pruneQuery(group: SearchGroup, registry: OperatorRegistry = defaultOperatorRegistry): SearchGroup {
+  const children: SearchExpression[] = [];
+  for (const c of group.children) {
+    if (isGroup(c)) {
+      if (c.enabled === false) continue;
+      const p = pruneQuery(c, registry);
+      if (p.children.length > 0) children.push(p);
+    } else if (c.enabled && !isConditionEmpty(c, registry)) {
+      children.push(c);
+    }
+  }
+  return { id: group.id, combinator: group.combinator, children };
+}
+
+export function flattenConditions(group: SearchGroup): SearchCondition[] {
+  const out: SearchCondition[] = [];
+  const walk = (g: SearchGroup) => g.children.forEach((c) => (isGroup(c) ? walk(c) : out.push(c)));
+  walk(group);
+  return out;
+}
+
+export interface QueryIssue extends OperatorIssue {
+  readonly conditionId: string;
+  readonly field: string;
+}
+
+export interface QueryValidationOptions {
+  readonly maxDepth?: number;
+  readonly maxConditions?: number;
+  readonly showNullOperatorsForNotNull?: boolean;
+}
+
+export function validateQuery(
+  query: SearchGroup,
+  metadata: SearchTableMetadata,
+  registry: OperatorRegistry = defaultOperatorRegistry,
+  options: QueryValidationOptions = {}
+): QueryIssue[] {
+  const issues: QueryIssue[] = [];
+  const maxDepth = options.maxDepth ?? 8;
+  const pruned = pruneQuery(query, registry);
+  const depth = (g: SearchGroup): number => 1 + Math.max(0, ...g.children.filter(isGroup).map(depth));
+  if (depth(pruned) > maxDepth) issues.push({ conditionId: query.id, field: "", code: "tooDeep", message: `Query depth exceeds ${maxDepth}` });
+  const conditions = flattenConditions(pruned);
+  if (options.maxConditions !== undefined && conditions.length > options.maxConditions) {
+    issues.push({ conditionId: query.id, field: "", code: "tooManyConditions", message: `More than ${options.maxConditions} conditions` });
+  }
+  for (const c of conditions) {
+    const column = metadata.byName.get(c.field);
+    if (!column) {
+      issues.push({ conditionId: c.id, field: c.field, code: "unknownField", message: `Unknown field ${c.field}` });
+      continue;
+    }
+    for (const i of registry.validate(c.operator, c.values, column)) issues.push({ ...i, conditionId: c.id, field: c.field });
+  }
+  return issues;
+}
+
+export interface CompatibilityReport {
+  readonly query: SearchGroup;
+  readonly removed: readonly { readonly condition: SearchCondition; readonly reason: string }[];
+}
+
+export function reconcileQuery(
+  query: SearchGroup,
+  metadata: SearchTableMetadata,
+  registry: OperatorRegistry = defaultOperatorRegistry
+): CompatibilityReport {
+  const removed: { condition: SearchCondition; reason: string }[] = [];
+  const next = mapTree(query, (e) => {
+    if (isGroup(e)) return e;
+    const column = metadata.byName.get(e.field);
+    if (!column) {
+      removed.push({ condition: e, reason: "missingColumn" });
+      return null;
+    }
+    const d = registry.get(e.operator);
+    if (!d || !d.supportedTypes.includes(column.dataType)) {
+      removed.push({ condition: e, reason: "incompatibleOperator" });
+      return null;
+    }
+    return e;
+  });
+  return { query: next, removed };
+}
+
+export function isSearchGroup(value: unknown): value is SearchGroup {
+  if (typeof value !== "object" || value === null) return false;
+  const g = value as Record<string, unknown>;
+  if ((g.combinator !== "AND" && g.combinator !== "OR") || !Array.isArray(g.children)) return false;
+  return g.children.every((c) => {
+    if (typeof c !== "object" || c === null) return false;
+    if (Array.isArray((c as SearchGroup).children)) return isSearchGroup(c);
+    const k = c as Record<string, unknown>;
+    return typeof k.field === "string" && typeof k.operator === "string" && Array.isArray(k.values);
+  });
+}
+
+export function normalizeQuery(value: SearchGroup): SearchGroup {
+  return {
+    id: value.id ?? createId("g"),
+    combinator: value.combinator,
+    ...(value.enabled === false ? { enabled: false } : {}),
+    children: value.children.map((c) =>
+      isGroup(c)
+        ? normalizeQuery(c)
+        : { id: c.id ?? createId("c"), field: c.field, operator: c.operator, values: c.values.map((v) => (v === null || v === undefined ? "" : String(v))), enabled: c.enabled !== false }
+    )
+  };
+}
