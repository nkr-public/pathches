+
+export type FieldType = "string" | "number" | "boolean" | "date";
+
+export type OracleColumnType =
+    | "VARCHAR2" | "NVARCHAR2" | "CHAR" | "NCHAR"
+    | "NUMBER" | "FLOAT" | "BINARY_FLOAT" | "BINARY_DOUBLE"
+    | "DATE" | "TIMESTAMP" | "TIMESTAMP_WITH_TZ" | "TIMESTAMP_WITH_LTZ"
+    | "CLOB" | "BLOB" | "BFILE" | "RAW" | "LONG"
+    | "ROWID" | "UROWID"
+    | "INTERVAL_YEAR_TO_MONTH" | "INTERVAL_DAY_TO_SECOND"
+    | "XMLTYPE" | "JSON";
+
+export type JdbcType =
+    | "VARCHAR" | "CHAR" | "LONGVARCHAR"
+    | "NUMERIC" | "DECIMAL" | "BIT" | "TINYINT" | "SMALLINT" | "INTEGER" | "BIGINT" | "NUMBER"
+    | "FLOAT" | "REAL" | "DOUBLE"
+    | "DATE" | "TIME" | "TIMESTAMP"
+    | "BLOB" | "CLOB" | "NCHAR" | "NCLOB" | "NVARCHAR"
+    | "BOOLEAN" | "OTHER" | "ARRAY" | "STRUCT" | "REF";
+
+export interface FieldRule {
+  field: string;
+  type: FieldType;
+  nullable: boolean;
+  max?: number;
+  indexed?: boolean;
+  isIndexed?: boolean;
+  isExternalKey?: boolean;
+  description?: string;
+  columnName?: string;
+  columnType?: OracleColumnType;
+  jdbcType?: JdbcType;
+  size?: number;
+  decimalPrecision?: number;
+  isPrimaryKey?: boolean;
+  isForeignKey?: boolean;
+  foreignKeyTargetTable?: string;
+  foreignKeyTargetColumn?: string;
+  isUnique?: boolean;
+  hasDefaultValue?: boolean;
+  defaultValue?: string;
+  isGenerated?: boolean;
+  position?: number;
+}
+
+export interface TableMetaData {
+  tableName: string;
+  nbRows: number;
+  dtoName: string;
+  primaryKey: string[];
+  fields: FieldRule[];
+  indexes?: IndexDefinition[];
+  foreignKeys?: ForeignKeyDefinition[];
+}
+
+export interface IndexDefinition {
+  name: string;
+  columns: string[];
+  unique: boolean;
+  indexType?: string;
+}
+
+export interface ForeignKeyDefinition {
+  name: string;
+  columns: string[];
+  referencedTable: string;
+  referencedColumns: string[];
+  onDeleteAction?: string;
+}
+
+export interface ValidationError {
+  field: string;
+  message: string;
+}
+
+export abstract class DtoValidator<T> {
+  protected abstract readonly rules: readonly FieldRule[];
+
+  abstract validate(dto: T, exclude?: string[]): ValidationError[];
+
+  validateAll(dto: T, exclude?: string[]): ValidationError[] {
+    return [
+      ...this.validateTechnical(dto, exclude),
+      ...this.validate(dto, exclude)
+    ];
+  }
+
+  protected validateTechnical(
+      dto: T,
+      exclude?: string[]
+  ): ValidationError[] {
+    const errors: ValidationError[] = [];
+    const excludeSet = exclude ? new Set(exclude) : null;
+    const record = dto as Record<string, unknown>;
+
+    for (const rule of this.rules) {
+      if (excludeSet && excludeSet.has(rule.field)) {
+        continue;
+      }
+
+      const value = record[rule.field];
+
+      if (value === null || value === undefined) {
+        if (!rule.nullable) {
+          errors.push({
+            field: rule.field,
+            message: `${rule.field} is required`
+          });
+        }
+        continue;
+      }
+
+      if (!this.checkType(value, rule.type)) {
+        errors.push({
+          field: rule.field,
+          message: `${rule.field} must be of type ${rule.type}`
+        });
+        continue;
+      }
+
+      if (
+          rule.type === "string" &&
+          rule.max !== undefined &&
+          (value as string).length > rule.max
+      ) {
+        errors.push({
+          field: rule.field,
+          message: `${rule.field} must not exceed ${rule.max} characters`
+        });
+      }
+    }
+
+    return errors;
+  }
+
+  private checkType(value: unknown, type: FieldType): boolean {
+    switch (type) {
+      case "string":
+        return typeof value === "string";
+
+      case "number":
+        return typeof value === "number" && Number.isFinite(value);
+
+      case "boolean":
+        return typeof value === "boolean";
+
+      case "date":
+        return value instanceof Date ||
+            (typeof value === "string" && !Number.isNaN(Date.parse(value)));
+
+      default:
+        return false;
+    }
+  }
+}
