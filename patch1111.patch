+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import type { SearchColumnMetadata } from "../core/metadata.js";
+import type { OperatorDefinition } from "../core/operators.js";
+import { createLayoutEngine, layoutsEqual, type FieldLayoutMetrics, type LayoutOptions, type SearchLayout } from "../core/layout.js";
+
+export interface MeasureContext {
+  readonly font: string;
+  readonly fieldPadding: number;
+  readonly controlGap: number;
+  readonly selectChrome: number;
+  readonly inputChrome: number;
+  readonly clearButton: number;
+}
+
+export const DEFAULT_MEASURE_CONTEXT: MeasureContext = {
+  font: "14px system-ui, sans-serif",
+  fieldPadding: 16,
+  controlGap: 4,
+  selectChrome: 36,
+  inputChrome: 18,
+  clearButton: 26
+};
+
+type TextMeasurer = (text: string, font: string) => number;
+
+let measurer: TextMeasurer | null = null;
+const textCache = new Map<string, number>();
+
+function fontSize(font: string): number {
+  const m = /(\d+(?:\.\d+)?)px/.exec(font);
+  return m ? Number(m[1]) : 14;
+}
+
+function getMeasurer(): TextMeasurer {
+  if (measurer) return measurer;
+  const Off = (globalThis as { OffscreenCanvas?: new (w: number, h: number) => { getContext(t: "2d"): CanvasRenderingContext2D | null } }).OffscreenCanvas;
+  const ctx = Off ? new Off(1, 1).getContext("2d") : null;
+  measurer = ctx
+    ? (text, font) => {
+        ctx.font = font;
+        return ctx.measureText(text).width;
+      }
+    : (text, font) => text.length * fontSize(font) * 0.56;
+  return measurer;
+}
+
+export function measureText(text: string, font: string): number {
+  const key = `${font}|${text}`;
+  let w = textCache.get(key);
+  if (w === undefined) {
+    w = Math.ceil(getMeasurer()(text, font));
+    if (textCache.size > 5000) textCache.clear();
+    textCache.set(key, w);
+  }
+  return w;
+}
+
+export function scalarWidth(column: SearchColumnMetadata, ctx: MeasureContext): number {
+  const ch = fontSize(ctx.font) * 0.6;
+  switch (column.dataType) {
+    case "NUMBER":
