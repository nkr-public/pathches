+import { resolveJdbcType } from "./jdbc.js";
+
+export interface OracleTableMetadata {
+  readonly name: string;
+  readonly numRows?: number;
+  readonly labels: readonly string[];
+  readonly dNames: readonly string[];
+  readonly dTypes: readonly number[];
+  readonly precisions: readonly number[];
+  readonly scales: readonly number[];
+  readonly defaults: readonly boolean[];
+  readonly keys?: readonly number[];
+  readonly indexes?: readonly { readonly unique: boolean; readonly columns: readonly number[] }[];
+}
+
+export type SearchDataType = "STRING" | "NUMBER" | "DATE" | "TIME" | "TIMESTAMP" | "BOOLEAN" | "UNSUPPORTED";
+
+export interface SearchColumnMetadata {
+  readonly index: number;
+  readonly name: string;
+  readonly displayName: string;
+  readonly jdbcType: number;
+  readonly jdbcTypeName: string;
+  readonly dataType: SearchDataType;
+  readonly precision: number;
+  readonly scale: number;
+  readonly nullable: boolean;
+  readonly primaryKey: boolean;
+  readonly indexed: boolean;
+  readonly unique: boolean;
+  readonly integer: boolean;
+  readonly unconstrainedNumber: boolean;
+  readonly maxLength: number | null;
+}
+
+export interface SearchTableMetadata {
+  readonly name: string;
+  readonly numRows: number;
+  readonly columns: readonly SearchColumnMetadata[];
+  readonly byName: ReadonlyMap<string, SearchColumnMetadata>;
+}
+
+export class SearchMetadataError extends Error {
+  readonly issues: readonly string[];
+  constructor(table: string, issues: readonly string[]) {
+    super(`Invalid search metadata "${table}": ${issues.join("; ")}`);
+    this.name = "SearchMetadataError";
+    this.issues = Object.freeze([...issues]);
+  }
+}
+
+export const ORACLE_UNSPECIFIED_SCALE = -127;
+
+export function dataTypeOf(jdbcType: number): SearchDataType {
+  switch (resolveJdbcType(jdbcType).category) {
+    case "numeric":
+      return "NUMBER";
+    case "text":
+      return "STRING";
+    case "date":
+      return "DATE";
+    case "time":
+      return "TIME";
+    case "timestamp":
+      return "TIMESTAMP";
+    case "boolean":
+      return "BOOLEAN";
+    case "other":
+      return resolveJdbcType(jdbcType).known ? "UNSUPPORTED" : "STRING";
+    default:
+      return "UNSUPPORTED";
+  }
+}
+
+const INTEGER_TYPES = new Set([-6, 5, 4, -5]);
+
+function isInt(v: unknown): v is number {
+  return typeof v === "number" && Number.isSafeInteger(v);
+}
+
+export function normalizeOracleMetadata(input: unknown): SearchTableMetadata {
+  if (typeof input !== "object" || input === null || Array.isArray(input)) {
+    throw new SearchMetadataError("?", ["metadata must be an object"]);
+  }
+  const m = input as Record<string, unknown>;
+  const table = typeof m.name === "string" && m.name.length > 0 ? m.name : "?";
+  const issues: string[] = [];
+  if (table === "?") issues.push("name must be a non-empty string");
+  const spec: Array<[string, (v: unknown) => boolean, string]> = [
+    ["labels", (v) => typeof v === "string" && v.length > 0, "a non-empty string"],
+    ["dNames", (v) => typeof v === "string", "a string"],
+    ["dTypes", isInt, "an integer"],
+    ["precisions", (v) => isInt(v) && v >= 0, "a nonnegative integer"],
+    ["scales", isInt, "an integer"],
+    ["defaults", (v) => typeof v === "boolean", "a boolean"]
+  ];
+  let length = -1;
+  for (const [field, predicate, kind] of spec) {
+    const arr = m[field];
+    if (!Array.isArray(arr)) {
+      issues.push(`${field} must be an array`);
+      continue;
+    }
+    if (length < 0) length = arr.length;
+    else if (arr.length !== length) issues.push(`${field} has length ${arr.length}, expected ${length}`);
+    arr.forEach((v, i) => {
+      if (!predicate(v)) issues.push(`${field}[${i}] must be ${kind}`);
+    });
+  }
+  if (length === 0) issues.push("metadata must declare at least one column");
+  const labels = (m.labels as string[]) ?? [];
+  const seen = new Set<string>();
+  labels.forEach((l, i) => {
+    if (seen.has(l)) issues.push(`labels[${i}] duplicates "${l}"`);
+    seen.add(l);
+  });
+  const keys = m.keys === undefined ? [] : m.keys;
+  if (!Array.isArray(keys)) issues.push("keys must be an array");
+  else keys.forEach((k, i) => {
+    if (!isInt(k) || k < 0 || k >= length) issues.push(`keys[${i}] is not a valid column index`);
+  });
+  const indexes = m.indexes === undefined ? [] : m.indexes;
+  if (!Array.isArray(indexes)) issues.push("indexes must be an array");
+  else indexes.forEach((ix, i) => {
+    const o = ix as Record<string, unknown>;
+    if (typeof o !== "object" || o === null || typeof o.unique !== "boolean" || !Array.isArray(o.columns) || o.columns.length === 0) {
+      issues.push(`indexes[${i}] must have boolean unique and non-empty columns`);
+      return;
+    }
+    (o.columns as unknown[]).forEach((c, j) => {
+      if (!isInt(c) || c < 0 || c >= length) issues.push(`indexes[${i}].columns[${j}] is not a valid column index`);
+    });
+  });
+  if (m.numRows !== undefined && (!isInt(m.numRows) || m.numRows < 0)) issues.push("numRows must be a nonnegative integer");
+  if (issues.length > 0) throw new SearchMetadataError(table, issues);
+
+  const meta = input as OracleTableMetadata;
+  const keySet = new Set(meta.keys ?? []);
+  const indexed = new Set<number>();
+  const unique = new Set<number>();
+  for (const ix of meta.indexes ?? []) {
+    ix.columns.forEach((c) => indexed.add(c));
+    if (ix.unique && ix.columns.length === 1) unique.add(ix.columns[0]);
+  }
+  if (keySet.size === 1) unique.add([...keySet][0]);
+  const columns = meta.labels.map((name, index) => {
+    const jdbcType = meta.dTypes[index];
+    const dataType = dataTypeOf(jdbcType);
+    const precision = meta.precisions[index];
+    const scale = meta.scales[index];
+    const unconstrainedNumber = dataType === "NUMBER" && precision === 0 && scale === ORACLE_UNSPECIFIED_SCALE;
+    const integer = dataType === "NUMBER" && (INTEGER_TYPES.has(jdbcType) || (!unconstrainedNumber && precision > 0 && scale === 0));
+    return Object.freeze<SearchColumnMetadata>({
+      index,
+      name,
+      displayName: meta.dNames[index] || name,
+      jdbcType,
+      jdbcTypeName: resolveJdbcType(jdbcType).name,
+      dataType,
+      precision,
+      scale,
+      nullable: meta.defaults[index] === true,
+      primaryKey: keySet.has(index),
+      indexed: indexed.has(index) || keySet.has(index),
+      unique: unique.has(index),
+      integer,
+      unconstrainedNumber,
+      maxLength: dataType === "STRING" && precision > 0 ? precision : null
+    });
+  });
+  const frozenColumns = Object.freeze(columns);
+  const byName = new Map(frozenColumns.map((c) => [c.name, c]));
+  return Object.freeze({ name: meta.name, numRows: meta.numRows ?? 0, columns: frozenColumns, byName });
+}
