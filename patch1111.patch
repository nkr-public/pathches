@@ -0,0 +1,71 @@
+import * as tables from "../src/tables/index.ts";
+
+const IGNORED = new Set(["UserDef"]);
+
+interface Field {
+  field: string;
+  columnName?: string;
+  position?: number;
+  isPrimaryKey?: boolean;
+  size?: number;
+  max?: number;
+}
+interface Table {
+  tableName: string;
+  nbRows: number;
+  dtoName: string;
+  primaryKey: string[];
+  fields: Field[];
+  indexes?: { name: string; columns: string[] }[];
+  foreignKeys?: { name: string; columns: string[] }[];
+}
+
+const camel = (s: string) => s.toLowerCase().replace(/_([a-z0-9])/g, (_, c: string) => c.toUpperCase());
+const isTable = (v: unknown): v is Table =>
+  typeof v === "object" && v !== null && "tableName" in v && Array.isArray((v as Table).fields);
+
+const errors: string[] = [];
+const seenTables = new Set<string>();
+let count = 0;
+
+for (const [key, value] of Object.entries(tables)) {
+  if (!isTable(value) || IGNORED.has(key)) continue;
+  count++;
+  const err = (m: string) => errors.push(`${key}: ${m}`);
+  if (seenTables.has(value.tableName)) err(`duplicate tableName ${value.tableName}`);
+  seenTables.add(value.tableName);
+  if (!value.dtoName) err("dtoName is empty");
+  if (!Number.isInteger(value.nbRows) || value.nbRows < 0) err("nbRows must be a nonnegative integer");
+  if (value.fields.length === 0) err("no fields");
+
+  const fieldNames = new Set<string>();
+  const columns = new Set<string>();
+  value.fields.forEach((f, i) => {
+    if (fieldNames.has(f.field)) err(`duplicate field ${f.field}`);
+    fieldNames.add(f.field);
+    if (!f.columnName) {
+      err(`${f.field}: columnName is missing`);
+      return;
+    }
+    if (columns.has(f.columnName)) err(`duplicate column ${f.columnName}`);
+    columns.add(f.columnName);
+    if (camel(f.columnName) !== f.field) err(`${f.field}: does not match columnName ${f.columnName}`);
+    if (f.position !== undefined && f.position !== i + 1) err(`${f.field}: position ${f.position}, expected ${i + 1}`);
+    if (f.size !== undefined && f.max !== undefined && f.size !== f.max) err(`${f.field}: size ${f.size} differs from max ${f.max}`);
+    if (f.isPrimaryKey && !value.primaryKey.includes(f.columnName)) err(`${f.field}: isPrimaryKey but absent from primaryKey`);
+  });
+
+  for (const c of value.primaryKey) {
+    if (!columns.has(c)) err(`primaryKey references unknown column ${c}`);
+    else if (!value.fields.find((f) => f.columnName === c)?.isPrimaryKey) err(`primaryKey column ${c} is not flagged isPrimaryKey`);
+  }
+  for (const ix of value.indexes ?? []) for (const c of ix.columns) if (!columns.has(c)) err(`index ${ix.name} references unknown column ${c}`);
+  for (const fk of value.foreignKeys ?? []) for (const c of fk.columns) if (!columns.has(c)) err(`foreign key ${fk.name} references unknown column ${c}`);
+}
+
+if (count === 0) errors.push("no table definition found");
+if (errors.length > 0) {
+  console.error(errors.join("\n"));
+  process.exit(1);
+}
+console.log(`verify-definitions: ${count} table(s) OK`);
