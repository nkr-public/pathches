+import type { SearchColumnMetadata, SearchTableMetadata } from "./metadata.js";
+import { defaultOperatorRegistry, type OperatorRegistry } from "./operators.js";
+import { isGroup, pruneQuery, validateQuery, type SearchCondition, type SearchGroup } from "./query.js";
+
+export interface SearchQueryCompiler<TOutput> {
+  compile(query: SearchGroup, metadata: SearchTableMetadata): TOutput;
+}
+
+export class SearchCompilationError extends Error {
+  readonly issues: readonly { readonly field: string; readonly code: string; readonly message: string }[];
+  constructor(issues: SearchCompilationError["issues"]) {
+    super(`Invalid search query: ${issues.map((i) => `${i.field || "query"}: ${i.code}`).join(", ")}`);
+    this.name = "SearchCompilationError";
+    this.issues = issues;
+  }
+}
+
+export interface JsonCondition {
+  readonly field: string;
+  readonly type: string;
+  readonly operator: string;
+  readonly values: readonly string[];
+}
+
+export interface JsonGroup {
+  readonly combinator: "AND" | "OR";
+  readonly children: readonly (JsonCondition | JsonGroup)[];
+}
+
+export interface JsonQuery {
+  readonly table: string;
+  readonly version: 1;
+  readonly where: JsonGroup;
+}
+
+function prepare(query: SearchGroup, metadata: SearchTableMetadata, registry: OperatorRegistry): SearchGroup {
+  const issues = validateQuery(query, metadata, registry);
+  if (issues.length > 0) throw new SearchCompilationError(issues);
+  return pruneQuery(query, registry);
+}
+
+function serializeValues(c: SearchCondition, column: SearchColumnMetadata, registry: OperatorRegistry): readonly string[] {
+  const d = registry.require(c.operator);
+  return d.serialize ? d.serialize(c.values, column) : c.values;
+}
+
+export class JsonQueryCompiler implements SearchQueryCompiler<JsonQuery> {
+  constructor(private readonly registry: OperatorRegistry = defaultOperatorRegistry) {}
+
+  compile(query: SearchGroup, metadata: SearchTableMetadata): JsonQuery {
+    const pruned = prepare(query, metadata, this.registry);
+    const walk = (g: SearchGroup): JsonGroup => ({
+      combinator: g.combinator,
+      children: g.children.map((c) => {
+        if (isGroup(c)) return walk(c);
+        const column = metadata.byName.get(c.field)!;
+        return { field: c.field, type: column.dataType, operator: c.operator, values: serializeValues(c, column, this.registry) };
+      })
+    });
+    return { table: metadata.name, version: 1, where: walk(pruned) };
+  }
+}
+
+export interface RestFilterOutput {
+  readonly params: URLSearchParams;
+  readonly filter: string;
+}
+
+export class RestFilterCompiler implements SearchQueryCompiler<RestFilterOutput> {
+  constructor(private readonly registry: OperatorRegistry = defaultOperatorRegistry) {}
+
+  compile(query: SearchGroup, metadata: SearchTableMetadata): RestFilterOutput {
+    const pruned = prepare(query, metadata, this.registry);
+    const enc = (v: string) => encodeURIComponent(v).replace(/[()',]/g, (ch) => `%${ch.charCodeAt(0).toString(16).toUpperCase()}`);
+    const walk = (g: SearchGroup): string =>
+      `${g.combinator.toLowerCase()}(${g.children
+        .map((c) => {
+          if (isGroup(c)) return walk(c);
+          const column = metadata.byName.get(c.field)!;
+          const op = this.registry.require(c.operator).backend?.rest ?? c.operator.toLowerCase();
+          const values = serializeValues(c, column, this.registry);
+          return values.length === 0 ? `${op}(${c.field})` : `${op}(${c.field},${values.map(enc).join(",")})`;
+        })
+        .join(",")})`;
+    const filter = pruned.children.length === 0 ? "" : walk(pruned);
+    const params = new URLSearchParams();
+    if (filter) params.set("filter", filter);
+    return { params, filter };
+  }
+}
+
+export interface SqlPreview {
+  readonly sql: string;
+  readonly binds: Readonly<Record<string, string>>;
+}
+
+const IDENTIFIER = /^[A-Z][A-Z0-9_$#]{0,127}$/i;
+export const ORACLE_IN_LIMIT = 1000;
+
+export function escapeLike(value: string, escape = "\\"): string {
+  return value.replace(/[\\%_]/g, (ch) => escape + ch);
+}
+
+export class SqlPreviewCompiler implements SearchQueryCompiler<SqlPreview> {
+  constructor(private readonly registry: OperatorRegistry = defaultOperatorRegistry) {}
+
+  compile(query: SearchGroup, metadata: SearchTableMetadata): SqlPreview {
+    if (!IDENTIFIER.test(metadata.name)) throw new SearchCompilationError([{ field: "", code: "invalidTable", message: metadata.name }]);
+    const pruned = prepare(query, metadata, this.registry);
+    const binds: Record<string, string> = {};
+    let n = 0;
+    const bind = (v: string) => {
+      const k = `p${++n}`;
+      binds[k] = v;
+      return `:${k}`;
+    };
+    const typed = (column: SearchColumnMetadata, v: string) => {
+      const b = bind(v);
+      switch (column.dataType) {
+        case "NUMBER":
+          return `TO_NUMBER(${b})`;
+        case "DATE":
+          return `TO_DATE(${b}, 'YYYY-MM-DD')`;
+        case "TIMESTAMP":
+          return `TO_TIMESTAMP(${b}, 'YYYY-MM-DD"T"HH24:MI:SS.FF')`;
+        default:
+          return b;
+      }
+    };
+    const condition = (c: SearchCondition): string => {
+      const column = metadata.byName.get(c.field)!;
+      if (!IDENTIFIER.test(column.name)) throw new SearchCompilationError([{ field: c.field, code: "invalidColumn", message: c.field }]);
+      const col = `"${column.name}"`;
+      const v = serializeValues(c, column, this.registry);
+      switch (c.operator) {
+        case "EQ":
+          return `${col} = ${typed(column, v[0])}`;
+        case "NE":
+          return `(${col} <> ${typed(column, v[0])} OR ${col} IS NULL)`;
+        case "GT":
+          return `${col} > ${typed(column, v[0])}`;
+        case "GTE":
+          return `${col} >= ${typed(column, v[0])}`;
+        case "LT":
+          return `${col} < ${typed(column, v[0])}`;
+        case "LTE":
+          return `${col} <= ${typed(column, v[0])}`;
+        case "BETWEEN":
+          return `${col} BETWEEN ${typed(column, v[0])} AND ${typed(column, v[1])}`;
+        case "NOT_BETWEEN":
+          return `(${col} NOT BETWEEN ${typed(column, v[0])} AND ${typed(column, v[1])} OR ${col} IS NULL)`;
+        case "IN":
+        case "NOT_IN": {
+          const chunks: string[] = [];
+          for (let i = 0; i < v.length; i += ORACLE_IN_LIMIT) chunks.push(v.slice(i, i + ORACLE_IN_LIMIT).map((x) => typed(column, x)).join(", "));
+          return c.operator === "IN"
+            ? `(${chunks.map((ch) => `${col} IN (${ch})`).join(" OR ")})`
+            : `((${chunks.map((ch) => `${col} NOT IN (${ch})`).join(" AND ")}) OR ${col} IS NULL)`;
+        }
+        case "CONTAINS":
+          return `${col} LIKE ${bind(`%${escapeLike(v[0])}%`)} ESCAPE '\\'`;
+        case "NOT_CONTAINS":
+          return `(${col} NOT LIKE ${bind(`%${escapeLike(v[0])}%`)} ESCAPE '\\' OR ${col} IS NULL)`;
+        case "STARTS_WITH":
+          return `${col} LIKE ${bind(`${escapeLike(v[0])}%`)} ESCAPE '\\'`;
+        case "ENDS_WITH":
+          return `${col} LIKE ${bind(`%${escapeLike(v[0])}`)} ESCAPE '\\'`;
+        case "IS_NULL":
+          return `${col} IS NULL`;
+        case "IS_NOT_NULL":
+          return `${col} IS NOT NULL`;
+        default: {
+          const sql = this.registry.require(c.operator).backend?.sql;
+          if (!sql || !/^[A-Z ]+$/.test(sql)) throw new SearchCompilationError([{ field: c.field, code: "noSqlMapping", message: c.operator }]);
+          return `${col} ${sql} ${v.map((x) => typed(column, x)).join(" AND ")}`.trim();
+        }
+      }
+    };
+    const walk = (g: SearchGroup): string => {
+      const parts = g.children.map((c) => (isGroup(c) ? `(${walk(c)})` : condition(c)));
+      return parts.join(` ${g.combinator} `);
+    };
+    const where = pruned.children.length === 0 ? "" : ` WHERE ${walk(pruned)}`;
+    return { sql: `SELECT * FROM "${metadata.name}"${where}`, binds };
+  }
+}
