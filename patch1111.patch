+import { memo, useCallback, useId, type CSSProperties } from "react";
+import type { SearchColumnMetadata } from "../core/metadata.js";
+import type { OperatorDefinition } from "../core/operators.js";
+import type { OptionCache, OptionProvider } from "../core/providers.js";
+import type { SearchCondition } from "../core/query.js";
+import type { FieldRenderer } from "./inputs.js";
+
+export interface SearchFieldProps {
+  readonly column: SearchColumnMetadata;
+  readonly label: string;
+  readonly condition: SearchCondition;
+  readonly operators: readonly OperatorDefinition[];
+  readonly operatorLabels: Readonly<Record<string, string>>;
+  readonly renderer: FieldRenderer | null;
+  readonly optionProvider?: OptionProvider;
+  readonly optionCache?: OptionCache;
+  readonly error?: string;
+  readonly clearLabel: string;
+  readonly style?: CSSProperties;
+  /** Visually hide the label (still announced) when a container already shows it. */
+  readonly hideLabel?: boolean;
+  readonly custom: boolean;
+  readonly disabled?: boolean;
+  readonly onOperator: (field: string, operator: string) => void;
+  readonly onValues: (field: string, values: string[]) => void;
+  readonly onClear: (field: string) => void;
+  readonly measureRef?: (field: string, el: HTMLElement | null) => void;
+}
+
+export const SearchField = memo(function SearchField(p: SearchFieldProps) {
+  const uid = useId();
+  const inputId = `${uid}-input`;
+  const operatorId = `${uid}-op`;
+  const errorId = `${uid}-err`;
+  const labelId = `${uid}-label`;
+  const name = p.column.name;
+  const operator = p.operators.find((o) => o.id === p.condition.operator) ?? p.operators[0];
+  const onValues = useCallback((v: string[]) => p.onValues(name, v), [p.onValues, name]);
+  const measure = useCallback((el: HTMLElement | null) => p.measureRef?.(name, el), [p.measureRef, name]);
+  const Renderer = p.renderer;
+  const hasValue = operator?.input === "none" || p.condition.values.some((v) => v !== "");
+  const controls = (
+    <>
+      <select
+        id={operatorId}
+        className="dec-search__operator"
+        aria-labelledby={`${labelId} ${operatorId}`}
+        value={operator?.id ?? ""}
+        disabled={p.disabled}
+        onChange={(e) => p.onOperator(name, e.target.value)}
+      >
+        {p.operators.map((o) => (
+          <option key={o.id} value={o.id}>
+            {p.operatorLabels[o.id] ?? o.label}
+          </option>
+        ))}
+      </select>
+      {Renderer && operator && (
+        <Renderer
+          id={inputId}
+          column={p.column}
+          operator={operator}
+          values={p.condition.values}
+          onChange={onValues}
+          label={p.label}
+          invalid={!!p.error}
+          describedBy={p.error ? errorId : undefined}
+          disabled={p.disabled}
+          optionProvider={p.optionProvider}
+          optionCache={p.optionCache}
+        />
+      )}
+      {hasValue && (
+        <button type="button" className="dec-search__clear" aria-label={`${p.clearLabel} ${p.label}`} onClick={() => p.onClear(name)} disabled={p.disabled}>
+          ×
+        </button>
+      )}
+    </>
+  );
+  return (
+    <div
+      className={`dec-search__field${p.error ? " dec-search__field--invalid" : ""}`}
+      style={p.style}
+      data-field={name}
+      data-operator={operator?.id}
+      role="group"
+      aria-labelledby={labelId}
+    >
+      <label id={labelId} className={p.hideLabel ? "dec-search__sr" : "dec-search__label"} htmlFor={Renderer ? inputId : operatorId} title={p.label}>
+        {p.label}
+      </label>
+      <div className="dec-search__controls">
+        {p.custom ? (
+          <span className="dec-search__intrinsic" ref={measure}>
+            {controls}
+          </span>
+        ) : (
+          controls
+        )}
+      </div>
+      {p.error && (
+        <span id={errorId} className="dec-search__error">
+          {p.error}
+        </span>
+      )}
+    </div>
+  );
+});
