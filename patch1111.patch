-
-export function pascalCase(name: string): string {
-  return name
-    .toLowerCase()
-    .split(/[^a-z0-9]+/)
-    .filter(Boolean)
-    .map((p) => p[0].toUpperCase() + p.slice(1))
-    .join("");
-}
-
-function camelCase(name: string): string {
-  const p = pascalCase(name);
-  return p[0].toLowerCase() + p.slice(1);
-}
-
-function valueType(c: SearchColumnMetadata): string {
-  return c.dataType === "UNSUPPORTED" ? "never" : "string | readonly string[]";
-}
-
-function key(name: string): string {
-  return /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(name) ? name : JSON.stringify(name);
-}
-
-function canonicalMetadata(m: OracleTableMetadata): OracleTableMetadata {
-  return {
-    name: m.name,
-    numRows: m.numRows ?? 0,
-    labels: [...m.labels],
-    dNames: [...m.dNames],
-    dTypes: [...m.dTypes],
-    precisions: [...m.precisions],
-    scales: [...m.scales],
-    defaults: [...m.defaults],
-    keys: [...(m.keys ?? [])],
-    indexes: (m.indexes ?? []).map((i) => ({ unique: i.unique, columns: [...i.columns] }))
-  };
-}
