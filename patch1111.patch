@@ -0,0 +1,111 @@
+import { useCallback, useMemo, useRef, useState } from "react";
+import type { SearchTableMetadata } from "../core/metadata.js";
+import type { OperatorRegistry } from "../core/operators.js";
+import {
+  addExpression,
+  changeOperator,
+  createCondition,
+  createGroup,
+  duplicateExpression,
+  isGroup,
+  removeExpression,
+  updateCondition,
+  updateGroup,
+  type SearchCondition,
+  type SearchGroup
+} from "../core/query.js";
+
+export type SearchValues = Readonly<Record<string, string | readonly string[] | undefined>>;
+
+export function primaryConditions(query: SearchGroup): ReadonlyMap<string, SearchCondition> {
+  const map = new Map<string, SearchCondition>();
+  for (const c of query.children) if (!isGroup(c) && !map.has(c.field)) map.set(c.field, c);
+  return map;
+}
+
+export function toSearchValues(query: SearchGroup, registry: OperatorRegistry): SearchValues {
+  const out: Record<string, string | readonly string[]> = {};
+  for (const [field, c] of primaryConditions(query)) {
+    if (!c.enabled) continue;
+    const d = registry.get(c.operator);
+    if (!d || d.valueCount === 0) continue;
+    const values = c.values.filter((v) => v !== "");
+    if (values.length === 0) continue;
+    out[field] = d.valueCount === 1 ? values[0] : values;
+  }
+  return out;
+}
+
+export function useSearchController(
+  metadata: SearchTableMetadata,
+  registry: OperatorRegistry,
+  controlled: SearchGroup | undefined,
+  defaultQuery: SearchGroup | undefined,
+  onChange: ((query: SearchGroup) => void) | undefined
+) {
+  const [internal, setInternal] = useState<SearchGroup>(() => defaultQuery ?? createGroup("AND", [], "root"));
+  const query = controlled ?? internal;
+  const ref = useRef(query);
+  ref.current = query;
+  const onChangeRef = useRef(onChange);
+  onChangeRef.current = onChange;
+  const isControlled = controlled !== undefined;
+
+  const apply = useCallback(
+    (fn: (q: SearchGroup) => SearchGroup) => {
+      const next = fn(ref.current);
+      if (next === ref.current) return;
+      ref.current = next;
+      if (!isControlled) setInternal(next);
+      onChangeRef.current?.(next);
+    },
+    [isControlled]
+  );
+
+  const ensure = useCallback(
+    (q: SearchGroup, field: string): [SearchGroup, SearchCondition] => {
+      const existing = primaryConditions(q).get(field);
+      if (existing) return [q, existing];
+      const c = createCondition(metadata, field, registry);
+      return [addExpression(q, c), c];
+    },
+    [metadata, registry]
+  );
+
+  const actions = useMemo(
+    () => ({
+      replace: (q: SearchGroup) => apply(() => q),
+      setFieldOperator: (field: string, operator: string) =>
+        apply((q) => {
+          const [base, c] = ensure(q, field);
+          return changeOperator(base, c.id, operator, registry);
+        }),
+      setFieldValues: (field: string, values: string[]) =>
+        apply((q) => {
+          const [base, c] = ensure(q, field);
+          return updateCondition(base, c.id, { values, enabled: true });
+        }),
+      clearField: (field: string) =>
+        apply((q) => {
+          const c = primaryConditions(q).get(field);
+          return c ? removeExpression(q, c.id) : q;
+        }),
+      setCombinator: (id: string, combinator: "AND" | "OR") => apply((q) => updateGroup(q, id, { combinator })),
+      addCondition: (groupId: string, field: string) => apply((q) => addExpression(q, createCondition(metadata, field, registry), groupId)),
+      addGroup: (groupId: string) => apply((q) => addExpression(q, createGroup("OR"), groupId)),
+      remove: (id: string) => apply((q) => removeExpression(q, id)),
+      duplicate: (id: string) => apply((q) => duplicateExpression(q, id)),
+      toggle: (id: string, enabled: boolean) => apply((q) => updateCondition(q, id, { enabled })),
+      setOperator: (id: string, operator: string) => apply((q) => changeOperator(q, id, operator, registry)),
+      setValues: (id: string, values: string[]) => apply((q) => updateCondition(q, id, { values })),
+      setField: (id: string, field: string) =>
+        apply((q) => {
+          const fresh = createCondition(metadata, field, registry, { id });
+          return updateCondition(q, id, { field, operator: fresh.operator, values: fresh.values });
+        })
+    }),
+    [apply, ensure, metadata, registry]
+  );
+
+  return { query, queryRef: ref, actions };
+}
