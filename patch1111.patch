+  readonly text: string;
+}
+
+const IDLE: SearchStatus = { state: "idle" };
+
+type Dialog = { kind: "name"; mode: "save" | "saveAs"; value: string } | null;
+
+export function GenericSearch<TValues extends object = SearchValues, TRow = unknown>(props: GenericSearchProps<TValues, TRow>) {
