+  const metricsByField = useMemo(() => new Map(metrics.map((m) => [m.fieldId, m])), [metrics]);
+
+  const flowRef = useRef<PersistableFlowHandle>(null);
+  const flowId = props.layoutId ?? `dec-search:${metadata.name}`;
+  const syncFromFlow = useCallback((e: FlowLayoutChangeEvent) => {
+    const items = [...e.layout.items].sort((a, b) => a.order - b.order);
+    setFieldOrder((prev) => {
+      const known = items.map((i) => i.id).filter((id) => prev.includes(id));
