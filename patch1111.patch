+import type { OperatorDefinition } from "../core/operators.js";
+import { OptionCache, type OptionProvider, type SearchOption } from "../core/providers.js";
+
+export interface SearchInputProps {
+  readonly id: string;
+  readonly column: SearchColumnMetadata;
+  readonly operator: OperatorDefinition;
+  readonly values: readonly string[];
+  readonly onChange: (values: string[]) => void;
+  readonly label: string;
+  readonly invalid?: boolean;
+  readonly describedBy?: string;
+  readonly disabled?: boolean;
+  readonly optionProvider?: OptionProvider;
+  readonly optionCache?: OptionCache;
+  readonly placeholder?: string;
+}
+
+export type FieldRenderer = ComponentType<SearchInputProps>;
+
+interface ScalarProps {
+  readonly id: string;
+  readonly value: string;
+  readonly onValue: (value: string) => void;
+  readonly label: string;
+  readonly invalid?: boolean;
+  readonly describedBy?: string;
+  readonly disabled?: boolean;
+  readonly column: SearchColumnMetadata;
+  readonly placeholder?: string;
+}
+
+function common(p: ScalarProps) {
+  return {
+    id: p.id,
+    className: "dec-search__input",
+    "aria-label": p.label,
+    "aria-invalid": p.invalid || undefined,
+    "aria-describedby": p.describedBy,
+    disabled: p.disabled,
+    placeholder: p.placeholder
+  };
+}
+
+const TextScalar = (p: ScalarProps) => (
+  <input {...common(p)} type="text" value={p.value} maxLength={p.column.maxLength ?? undefined} onChange={(e) => p.onValue(e.target.value)} />
+);
+
+const NumberScalar = (p: ScalarProps) => (
+  <input
+    {...common(p)}
+    type="text"
+    inputMode={p.column.integer ? "numeric" : "decimal"}
+    value={p.value}
+    onChange={(e) => p.onValue(e.target.value.replace(",", "."))}
+  />
+);
+
+const DateScalar = (p: ScalarProps) => <input {...common(p)} type="date" value={p.value} onChange={(e) => p.onValue(e.target.value)} />;
+
+const TimeScalar = (p: ScalarProps) => <input {...common(p)} type="time" step={1} value={p.value} onChange={(e) => p.onValue(e.target.value)} />;
+
+const DateTimeScalar = (p: ScalarProps) => <input {...common(p)} type="datetime-local" step={1} value={p.value} onChange={(e) => p.onValue(e.target.value)} />;
+
+const BooleanScalar = (p: ScalarProps) => (
+  <select {...common(p)} value={p.value} onChange={(e) => p.onValue(e.target.value)}>
+    <option value=""></option>
+    <option value="true">✓</option>
+    <option value="false">✗</option>
+  </select>
+);
+
+export function scalarFor(column: SearchColumnMetadata): ComponentType<ScalarProps> {
+  switch (column.dataType) {
+    case "NUMBER":
+      return NumberScalar;
+    case "DATE":
+      return DateScalar;
+    case "TIME":
+      return TimeScalar;
+    case "TIMESTAMP":
+      return DateTimeScalar;
+    case "BOOLEAN":
+      return BooleanScalar;
+    default:
+      return TextScalar;
+  }
+}
+
+function single(Scalar: ComponentType<ScalarProps>): FieldRenderer {
+  const C = (p: SearchInputProps) => (
+    <Scalar
+      id={p.id}
+      column={p.column}
+      value={p.values[0] ?? ""}
+      onValue={(v) => p.onChange([v])}
+      label={p.label}
+      invalid={p.invalid}
+      describedBy={p.describedBy}
+      disabled={p.disabled}
+      placeholder={p.placeholder}
+    />
+  );
+  return memo(C);
+}
+
+export const TextSearchInput = single(TextScalar);
+export const NumberSearchInput = single(NumberScalar);
+export const DateSearchInput = single(DateScalar);
+export const TimeSearchInput = single(TimeScalar);
+export const DateTimeSearchInput = single(DateTimeScalar);
+export const BooleanSearchInput = single(BooleanScalar);
+
+export const RangeSearchInput = memo(function RangeSearchInput(p: SearchInputProps) {
+  const Scalar = scalarFor(p.column);
+  const values = [p.values[0] ?? "", p.values[1] ?? ""];
+  return (
+    <span className="dec-search__range" role="group" aria-label={p.label}>
