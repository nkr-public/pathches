+  readonly layoutId?: string;
+  readonly layoutPersistence?: FlowPersistenceMode;
+  readonly query?: SearchGroup;
+  readonly defaultQuery?: SearchGroup;
+  readonly fields?: readonly Extract<keyof TValues, string>[];
+  readonly defaultVisibleFields?: readonly Extract<keyof TValues, string>[];
+  readonly isFieldVisible?: (field: Extract<keyof TValues, string>, values: TValues) => boolean;
+  readonly showNullOperatorsForNotNull?: boolean;
+  readonly profiles?: readonly SearchProfile[];
+  readonly executionOptions?: Omit<SearchExecutionOptions, "signal" | "metadata">;
+  readonly searchOnChange?: boolean | { readonly debounceMs: number };
+  readonly searchOnEnter?: boolean;
+  readonly actions?: readonly SearchToolbarAction[];
+  readonly messages?: Partial<SearchMessages>;
+  readonly className?: string;
+  readonly title?: ReactNode;
+  readonly status?: SearchStatus;
+  readonly collapsed?: boolean;
+  readonly defaultCollapsed?: boolean;
+  readonly disabled?: boolean;
+  readonly children?: ReactNode;
+  readonly onChange?: (query: SearchGroup, values: TValues) => void;
+  readonly onSearch?: (query: SearchGroup, context: SearchContext<TValues>) => void;
+  readonly onResult?: (result: SearchResult<TRow>) => void;
+  readonly onError?: (error: unknown) => void;
+  readonly onReset?: () => void;
+  readonly onCancel?: () => void;
+  readonly onCollapsedChange?: (collapsed: boolean) => void;
+  readonly onSave?: (saved: SavedSearch) => void;
+  readonly onRestore?: (saved: SavedSearch, incompatible: readonly string[]) => void;
