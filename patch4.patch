+import { useSyncExternalStore } from 'react';
+import { OpfsStorage } from '@dec/ui';
+import { ROUTES } from '../../app/routes.ts';
+
+export const DEFAULT_SHORTCUTS: Readonly<Record<string, string>> = {
+  ...Object.fromEntries(ROUTES.map((r) => [r.id, r.shortcut])),
+  palette: 'mod+k',
+  overview: 'mod+w',
+};
+
+export const RESERVED_SHORTCUTS = ['mod+r', 'f5', 'mod+shift+r', 'escape', 'tab', 'shift+tab', 'enter'];
+
+const FILE = 'shortcuts.json';
+const storage = new OpfsStorage(['settings']);
+const MODIFIERS = ['mod', 'ctrl', 'meta', 'alt', 'shift'] as const;
+const isMac = () => typeof navigator !== 'undefined' && /mac|iphone|ipad/i.test(navigator.platform || navigator.userAgent);
+
+let overrides: Record<string, string> = {};
+let bindings: Record<string, string> = { ...DEFAULT_SHORTCUTS };
+let recording = false;
+const listeners = new Set<() => void>();
+
+const emit = () => {
+  bindings = { ...DEFAULT_SHORTCUTS, ...overrides };
+  for (const l of listeners) l();
+};
+
+const subscribe = (l: () => void) => {
+  listeners.add(l);
+  return () => listeners.delete(l);
+};
+
+export function normalizeShortcut(keys: string): string {
+  const native = isMac() ? 'meta' : 'ctrl';
+  const parts = keys.toLowerCase().split('+').map((p) => p.trim()).filter(Boolean).map((p) => (p === native ? 'mod' : p));
+  const key = parts.filter((p) => !(MODIFIERS as readonly string[]).includes(p)).pop() ?? '';
+  const mods = MODIFIERS.filter((m) => parts.includes(m));
+  return [...mods, key].join('+');
+}
+
+export function shortcutFromEvent(e: KeyboardEvent): string | null {
+  const key = e.key.toLowerCase();
+  if (['control', 'shift', 'alt', 'meta', 'os', 'dead', 'unidentified'].includes(key)) return null;
+  const mac = isMac();
+  const code = /^(Key|Digit)(.)$/.exec(e.code)?.[2]?.toLowerCase();
+  const parts: string[] = [];
+  if (mac ? e.metaKey : e.ctrlKey) parts.push('mod');
+  if (mac && e.ctrlKey) parts.push('ctrl');
+  if (!mac && e.metaKey) parts.push('meta');
+  if (e.altKey) parts.push('alt');
+  if (e.shiftKey) parts.push('shift');
+  parts.push(code ?? (key === ' ' ? 'space' : key));
+  return normalizeShortcut(parts.join('+'));
+}
+
+export function findConflict(id: string, keys: string): string | null {
+  const wanted = normalizeShortcut(keys);
+  if (RESERVED_SHORTCUTS.includes(wanted)) return 'reserved';
+  const hit = Object.entries(bindings).find(([other, k]) => other !== id && normalizeShortcut(k) === wanted);
+  return hit ? hit[0] : null;
+}
+
+export function isBareKey(keys: string): boolean {
+  const parts = normalizeShortcut(keys).split('+');
+  return parts.length === 1 || (parts.length === 2 && parts[0] === 'shift');
+}
+
+async function save() {
+  try {
+    await storage.write(FILE, new TextEncoder().encode(JSON.stringify(overrides)));
+  } catch (error) {
+    console.warn('Shortcut settings could not be saved', error);
+  }
+}
+
+export function setShortcut(id: string, keys: string) {
+  const next = normalizeShortcut(keys);
+  const { [id]: _, ...rest } = overrides;
+  overrides = next === normalizeShortcut(DEFAULT_SHORTCUTS[id] ?? '') ? rest : { ...rest, [id]: next };
+  emit();
+  void save();
+}
+
+export function resetShortcut(id: string) {
+  const { [id]: _, ...rest } = overrides;
+  overrides = rest;
+  emit();
+  void save();
+}
+
+export function resetAllShortcuts() {
+  overrides = {};
+  emit();
+  void save();
+}
+
+export function setRecording(value: boolean) {
+  recording = value;
+}
+
+export function getShortcut(id: string): string {
+  return bindings[id] ?? '';
+}
+
+export function matchesAction(e: KeyboardEvent, id: string): boolean {
+  if (recording) return false;
+  const keys = bindings[id];
+  return !!keys && !e.repeat && shortcutFromEvent(e) === normalizeShortcut(keys);
+}
+
+export function useShortcuts(): Readonly<Record<string, string>> {
+  return useSyncExternalStore(subscribe, () => bindings);
+}
+
+export function useShortcut(id: string): string {
+  return useShortcuts()[id] ?? '';
+}
+
+export function isCustomized(id: string): boolean {
+  return id in overrides;
+}
+
+export async function loadShortcuts() {
+  try {
+    const bytes = await storage.read(FILE);
+    if (!bytes) return;
+    const parsed: unknown = JSON.parse(new TextDecoder().decode(bytes));
+    if (!parsed || typeof parsed !== 'object') return;
+    overrides = Object.fromEntries(
+      Object.entries(parsed as Record<string, unknown>).filter(
+        ([id, k]) => id in DEFAULT_SHORTCUTS && typeof k === 'string' && k.length > 0,
+      ),
+    ) as Record<string, string>;
+    emit();
+  } catch (error) {
+    console.warn('Shortcut settings could not be loaded', error);
+  }
+}
+
+void loadShortcuts();
