+        const cache = decodeSegment(name);
+        if (cache !== null) out.add(cache);
+      }
+    } catch {
+      return out;
+    }
+    return out;
+  }
+
+  async openStore(cache: string, onError: (error: unknown) => void): Promise<TableStore> {
+    return new TableStore(await this.storageOf(cache), TABLE_DIR, { flushDelayMs: -1, onError });
+  }
+
+  restore(cache: string, store: TableStore, table: Table): Promise<TableRestoreInfo | null> {
+    return this.locked(cache, () => store.restore(table));
+  }
+
+  async snapshot(cache: string, store: TableStore): Promise<void> {
+    try {
+      await this.locked(cache, () => store.snapshot());
+    } catch (e) {
+      throw persistenceError('snapshot', cache, e);
+    }
+  }
+
+  async persist(cache: string, store: TableStore): Promise<void> {
+    try {
+      await this.locked(cache, () => store.persist());
+    } catch (e) {
+      throw persistenceError('persist', cache, e);
+    }
+  }
+
+  async readMarker(cache: string): Promise<SyncMarker | null> {
+    try {
+      const bytes = await (await this.storageOf(cache)).read(MARKER_FILE);
+      if (!bytes) return null;
+      const marker = JSON.parse(new TextDecoder().decode(bytes)) as SyncMarker | null;
+      return marker && typeof marker.schemaVersion === 'number' && typeof marker.definitionVersion === 'number' ? marker : null;
+    } catch {
+      return null;
+    }
+  }
+
+  async writeMarker(cache: string, marker: SyncMarker): Promise<void> {
+    try {
+      const storage = await this.storageOf(cache);
+      await this.locked(cache, () => storage.write(MARKER_FILE, new TextEncoder().encode(JSON.stringify(marker))));
+    } catch (e) {
+      throw persistenceError('marker write', cache, e);
+    }
+  }
+
+  async clear(cache: string): Promise<void> {
+    try {
+      const storage = await this.storageOf(cache);
+      await this.locked(cache, () => storage.removeDir(''));
+    } catch (e) {
+      throw persistenceError('clear', cache, e);
+    }
+  }
+
+  async dispose(): Promise<void> {
+    const root = this.root;
+    this.root = null;
+    if (root) (await root.catch(() => null))?.dispose();
+  }
+
+  private base(): Promise<BinaryStorage> {
+    return (this.root ??= createStorage(this.storageName, StorageKind.Fs));
+  }
+
+  private async storageOf(cache: string): Promise<BinaryStorage> {
+    return scopeStorage(await this.base(), this.requireScope(), cache);
+  }
+
+  private locked<T>(cache: string, fn: () => Promise<T>): Promise<T> {
+    return runLocked(`dec-cache:${this.requireScope()}:${cache}`, fn);
+  }
+
+  private requireScope(): string {
+    if (this.current === null) throw new CacheError('PROTOCOL', 'no storage scope: HELLO is required first');
+    return this.current;
+  }
+}
