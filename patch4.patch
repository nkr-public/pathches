+import {
+  memo,
+  useCallback,
+  useEffect,
+  useId,
+  useImperativeHandle,
+  useMemo,
+  useRef,
+  useState,
+  type CSSProperties,
+  type KeyboardEvent,
+  type Ref,
+} from 'react';
+import { useVirtualizer } from '@tanstack/react-virtual';
+import { useT } from '@dec/i18n/react';
+import { Checkbox, EmptyState, Skeleton, cn, focusRing } from '@dec/ui';
+import type { CacheKey } from '@dec/cache';
+import { messages } from '../i18n/index.ts';
+import { useCacheView, useCacheViewRow, type CacheViewState } from '../view/useCacheView.ts';
+
+export interface SelectionColumn {
+  id: string;
+  label: string;
+  width?: number;
+}
+
+export interface SelectionTableHandle {
+  handleKeyDown(event: KeyboardEvent): void;
+}
+
+export interface SelectionTableProps {
+  cache: string;
+  columns: SelectionColumn[];
+  text: string;
+  value: CacheKey[];
+  onChange(keys: CacheKey[]): void;
+  multiple?: boolean;
+  height?: number;
+  rowHeight?: number;
+  onActivate?(key: CacheKey): void;
+  id?: string;
+  className?: string;
+  'aria-label'?: string;
+  ref?: Ref<SelectionTableHandle>;
+}
+
+const OVERSCAN = 10;
+const CHECKBOX_COLUMN_WIDTH = 36;
+const PLACEHOLDER_ROWS = 6;
+
+function formatValue(value: unknown): string {
+  if (value === null || value === undefined) return '';
+  if (value instanceof Date) return value.toLocaleString();
+  return String(value);
+}
+
+function rowId(tableId: string, index: number): string {
+  return `${tableId}-row-${index}`;
+}
+
+interface SelectionRowProps {
+  view: CacheViewState;
+  index: number;
+  start: number;
+  height: number;
+  columns: SelectionColumn[];
+  template: string;
+  tableId: string;
+  multiple: boolean;
+  active: boolean;
+  selectedKeys: ReadonlySet<CacheKey>;
+  onPick(index: number): void;
+  onHover(index: number): void;
+}
+
+const SelectionRow = memo(function SelectionRow({
+  view,
+  index,
+  start,
+  height,
+  columns,
+  template,
+  tableId,
+  multiple,
+  active,
+  selectedKeys,
+  onPick,
+  onHover,
+}: SelectionRowProps) {
+  const row = useCacheViewRow(view, index);
+  const selected = row ? selectedKeys.has(row.key) : false;
+  const style: CSSProperties = { height, transform: `translateY(${start}px)`, gridTemplateColumns: template };
+  return (
+    <div
+      id={rowId(tableId, index)}
+      role="row"
+      aria-rowindex={index + 2}
+      aria-selected={selected}
+      data-active={active || undefined}
+      onMouseDown={(event) => event.preventDefault()}
+      onPointerMove={() => !active && onHover(index)}
+      onClick={() => onPick(index)}
+      style={style}
+      className={cn(
+        'absolute left-0 top-0 grid w-full cursor-default select-none items-center border-b border-subtle text-[13px] text-primary',
+        selected && 'bg-accent-soft',
+        active && (selected ? 'shadow-[inset_2px_0_0_var(--ui-accent)]' : 'bg-hover'),
+      )}
+    >
+      {multiple && (
+        <span role="gridcell" className="pointer-events-none flex items-center justify-center" aria-hidden>
+          <Checkbox size="sm" checked={selected} readOnly tabIndex={-1} />
+        </span>
+      )}
+      {columns.map((column) => (
+        <span key={column.id} role="gridcell" className={cn('truncate px-2', selected && 'font-medium')}>
+          {row ? formatValue(row.values[column.id]) : <Skeleton className="w-3/4" />}
+        </span>
+      ))}
+    </div>
+  );
+});
+
+export function SelectionTable({
+  cache,
+  columns,
+  text,
+  value,
+  onChange,
+  multiple = false,
+  height = 320,
+  rowHeight = 32,
+  onActivate,
+  id,
+  className,
+  'aria-label': ariaLabel,
+  ref,
+}: SelectionTableProps) {
+  const t = useT(messages);
+  const generatedId = useId();
+  const tableId = id ?? generatedId;
+  const view = useCacheView(cache, text);
+  const { count, loading, error, rowAt, ensureRange } = view;
+  const scrollRef = useRef<HTMLDivElement | null>(null);
+  const [active, setActive] = useState(0);
+  const selectedKeys = useMemo(() => new Set(value), [value]);
+  const template = useMemo(() => {
+    const tracks = columns.map((column) => (column.width ? `${column.width}px` : 'minmax(96px, 1fr)'));
+    return (multiple ? [`${CHECKBOX_COLUMN_WIDTH}px`, ...tracks] : tracks).join(' ');
+  }, [columns, multiple]);
+  const minWidth = useMemo(
+    () => columns.reduce((total, column) => total + (column.width ?? 96), multiple ? CHECKBOX_COLUMN_WIDTH : 0),
+    [columns, multiple],
+  );
+
+  const virtualizer = useVirtualizer({
+    count,
+    getScrollElement: () => scrollRef.current,
+    estimateSize: () => rowHeight,
+    overscan: OVERSCAN,
+    scrollMargin: rowHeight,
+    scrollPaddingStart: rowHeight,
+  });
+  const items = virtualizer.getVirtualItems();
+  const firstIndex = items.length ? items[0].index : 0;
+  const lastIndex = items.length ? items[items.length - 1].index + 1 : 0;
+
+  useEffect(() => {
+    ensureRange(firstIndex, Math.max(lastIndex, firstIndex + Math.ceil(height / rowHeight) + OVERSCAN));
+  }, [ensureRange, firstIndex, lastIndex, height, rowHeight]);
+
+  useEffect(() => {
+    setActive(0);
+    virtualizer.scrollToOffset(0);
+  }, [view.view?.cache, text]);
+
+  const moveTo = useCallback(
+    (index: number) => {
+      if (!count) return;
+      const next = Math.min(Math.max(index, 0), count - 1);
+      setActive(next);
+      virtualizer.scrollToIndex(next, { align: 'auto' });
+    },
+    [count, virtualizer],
+  );
+
+  const toggle = useCallback(
+    (key: CacheKey) => {
+      onChange(selectedKeys.has(key) ? value.filter((selected) => selected !== key) : [...value, key]);
+    },
+    [onChange, selectedKeys, value],
+  );
+
+  const pick = useCallback(
+    (index: number) => {
+      const row = rowAt(index);
+      if (!row) return;
+      setActive(index);
+      if (multiple) toggle(row.key);
+      else onChange([row.key]);
+      onActivate?.(row.key);
+    },
+    [rowAt, multiple, toggle, onChange, onActivate],
+  );
+
+  const handleKeyDown = useCallback(
+    (event: KeyboardEvent) => {
+      const page = Math.max(1, Math.floor((height - rowHeight) / rowHeight));
+      switch (event.key) {
+        case 'ArrowDown':
+          moveTo(active + 1);
+          break;
+        case 'ArrowUp':
+          moveTo(active - 1);
+          break;
+        case 'PageDown':
+          moveTo(active + page);
+          break;
+        case 'PageUp':
+          moveTo(active - page);
+          break;
+        case 'Home':
+          if (event.target instanceof HTMLInputElement) return;
+          moveTo(0);
+          break;
+        case 'End':
+          if (event.target instanceof HTMLInputElement) return;
+          moveTo(count - 1);
+          break;
+        case 'Enter':
+          pick(active);
+          break;
+        case ' ': {
+          if (!multiple || event.target instanceof HTMLInputElement) return;
+          const row = rowAt(active);
+          if (row) toggle(row.key);
+          break;
+        }
+        default:
+          return;
+      }
+      event.preventDefault();
+    },
+    [height, rowHeight, moveTo, active, count, pick, multiple, rowAt, toggle],
+  );
+
+  useImperativeHandle(ref, () => ({ handleKeyDown }), [handleKeyDown]);
+
+  const empty = !loading && !error && view.view !== null && count === 0;
+  const waiting = view.view === null && !error;
+
+  return (
+    <div
+      ref={scrollRef}
+      id={tableId}
+      role="grid"
+      tabIndex={0}
+      aria-label={ariaLabel}
+      aria-multiselectable={multiple || undefined}
+      aria-rowcount={count + 1}
+      aria-busy={loading || undefined}
+      aria-activedescendant={count ? rowId(tableId, active) : undefined}
+      onKeyDown={handleKeyDown}
+      style={{ height }}
+      className={cn('ui-scroll relative overflow-auto bg-elevated', focusRing, className)}
+    >
+      <div style={{ minWidth }}>
+        <div
+          role="row"
+          aria-rowindex={1}
+          style={{ height: rowHeight, gridTemplateColumns: template }}
+          className="sticky top-0 z-10 grid items-center border-b border-default bg-surface text-[11px] font-medium uppercase tracking-wide text-muted"
+        >
+          {multiple && <span role="columnheader" aria-hidden />}
+          {columns.map((column) => (
+            <span key={column.id} role="columnheader" className="truncate px-2">
+              {column.label}
+            </span>
+          ))}
+        </div>
+        {error ? (
+          <EmptyState size="sm" title={t('table.error')} description={error.message} className="py-6" />
+        ) : empty ? (
+          <EmptyState size="sm" title={t('table.empty')} className="py-6" />
+        ) : waiting ? (
+          Array.from({ length: PLACEHOLDER_ROWS }, (_, index) => (
+            <div key={index} style={{ height: rowHeight }} className="flex items-center border-b border-subtle px-2">
+              <Skeleton className="w-2/3" />
+            </div>
+          ))
+        ) : (
+          <div role="rowgroup" className="relative" style={{ height: virtualizer.getTotalSize() }}>
+            {items.map((item) => (
+              <SelectionRow
+                key={item.key}
+                view={view}
+                index={item.index}
+                start={item.start - rowHeight}
+                height={rowHeight}
+                columns={columns}
+                template={template}
+                tableId={tableId}
+                multiple={multiple}
+                active={item.index === active}
+                selectedKeys={selectedKeys}
+                onPick={pick}
+                onHover={setActive}
+              />
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
