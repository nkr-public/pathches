+
+export function useCacheViewRow(view: CacheViewState, index: number): CacheViewRow | undefined {
+  const read = useCallback(() => view.rowAt(index), [view.rowAt, index]);
+  return useSyncExternalStore(view.subscribeRows, read, read);
+}
