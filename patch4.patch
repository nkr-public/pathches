+import { useT } from '@dec/i18n/react';
+import { getLocale } from '@dec/i18n';
+import { AlertCircle, AlertTriangle, BellOff } from 'lucide-react';
+import { Button } from '@dec/ui';
+import { storeWorkspacesOf, useWorkspaceManager, useWorkspaces, type WorkspaceInstance } from '@dec/workspace';
+import { messages, type AppMessageKey } from '../../i18n/index.ts';
+import '../sidepanel/sidepanel.css';
+import { clearNotifications, markAllRead, useNotifications, type AppNotification, type NotificationKind } from './store.ts';
+
+const TITLE_KEY: Record<NotificationKind, AppMessageKey> = {
+  apiError: 'shell.notificationsPanel.apiError',
+  apiUnreachable: 'shell.notificationsPanel.apiUnreachable',
+  storeError: 'shell.notificationsPanel.storeError',
+  saveFailed: 'shell.notificationsPanel.saveFailed',
+  savePartial: 'shell.notificationsPanel.savePartial',
+  conflict: 'shell.notificationsPanel.conflict',
+};
+
+function findHost(workspaces: readonly WorkspaceInstance[], storeWorkspaceId: string | undefined): WorkspaceInstance | undefined {
+  if (!storeWorkspaceId) return undefined;
+  return workspaces.find((w) => storeWorkspacesOf(w.id).some((s) => s.id === storeWorkspaceId));
+}
+
+export function NotificationList({ onNavigate }: { onNavigate: () => void }) {
+  const t = useT(messages);
+  const notifications = useNotifications();
+  const workspaces = useWorkspaces();
+  const manager = useWorkspaceManager();
+  const timeFormat = new Intl.DateTimeFormat(getLocale(), { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+
+  const openHost = (host: WorkspaceInstance) => {
+    void manager.activate(host.id);
+    onNavigate();
+  };
+
+  const renderEntry = (n: AppNotification) => {
+    const host = findHost(workspaces, n.storeWorkspaceId);
+    const Icon = n.tone === 'danger' ? AlertCircle : AlertTriangle;
+    const body = (
+      <>
+        <Icon size={14} className="np-icon" data-tone={n.tone} aria-hidden="true" />
+        <span className="np-text">
+          <span className="np-title">
+            {t(TITLE_KEY[n.kind], n.params)}
+            {n.repeat > 1 && <span className="np-repeat">{t('shell.notificationsPanel.repeated', { count: n.repeat })}</span>}
+          </span>
+          {n.detail && <span className="np-detail">{n.detail}</span>}
+          <span className="np-meta">
+            <time dateTime={new Date(n.time).toISOString()}>{timeFormat.format(n.time)}</time>
+            <span aria-hidden="true">·</span>
+            <span className="np-source">{host?.title ?? n.source}</span>
+          </span>
+        </span>
+      </>
+    );
+    return (
+      <li key={n.id} className="np-item" data-read={n.read}>
+        {host ? (
+          <button type="button" className="np-entry" onClick={() => openHost(host)}>
+            {body}
+          </button>
+        ) : (
+          <div className="np-entry">{body}</div>
+        )}
+      </li>
+    );
+  };
+
+  return (
+    <div className="np-root" role="region" aria-label={t('shell.notificationsPanel.title')}>
+      <header className="np-header">
+        <span className="np-heading">{t('shell.notificationsPanel.title')}</span>
+        <span className="np-actions">
+          <Button size="sm" variant="ghost" onClick={markAllRead} disabled={!notifications.some((n) => !n.read)}>
+            {t('shell.notificationsPanel.markAllRead')}
+          </Button>
+          <Button size="sm" variant="ghost" onClick={clearNotifications} disabled={notifications.length === 0}>
+            {t('shell.notificationsPanel.clear')}
+          </Button>
+        </span>
+      </header>
+      {notifications.length === 0 ? (
+        <p className="np-empty">
+          <BellOff size={16} aria-hidden="true" />
+          {t('shell.notificationsPanel.empty')}
+        </p>
+      ) : (
+        <ul className="np-list ui-scroll">{notifications.map(renderEntry)}</ul>
+      )}
+    </div>
+  );
+}
