+import type { TimeSlicer } from './TimeSlicer.ts';
+
+const RUN = 16384;
+
+export type OrdinalComparator = (a: number, b: number) => number;
+
+export async function sortOrder(order: Uint32Array, compare: OrdinalComparator, slicer: TimeSlicer): Promise<Uint32Array> {
+  const n = order.length;
+  for (let start = 0; start < n; start += RUN) {
+    order.subarray(start, Math.min(n, start + RUN)).sort(compare);
+    if (slicer.shouldPause()) await slicer.pause();
+  }
+  if (n <= RUN) return order;
+  let source: Uint32Array = order;
+  let target: Uint32Array = new Uint32Array(n);
+  for (let width = RUN; width < n; width *= 2) {
+    for (let low = 0; low < n; low += 2 * width) {
+      const middle = Math.min(n, low + width);
+      const high = Math.min(n, low + 2 * width);
+      let left = low;
+      let right = middle;
+      let out = low;
+      while (left < middle && right < high) {
+        target[out++] = compare(source[left], source[right]) <= 0 ? source[left++] : source[right++];
+        if ((out & 4095) === 0 && slicer.shouldPause()) await slicer.pause();
+      }
+      if (left < middle) target.set(source.subarray(left, middle), out);
+      else if (right < high) target.set(source.subarray(right, high), out);
+    }
+    const swap = source;
+    source = target;
+    target = swap;
+  }
+  return source;
+}
