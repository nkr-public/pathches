+  return useMemo(
+    () => ({
+      view: snapshot.view,
+      count: snapshot.view?.count ?? 0,
+      loading: snapshot.loading,
+      error: snapshot.error,
+      rowAt: store.rowAt,
+      ensureRange: store.ensureRange,
+      subscribeRows: store.subscribe,
+    }),
+    [snapshot, store],
+  );
