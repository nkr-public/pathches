+import type { CacheResidency, WorkspaceActivity } from '../../protocol/runtime.ts';
+import type { ResidencyCandidate, ResidencyManagerOptions, ResidencyService } from '../contracts.ts';
+
+interface Subscription {
+  readonly clientId: string;
+  caches: ReadonlySet<string>;
+  activity: WorkspaceActivity;
+}
+
+function subscriptionKey(clientId: string, workspaceId: string): string {
+  return `${clientId}\u0000${workspaceId}`;
+}
+
+export class ResidencyManager implements ResidencyService {
+  private readonly options: ResidencyManagerOptions;
+  private readonly subscriptions = new Map<string, Subscription>();
+  private readonly reported = new Map<string, CacheResidency>();
+  private readonly touched = new Map<string, number>();
+  private readonly mountedBytes = new Map<string, number>();
+  private running: Promise<void> | null = null;
+  private rerun = false;
+  private scheduled = false;
+  private timer: ReturnType<typeof setInterval> | null = null;
+
+  constructor(options: ResidencyManagerOptions) {
+    this.options = options;
+  }
+
+  subscribe(clientId: string, workspaceId: string, caches: readonly string[], activity: WorkspaceActivity): void {
+    this.subscriptions.set(subscriptionKey(clientId, workspaceId), { clientId, caches: new Set(caches), activity });
+    this.scheduleEvaluation();
+  }
+
+  setActivity(clientId: string, workspaceId: string, activity: WorkspaceActivity): void {
+    const subscription = this.subscriptions.get(subscriptionKey(clientId, workspaceId));
+    if (!subscription || subscription.activity === activity) return;
+    subscription.activity = activity;
+    this.scheduleEvaluation();
+  }
+
+  unsubscribe(clientId: string, workspaceId: string): void {
+    if (this.subscriptions.delete(subscriptionKey(clientId, workspaceId))) this.scheduleEvaluation();
+  }
+
+  closeClient(clientId: string): void {
+    let removed = false;
+    for (const [key, subscription] of this.subscriptions) {
+      if (subscription.clientId !== clientId) continue;
+      this.subscriptions.delete(key);
+      removed = true;
+    }
+    if (removed) this.scheduleEvaluation();
+  }
+
+  forget(cache: string): void {
+    this.reported.delete(cache);
+    this.touched.delete(cache);
+    this.mountedBytes.delete(cache);
+  }
+
+  residency(cache: string): CacheResidency {
+    for (const candidate of this.options.host.candidates()) {
+      if (candidate.name === cache) return this.residencyOf(candidate.name, candidate.mounted);
+    }
+    return 'COLD';
+  }
+
+  consumers(cache: string): number {
+    let count = 0;
+    for (const subscription of this.subscriptions.values()) if (subscription.caches.has(cache)) count++;
+    return count;
+  }
+
+  wanted(cache: string): boolean {
+    for (const subscription of this.subscriptions.values()) if (subscription.caches.has(cache)) return true;
+    return false;
+  }
+
+  touch(cache: string): void {
+    this.touched.set(cache, this.options.now());
+  }
+
+  usedBytes(): number {
+    let used = 0;
+    for (const candidate of this.options.host.candidates()) if (candidate.mounted) used += candidate.memoryBytes;
+    return used;
+  }
+
+  evaluate(): Promise<void> {
+    if (this.running) {
+      this.rerun = true;
+      return this.running;
+    }
+    this.running = this.evaluateUntilSettled().finally(() => {
+      this.running = null;
+    });
+    return this.running;
+  }
+
+  start(): void {
+    if (this.timer !== null) return;
+    this.timer = setInterval(() => this.evaluateQuietly(), this.options.tickMs);
+  }
+
+  stop(): void {
+    if (this.timer === null) return;
+    clearInterval(this.timer);
+    this.timer = null;
+  }
+
+  private scheduleEvaluation(): void {
+    if (this.scheduled) return;
+    this.scheduled = true;
+    queueMicrotask(() => {
+      this.scheduled = false;
+      this.evaluateQuietly();
+    });
+  }
+
+  private evaluateQuietly(): void {
+    this.evaluate().catch(() => undefined);
+  }
+
+  private async evaluateUntilSettled(): Promise<void> {
+    do {
+      this.rerun = false;
+      await this.evaluateOnce();
+    } while (this.rerun);
+  }
+
+  private demand(): Map<string, WorkspaceActivity> {
+    const demand = new Map<string, WorkspaceActivity>();
+    for (const subscription of this.subscriptions.values()) {
+      for (const cache of subscription.caches) {
+        if (subscription.activity === 'ACTIVE' || !demand.has(cache)) demand.set(cache, subscription.activity);
+      }
+    }
+    return demand;
+  }
+
+  private residencyOf(cache: string, mounted: boolean): CacheResidency {
+    if (!mounted) return 'COLD';
+    for (const subscription of this.subscriptions.values()) {
+      if (subscription.activity === 'ACTIVE' && subscription.caches.has(cache)) return 'HOT';
+    }
+    return 'WARM';
+  }
+
+  private lastAccess(candidate: ResidencyCandidate): number {
+    return Math.max(candidate.lastAccessAt, this.touched.get(candidate.name) ?? 0);
+  }
+
+  private evictable(candidate: ResidencyCandidate, demand: Map<string, WorkspaceActivity>): boolean {
+    return candidate.mounted && !candidate.busy && !candidate.protected && candidate.evictionEnabled && demand.get(candidate.name) !== 'ACTIVE';
+  }
+
+  private async evaluateOnce(): Promise<void> {
+    const host = this.options.host;
+    const budget = this.options.budgetBytes;
+    const demand = this.demand();
+    let candidates = [...host.candidates()];
+    let used = this.usedBytes();
+    const toMount = candidates
+      .filter((candidate) => !candidate.mounted && demand.has(candidate.name))
+      .sort((a, b) => {
+        const activeA = demand.get(a.name) === 'ACTIVE' ? 0 : 1;
+        const activeB = demand.get(b.name) === 'ACTIVE' ? 0 : 1;
+        return activeA - activeB || b.priority - a.priority || this.lastAccess(b) - this.lastAccess(a);
+      });
+    for (const candidate of toMount) {
+      const active = demand.get(candidate.name) === 'ACTIVE';
+      if (!active && used + this.expectedBytes(candidate) > budget) continue;
+      if (await this.attempt(() => host.mount(candidate.name))) used += this.expectedBytes(candidate);
+      this.reportChanges();
+    }
+
+    const now = this.options.now();
+    const idleDemand = this.demand();
+    candidates = [...host.candidates()];
+    for (const candidate of candidates) {
+      if (!this.evictable(candidate, idleDemand) || idleDemand.has(candidate.name)) continue;
+      const timeout = candidate.idleTimeoutMs ?? this.options.defaultIdleTimeoutMs;
+      if (now - this.lastAccess(candidate) > timeout) await this.unmount(candidate);
+    }
+
+    candidates = [...host.candidates()];
+    used = this.usedBytes();
+    if (used > budget) {
+      const pressure = this.demand();
+      const victims = candidates
+        .filter((candidate) => this.evictable(candidate, pressure))
+        .sort((a, b) => {
+          const wantedA = pressure.has(a.name) ? 1 : 0;
+          const wantedB = pressure.has(b.name) ? 1 : 0;
+          if (wantedA !== wantedB) return wantedA - wantedB;
+          return (wantedA === 1 ? a.priority - b.priority : 0) || this.lastAccess(a) - this.lastAccess(b);
+        });
+      for (const victim of victims) {
+        if (used <= budget) break;
+        if (this.demand().get(victim.name) === 'ACTIVE') continue;
+        if (await this.unmount(victim)) used -= victim.memoryBytes;
+      }
+    }
+    this.reportChanges();
+  }
+
+  private expectedBytes(candidate: ResidencyCandidate): number {
+    return Math.max(candidate.memoryBytes, this.mountedBytes.get(candidate.name) ?? 0);
+  }
+
+  private async unmount(candidate: ResidencyCandidate): Promise<boolean> {
+    const done = await this.attempt(() => this.options.host.unmount(candidate.name));
+    if (done) this.mountedBytes.set(candidate.name, candidate.memoryBytes);
+    this.reportChanges();
+    return done;
+  }
+
+  private async attempt(operation: () => Promise<void>): Promise<boolean> {
+    try {
+      await operation();
+      return true;
+    } catch {
+      return false;
+    }
+  }
+
+  private reportChanges(): void {
+    const host = this.options.host;
+    for (const candidate of host.candidates()) {
+      const residency = this.residencyOf(candidate.name, candidate.mounted);
+      if ((this.reported.get(candidate.name) ?? 'COLD') === residency) continue;
+      this.reported.set(candidate.name, residency);
+      host.residencyChanged(candidate.name, residency);
+    }
+  }
+}
