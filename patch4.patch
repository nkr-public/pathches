+import type { TableEvent } from '@dec/data-engine';
+import type { CacheDefinition, CacheKey } from '../protocol/definition.ts';
+import type { CacheEvent, CacheEventType } from '../protocol/events.ts';
+import { CacheError } from '../protocol/messages.ts';
+import type { CacheEventBatch, CachePriority } from '../protocol/messages.ts';
+import { NO_CHANGES } from '../protocol/runtime.ts';
+import type {
+  CacheChangeSummary,
+  CacheMemoryStats,
+  CacheResidency,
+  CacheRow,
+  CacheRows,
+  CacheRuntime,
+  CacheSyncResult,
+  CacheUpdateAllResult,
+  CacheView,
+  WorkspaceActivity,
+} from '../protocol/runtime.ts';
+import { ClientRegistry } from './clients/ClientRegistry.ts';
+import type {
+  CacheServerOptions,
+  ClientService,
+  EventService,
+  LockManagerLike,
+  ResidencyCandidate,
+  ResidencyHost,
+  ResidencyService,
+  SelectionService,
+} from './contracts.ts';
+import { CacheEntry } from './entry/CacheEntry.ts';
+import { EventBus } from './events/EventBus.ts';
+import { LoadEngine } from './load/LoadEngine.ts';
+import { PersistenceEngine } from './persistence/PersistenceEngine.ts';
+import { CacheRegistry } from './registry/CacheRegistry.ts';
+import { ResidencyManager } from './residency/ResidencyManager.ts';
+import { TaskScheduler } from './scheduler/TaskScheduler.ts';
+import { SelectionManager } from './selection/SelectionManager.ts';
+import { SyncEngine } from './sync/SyncEngine.ts';
+
+const MAX_EVENT_KEYS = 1000;
+const PERSIST_DELAY_MS = 50;
+const VIEW_SWEEP_MS = 30000;
+
+const isAbort = (e: unknown): boolean => (e as { name?: string } | null)?.name === 'AbortError';
+
+const messageOf = (e: unknown): string => (e as Error | null)?.message ?? String(e);
+
+const abortError = (): Error => Object.assign(new Error('Aborted'), { name: 'AbortError' });
+
+const browserLocks = (): LockManagerLike | null =>
+  ((globalThis as { navigator?: { locks?: unknown } }).navigator?.locks as LockManagerLike | undefined) ?? null;
+
+export class CacheManager implements ResidencyHost {
+  private readonly now: () => number;
+  private readonly budgetBytes: number;
+  private readonly registry = new CacheRegistry();
+  private readonly scheduler = new TaskScheduler();
+  private readonly persistence: PersistenceEngine;
+  private readonly loader: LoadEngine;
+  private readonly syncer: SyncEngine;
+  private readonly selection: SelectionService;
+  private readonly residency: ResidencyService;
+  private readonly clients: ClientService;
+  private readonly events: EventService;
+  private readonly openClients = new Set<string>();
+  private readonly seenClients = new Set<string>();
+  private readonly follows = new Map<string, Map<string, readonly string[]>>();
+  private readonly sweeper: ReturnType<typeof setInterval>;
+  private persistedNames = new Set<string>();
+  private headers: Record<string, string> = {};
+  private helloChain: Promise<unknown> = Promise.resolve();
+
+  constructor(options: CacheServerOptions = {}) {
+    this.now = options.now ?? Date.now;
+    this.budgetBytes = options.budgetBytes ?? 512 * 1024 * 1024;
+    this.persistence = new PersistenceEngine(options.storageName ?? 'dec-cache');
+    this.loader = new LoadEngine({
+      persistence: this.persistence,
+      headers: () => this.headers,
+      now: this.now,
+      persistenceFailed: (entry, e) => this.persistenceFailed(entry, e),
+    });
+    this.syncer = new SyncEngine({ headers: () => this.headers });
+    this.selection = new SelectionManager({ now: this.now, viewTtlMs: 300000, sliceMs: 8 });
+    this.residency = new ResidencyManager({ host: this, budgetBytes: this.budgetBytes, tickMs: 15000, defaultIdleTimeoutMs: 300000, now: this.now });
+    this.clients = new ClientRegistry({ closed: (clientId) => this.clientClosed(clientId), locks: options.locks ?? browserLocks() });
+    this.events = new EventBus({ flushMs: 16, maxKeys: MAX_EVENT_KEYS });
+    this.sweeper = setInterval(() => this.selection.sweep(this.now()), VIEW_SWEEP_MS);
+    this.residency.start();
+  }
+
+  hasClient(clientId: string): boolean {
+    return this.openClients.has(clientId);
+  }
+
+  hello(clientId: string, scope: string, send: (message: CacheEventBatch) => void): Promise<boolean> {
+    const run = this.helloChain.then(() => this.bindClient(clientId, scope, send));
+    this.helloChain = run.catch(() => undefined);
+    return run;
+  }
+
+  bye(clientId: string): void {
+    this.clients.close(clientId);
+    this.clientClosed(clientId);
+  }
+
+  setCredentials(headers: Record<string, string>): void {
+    if (!headers || typeof headers !== 'object' || Object.values(headers).some((v) => typeof v !== 'string')) {
+      throw new CacheError('INVALID_REQUEST', 'credentials must be a map of string headers');
+    }
+    this.headers = { ...headers };
+  }
+
+  async register(definitions: CacheDefinition[]): Promise<void> {
+    this.registry.validate(definitions);
+    for (const definition of definitions) await this.registerOne(definition);
+  }
+
+  async unregister(name: string, discardChanges = false): Promise<void> {
+    const entry = this.registry.require(name);
+    if (!discardChanges) this.requireNoChanges(entry);
+    entry.abortAll();
+    await this.scheduler.write(name, 'INTERACTIVE', async () => {
+      if (!discardChanges) this.requireNoChanges(entry);
+      if (entry.mounted && !discardChanges && entry.unpersisted) await this.persistNow(entry);
+      entry.detach();
+      if (discardChanges && entry.persisted) await this.persistence.clear(name);
+    });
+    if (this.registry.get(name) !== entry) return;
+    this.registry.delete(name);
+    this.residency.forget(name);
+    this.selection.invalidate(name);
+    this.publish(entry, 'CACHE_UNREGISTERED');
+  }
+
+  subscribe(clientId: string, workspaceId: string, caches: string[], activity: WorkspaceActivity): void {
+    if (!Array.isArray(caches)) throw new CacheError('INVALID_REQUEST', 'caches must be an array');
+    for (const name of caches) this.registry.require(name);
+    this.residency.subscribe(clientId, workspaceId, caches, activity);
+    this.updateFollows(clientId, (workspaces) => workspaces.set(workspaceId, [...caches]));
+    for (const name of caches) this.touch(this.registry.require(name));
+    this.evaluateResidency();
+  }
+
+  setActivity(clientId: string, workspaceId: string, activity: WorkspaceActivity): void {
+    this.residency.setActivity(clientId, workspaceId, activity);
+    this.evaluateResidency();
+  }
+
+  unsubscribe(clientId: string, workspaceId: string): void {
+    this.residency.unsubscribe(clientId, workspaceId);
+    this.updateFollows(clientId, (workspaces) => workspaces.delete(workspaceId));
+    this.evaluateResidency();
+  }
+
+  watch(clientId: string, caches: string[] | null): void {
+    this.events.watch(clientId, caches);
+  }
+
+  select(clientId: string, cache: string, text: string, signal: AbortSignal, priority: CachePriority): Promise<CacheView> {
+    return this.using(cache, priority, (entry) => this.scheduler.read(cache, priority, () => this.selection.select(entry, clientId, String(text ?? ''), signal)));
+  }
+
+  rows(viewId: string, start: number, end: number): CacheRows {
+    return this.selection.rows(viewId, start, end);
+  }
+
+  closeView(viewId: string): void {
+    this.selection.closeView(viewId);
+  }
+
+  get(cache: string, keys: CacheKey[], columns: string[] | undefined, priority: CachePriority): Promise<(CacheRow | null)[]> {
+    if (!Array.isArray(keys)) throw new CacheError('INVALID_REQUEST', 'keys must be an array');
+    const entry = this.registry.require(cache);
+    for (const id of columns ?? []) {
+      if (!entry.definition.schema.columns.some((c) => c.id === id)) throw new CacheError('INVALID_REQUEST', `column "${id}" is not declared in cache "${cache}"`);
+    }
+    return this.using(cache, priority, (current) =>
+      this.scheduler.read(cache, priority, async () => {
+        const table = current.requireTable();
+        return keys.map((key) => {
+          const row = table.get(current.toPrimaryKey(key));
+          return row ? current.toCacheRow(row, columns) : null;
+        });
+      }),
+    );
+  }
+
+  insert(cache: string, row: CacheRow, priority: CachePriority): Promise<CacheKey> {
+    return this.mutate(cache, priority, (entry, table) => {
+      const normalized = entry.normalizeRow(row);
+      table.insert(normalized);
+      return entry.cacheKeyOf(normalized);
+    });
+  }
+
+  update(cache: string, key: CacheKey, patch: CacheRow, priority: CachePriority): Promise<void> {
+    return this.mutate(cache, priority, (entry, table) => {
+      table.update(entry.toPrimaryKey(key), entry.normalizePatch(patch));
+    });
+  }
+
+  delete(cache: string, key: CacheKey, priority: CachePriority): Promise<void> {
+    return this.mutate(cache, priority, (entry, table) => {
+      if (!table.delete(entry.toPrimaryKey(key))) throw new CacheError('NOT_FOUND', `row ${JSON.stringify(key)} does not exist in cache "${cache}"`);
+    });
+  }
