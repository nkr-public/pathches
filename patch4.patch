@@ -0,0 +1,150 @@
+import { useEffect, useState } from 'react';
+import { useT } from '@dec/i18n/react';
+import { RotateCcw } from 'lucide-react';
+import { Kbd, formatShortcut } from '@dec/ui';
+import { messages } from '../../i18n/index.ts';
+import {
+  findConflict,
+  isCustomized,
+  resetAllShortcuts,
+  resetShortcut,
+  setRecording,
+  setShortcut,
+  shortcutFromEvent,
+  useShortcuts,
+} from './store.ts';
+
+interface ShortcutAction {
+  id: string;
+  label: string;
+}
+
+type Problem =
+  | { kind: 'conflict'; keys: string; other: string }
+  | { kind: 'reserved' | 'modifier'; keys: string };
+
+const hasModifier = (keys: string) => keys.split('+').length > 1 && !/^shift\+[^+]+$/.test(keys);
+const isFunctionKey = (keys: string) => /(^|\+)f([1-9]|1[0-2])$/.test(keys);
+
+export function ShortcutEditor({ actions }: { actions: ShortcutAction[] }) {
+  const t = useT(messages);
+  const shortcuts = useShortcuts();
+  const [editing, setEditing] = useState<string | null>(null);
+  const [problem, setProblem] = useState<Problem | null>(null);
+  const labelOf = (id: string) => actions.find((a) => a.id === id)?.label ?? id;
+  const anyCustom = actions.some((a) => isCustomized(a.id));
+
+  useEffect(() => {
+    if (!editing) return;
+    setRecording(true);
+    const onKey = (e: KeyboardEvent) => {
+      e.preventDefault();
+      e.stopImmediatePropagation();
+      if (e.key === 'Escape' && !e.ctrlKey && !e.metaKey && !e.altKey && !e.shiftKey) {
+        setEditing(null);
+        setProblem(null);
+        return;
+      }
+      const keys = shortcutFromEvent(e);
+      if (!keys) return;
+      if (!hasModifier(keys) && !isFunctionKey(keys)) {
+        setProblem({ kind: 'modifier', keys });
+        return;
+      }
+      const conflict = findConflict(editing, keys);
+      if (conflict === 'reserved') {
+        setProblem({ kind: 'reserved', keys });
+        return;
+      }
+      if (conflict) {
+        setProblem({ kind: 'conflict', keys, other: conflict });
+        return;
+      }
+      setShortcut(editing, keys);
+      setEditing(null);
+      setProblem(null);
+    };
+    window.addEventListener('keydown', onKey, true);
+    return () => {
+      window.removeEventListener('keydown', onKey, true);
+      setRecording(false);
+    };
+  }, [editing]);
+
+  const swap = () => {
+    if (!editing || problem?.kind !== 'conflict') return;
+    const previous = shortcuts[editing] ?? '';
+    setShortcut(problem.other, previous);
+    setShortcut(editing, problem.keys);
+    setEditing(null);
+    setProblem(null);
+  };
+
+  return (
+    <>
+      <dl className="sp-shortcuts">
+        {actions.map((a) => {
+          const active = editing === a.id;
+          return (
+            <div key={a.id} className="sp-shortcut-block">
+              <div className="sp-shortcut">
+                <dt>{a.label}</dt>
+                <dd>
+                  {isCustomized(a.id) && !active && (
+                    <button
+                      type="button"
+                      className="sp-shortcut-reset"
+                      title={t('shell.settingsPanel.resetShortcut')}
+                      aria-label={t('shell.settingsPanel.resetShortcut')}
+                      onClick={() => resetShortcut(a.id)}
+                    >
+                      <RotateCcw size={12} />
+                    </button>
+                  )}
+                  <button
+                    type="button"
+                    className="sp-shortcut-key"
+                    data-recording={active || undefined}
+                    aria-label={t('shell.settingsPanel.editShortcut', { action: a.label })}
+                    onClick={() => {
+                      setProblem(null);
+                      setEditing(active ? null : a.id);
+                    }}
+                  >
+                    {active ? (
+                      <span className="sp-shortcut-recording">{t('shell.settingsPanel.recording')}</span>
+                    ) : (
+                      <Kbd size="sm">{formatShortcut(shortcuts[a.id] ?? '')}</Kbd>
+                    )}
+                  </button>
+                </dd>
+              </div>
+              {active && problem && (
+                <div className="sp-shortcut-problem" role="alert">
+                  <Kbd size="sm">{formatShortcut(problem.keys)}</Kbd>{' '}
+                  {problem.kind === 'conflict' ? (
+                    <>
+                      {t('shell.settingsPanel.conflict', { action: labelOf(problem.other) })}
+                      <button type="button" className="sp-shortcut-swap" onClick={swap}>
+                        {t('shell.settingsPanel.swap')}
+                      </button>
+                    </>
+                  ) : problem.kind === 'reserved' ? (
+                    t('shell.settingsPanel.reserved')
+                  ) : (
+                    t('shell.settingsPanel.needsModifier')
+                  )}
+                </div>
+              )}
+            </div>
+          );
+        })}
+      </dl>
+      {anyCustom && (
+        <button type="button" className="sp-shortcut-reset-all" onClick={resetAllShortcuts}>
+          <RotateCcw size={12} /> {t('shell.settingsPanel.resetAllShortcuts')}
+        </button>
+      )}
+    </>
+  );
+}
