+import { ARROW_STREAM, ApiRequestError, apiUrl } from '@dec/client-api';
+import type { DatasetPayload } from '@dec/client-api';
+import type { Schema } from '@dec/core';
+import type { ApiEndpoint } from '../../protocol/definition.ts';
+
+export type { DatasetPayload };
+
+export interface DatasetRequest {
+  cache: string;
+  schema: Schema;
+  headers: Record<string, string>;
+  signal: AbortSignal;
+}
+
+export interface DatasetAdapter {
+  fetch(endpoint: ApiEndpoint, request: DatasetRequest): Promise<DatasetPayload | 'NOT_CONFIGURED'>;
+}
+
+const rowsOf = (body: unknown, url: string): Record<string, unknown>[] => {
+  if (Array.isArray(body)) return body as Record<string, unknown>[];
+  const wrapped = body as { content?: unknown; data?: unknown; items?: unknown } | null;
+  for (const v of [wrapped?.content, wrapped?.data, wrapped?.items]) if (Array.isArray(v)) return v as Record<string, unknown>[];
+  throw new Error(`dataset "${url}" did not return an array of rows`);
+};
+
+const defaultAdapter: DatasetAdapter = {
+  async fetch(endpoint, { headers, signal }) {
+    const res = await fetch(apiUrl(endpoint.url), {
+      method: endpoint.method,
+      signal,
+      headers: { Accept: `${ARROW_STREAM}, application/json;q=0.9`, ...headers },
+    });
+    if (!res.ok) throw new ApiRequestError(res.status, res.statusText || `HTTP ${res.status}`);
+    if ((res.headers.get('content-type') ?? '').includes(ARROW_STREAM)) return { ipc: new Uint8Array(await res.arrayBuffer()) };
+    return { rows: rowsOf(await res.json(), endpoint.url) };
+  },
+};
+
+const noopAdapter: DatasetAdapter = {
+  fetch: async () => 'NOT_CONFIGURED',
+};
+
+const adapters = new Map<string, DatasetAdapter>([
+  ['default', defaultAdapter],
+  ['noop', noopAdapter],
+]);
+
+export function registerDatasetAdapter(name: string, adapter: DatasetAdapter): void {
+  adapters.set(name, adapter);
+}
+
+export function hasDatasetAdapter(name: string): boolean {
+  return adapters.has(name);
+}
+
+export function datasetAdapter(endpoint: ApiEndpoint | undefined): DatasetAdapter {
+  return (endpoint && adapters.get(endpoint.adapter ?? 'default')) || noopAdapter;
+}
