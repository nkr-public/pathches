+import { useCallback, useEffect, useRef, useState, useSyncExternalStore } from 'react';
+import { useT } from '@dec/i18n/react';
+import { History, RotateCcw } from 'lucide-react';
+import { Button, ConfirmDialog } from '@dec/ui';
+import {
+  storeWorkspacesOf,
+  subscribeStoreWorkspaces,
+  useActiveWorkspaceId,
+  type StoreRowChange,
+  type StoreWorkspace,
+  type WorkspaceDirtyState,
+} from '@dec/workspace';
+import { messages, type AppMessageKey } from '../../i18n/index.ts';
+import { SidePanelEmpty } from './SidePanel.tsx';
+
+const PAGE_SIZE = 50;
+
+interface DirtyWorkspace {
+  workspace: StoreWorkspace;
+  dirty: WorkspaceDirtyState;
+}
+
+const KIND_LABEL: Record<StoreRowChange['kind'], AppMessageKey> = {
+  INSERT: 'shell.historyPanel.kindCreated',
+  UPDATE: 'shell.historyPanel.kindUpdated',
+  DELETE: 'shell.historyPanel.kindDeleted',
+};
+
+const NONE: readonly DirtyWorkspace[] = [];
+
+function useHostDirtyWorkspaces(hostId: string | null): readonly DirtyWorkspace[] {
+  const cache = useRef<readonly DirtyWorkspace[]>(NONE);
+  const read = useCallback((): readonly DirtyWorkspace[] => {
+    const next = hostId ? storeWorkspacesOf(hostId).map((workspace) => ({ workspace, dirty: workspace.getDirtyState() })) : [];
+    const previous = cache.current;
+    const same = next.length === previous.length && next.every((n, i) => n.workspace === previous[i]!.workspace && n.dirty === previous[i]!.dirty);
+    if (!same) cache.current = next.length ? next : NONE;
+    return cache.current;
+  }, [hostId]);
+  const subscribe = useCallback(
+    (listener: () => void) => {
+      let stops: Array<() => void> = [];
+      const watch = () => {
+        stops.forEach((stop) => stop());
+        stops = hostId ? storeWorkspacesOf(hostId).map((w) => w.subscribeDirty(listener)) : [];
+        listener();
+      };
+      const stopList = subscribeStoreWorkspaces(watch);
+      watch();
+      return () => {
+        stopList();
+        stops.forEach((stop) => stop());
+      };
+    },
+    [hostId],
+  );
+  return useSyncExternalStore(subscribe, read, read);
+}
+
+export function useActiveHostIsDirty(): boolean {
+  return useHostDirtyWorkspaces(useActiveWorkspaceId()).some((w) => w.dirty.isDirty);
+}
+
+const formatKey = (key: unknown): string => (typeof key === 'object' ? JSON.stringify(key) : String(key));
+
+function StoreChanges({ workspace, store, version }: { workspace: StoreWorkspace; store: string; version: unknown }) {
+  const t = useT(messages);
+  const [page, setPage] = useState<{ total: number; changes: StoreRowChange[] } | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    workspace
+      .getStore(store as never)
+      .getChanges({ limit: PAGE_SIZE })
+      .then((result) => {
+        if (!cancelled) setPage(result as { total: number; changes: StoreRowChange[] });
+      })
+      .catch(() => {
+        if (!cancelled) setPage({ total: 0, changes: [] });
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [workspace, store, version]);
+
+  if (!page) return <p className="sp-muted">{t('shell.historyPanel.loading')}</p>;
+
+  return (
+    <>
+      <ul className="sp-changes">
+        {page.changes.map((change) => (
+          <li key={formatKey(change.key)} className="sp-change" data-error={change.error ? true : undefined}>
+            <span className="sp-change-kind" data-kind={change.kind}>{t(KIND_LABEL[change.kind])}</span>
+            <span className="sp-change-text">
+              <span className="sp-change-key">{formatKey(change.key)}</span>
+              {change.changedFields.length > 0 && <span className="sp-change-fields">{change.changedFields.join(', ')}</span>}
+              {change.error && <span className="sp-change-error">{change.error}</span>}
+            </span>
+            <button
+              type="button"
+              className="sp-icon-btn"
+              aria-label={`${t('shell.historyPanel.revert')} ${formatKey(change.key)}`}
+              title={t('shell.historyPanel.revert')}
+              onClick={() => void workspace.getStore(store as never).revert(change.key)}
+            >
+              <RotateCcw size={13} aria-hidden="true" />
+            </button>
+          </li>
+        ))}
+      </ul>
+      {page.total > page.changes.length && <p className="sp-muted">{t('shell.historyPanel.more', { count: page.total - page.changes.length })}</p>}
+    </>
+  );
+}
+
+export function HistoryPanel() {
+  const t = useT(messages);
+  const dirtyWorkspaces = useHostDirtyWorkspaces(useActiveWorkspaceId()).filter((w) => w.dirty.isDirty);
+
+  if (dirtyWorkspaces.length === 0) {
+    return <SidePanelEmpty icon={<History size={18} />} title={t('shell.historyPanel.empty')} hint={t('shell.historyPanel.emptyHint')} />;
+  }
+
+  return (
+    <>
+      {dirtyWorkspaces.flatMap(({ workspace, dirty }) =>
+        dirty.dirtyStores.map((store) => {
+          const state = dirty.stores[store]!;
+          return (
+            <section key={`${workspace.id}:${store}`} className="sp-section" aria-label={store}>
+              <h3 className="sp-section-title">{store}</h3>
+              <p className="sp-summary">
+                {t('shell.historyPanel.summary', { created: state.createdCount, updated: state.updatedCount, deleted: state.deletedCount })}
+              </p>
+              <StoreChanges workspace={workspace} store={store} version={state} />
+            </section>
+          );
+        }),
+      )}
+    </>
+  );
+}
+
+export function HistoryActions() {
+  const t = useT(messages);
+  const dirtyWorkspaces = useHostDirtyWorkspaces(useActiveWorkspaceId()).filter((w) => w.dirty.isDirty);
+  const [confirming, setConfirming] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const total = dirtyWorkspaces.reduce((sum, w) => sum + w.dirty.totalChanges, 0);
+
+  if (total === 0) return null;
+
+  const saveAll = async () => {
+    setSaving(true);
+    try {
+      for (const { workspace } of dirtyWorkspaces) await workspace.updateAll();
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const discardAll = async () => {
+    for (const { workspace, dirty } of dirtyWorkspaces) {
+      await Promise.all(dirty.dirtyStores.map((store) => workspace.getStore(store as never).revertAll()));
+    }
+  };
+
+  return (
+    <>
+      <Button size="sm" variant="ghost" onClick={() => setConfirming(true)} disabled={saving}>
+        {t('shell.historyPanel.discardAll')}
+      </Button>
+      <Button size="sm" variant="primary" onClick={() => void saveAll()} loading={saving}>
+        {t('shell.historyPanel.saveAll')}
+      </Button>
+      <ConfirmDialog
+        open={confirming}
+        onOpenChange={setConfirming}
+        tone="danger"
+        title={t('shell.historyPanel.confirmTitle', { count: total })}
+        description={t('shell.historyPanel.confirmDescription')}
+        confirmLabel={t('shell.historyPanel.confirmDiscard')}
+        cancelLabel={t('shell.historyPanel.cancel')}
+        onConfirm={discardAll}
+      />
+    </>
+  );
+}
