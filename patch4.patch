+import { toCacheError, type CacheClient, type CacheError, type CacheKey, type CacheRow, type CacheRows, type CacheView } from '@dec/cache';
+
+export interface CacheViewRow {
+  index: number;
+  key: CacheKey;
+  values: CacheRow;
+}
+
+export interface ViewWindowHandlers {
+  viewLost(): void;
+  failed(error: CacheError): void;
+}
+
+const MAX_PAGES = 32;
+
+function toViewRows(rows: CacheRows): CacheViewRow[] {
+  return rows.keys.map((key, offset) => {
+    const values: CacheRow = {};
+    const cells = rows.values[offset] ?? [];
+    rows.columns.forEach((column, position) => {
+      values[column] = cells[position];
+    });
+    return { index: rows.start + offset, key, values };
+  });
+}
+
+export class ViewWindowStore {
+  private view: CacheView | null = null;
+  private query = '';
+  private pages = new Map<number, CacheViewRow[]>();
+  private stalePages = new Map<number, CacheViewRow[]>();
+  private readonly loading = new Map<number, AbortController>();
+  private readonly listeners = new Set<() => void>();
+  private range: [number, number] = [0, 0];
+
+  constructor(
+    private readonly client: CacheClient,
+    private readonly pageSize: number,
+    private readonly handlers: ViewWindowHandlers,
+  ) {}
+
+  readonly subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  };
+
+  readonly rowAt = (index: number): CacheViewRow | undefined => {
+    const page = Math.floor(index / this.pageSize);
+    const offset = index % this.pageSize;
+    return this.pages.get(page)?.[offset] ?? this.stalePages.get(page)?.[offset];
+  };
+
+  readonly ensureRange = (start: number, end: number): void => {
+    this.range = [Math.max(0, start), Math.max(start, end)];
+    this.loadRange();
+  };
+
+  showView(view: CacheView, query: string): void {
+    const keepRows = query === this.query && this.view !== null;
+    const previous = this.view;
+    this.abortLoading();
+    this.stalePages = keepRows ? new Map([...this.stalePages, ...this.pages]) : new Map();
+    this.pages = new Map();
+    this.view = view;
+    this.query = query;
+    if (previous && previous.viewId !== view.viewId) this.client.closeView(previous.viewId);
+    this.notify();
+    this.loadRange();
+  }
+
+  detach(): void {
+    this.abortLoading();
+    if (this.view) this.client.closeView(this.view.viewId);
+    this.view = null;
+    this.query = '';
+    this.pages = new Map();
+    this.stalePages = new Map();
+  }
+
+  private loadRange(): void {
+    const view = this.view;
+    if (!view || !view.count) return;
+    const end = Math.min(this.range[1], view.count);
+    if (end <= this.range[0]) return;
+    const firstPage = Math.floor(this.range[0] / this.pageSize);
+    const lastPage = Math.floor((end - 1) / this.pageSize);
+    for (let page = firstPage; page <= lastPage; page++) {
+      if (!this.pages.has(page) && !this.loading.has(page)) this.loadPage(view, page);
+    }
+  }
+
+  private loadPage(view: CacheView, page: number): void {
+    const controller = new AbortController();
+    this.loading.set(page, controller);
+    const start = page * this.pageSize;
+    const end = Math.min(start + this.pageSize, view.count);
+    this.client.rows(view.viewId, start, end, controller.signal).then(
+      (rows) => {
+        if (this.view !== view) return;
+        this.loading.delete(page);
+        this.pages.set(page, toViewRows(rows));
+        this.stalePages.delete(page);
+        this.trimPages();
+        this.notify();
+      },
+      (reason: unknown) => {
+        if (this.view !== view || controller.signal.aborted) return;
+        this.loading.delete(page);
+        const error = toCacheError(reason);
+        if (error.code === 'ABORTED') return;
+        if (error.code === 'UNKNOWN_VIEW' || error.code === 'DISCONNECTED') this.handlers.viewLost();
+        else this.handlers.failed(error);
+      },
+    );
+  }
+
+  private trimPages(): void {
+    if (this.pages.size <= MAX_PAGES) return;
+    const center = (this.range[0] + this.range[1]) / 2 / this.pageSize;
+    const farthest = [...this.pages.keys()].sort((a, b) => Math.abs(b - center) - Math.abs(a - center));
+    for (const page of farthest.slice(0, this.pages.size - MAX_PAGES)) this.pages.delete(page);
+  }
+
+  private abortLoading(): void {
+    for (const controller of this.loading.values()) controller.abort();
+    this.loading.clear();
+  }
+
+  private notify(): void {
+    for (const listener of [...this.listeners]) listener();
+  }
+}
