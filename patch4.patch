+      rowCount: this.rowCount,
+      version: this.version,
+      memoryBytes,
+      persistedBytes: this.persistedBytes,
+      consumers,
+      unpersistedChanges: this.unpersistedChanges,
+      unsyncedChanges: this.unsyncedChanges,
