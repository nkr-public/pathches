+export interface CacheViewOptions {
+  debounceMs?: number;
+  pageSize?: number;
+}
+
+export interface CacheViewState {
+  view: CacheView | null;
+  count: number;
+  loading: boolean;
+  error: CacheError | null;
+  rowAt(index: number): CacheViewRow | undefined;
+  ensureRange(start: number, end: number): void;
+  subscribeRows(listener: () => void): () => void;
+}
+
+interface SelectionSnapshot {
+  view: CacheView | null;
+  loading: boolean;
+  error: CacheError | null;
+}
+
+function useDebouncedValue<T>(value: T, delayMs: number): T {
+  const [debounced, setDebounced] = useState(value);
+  useEffect(() => {
+    if (delayMs <= 0) {
+      setDebounced(value);
+      return;
+    }
+    const timer = setTimeout(() => setDebounced(value), delayMs);
+    return () => clearTimeout(timer);
+  }, [value, delayMs]);
+  return debounced;
+}
+
+export function useCacheView(cache: string, text: string, options: CacheViewOptions = {}): CacheViewState {
+  const { debounceMs = 150, pageSize = 100 } = options;
+  const client = useCacheClient();
+  const query = useDebouncedValue(text, debounceMs);
+  const [reselection, setReselection] = useState(0);
+  const [snapshot, setSnapshot] = useState<SelectionSnapshot>({ view: null, loading: true, error: null });
+  const viewRef = useRef<CacheView | null>(null);
+  viewRef.current = snapshot.view;
+
+  const reselect = useCallback(() => setReselection((current) => current + 1), []);
+  const store = useMemo(
+    () =>
+      new ViewWindowStore(client, pageSize, {
+        viewLost: reselect,
+        failed: (error) => setSnapshot((current) => ({ ...current, error })),
+      }),
+    [client, pageSize, reselect],
+  );
+
+  useEffect(() => () => store.detach(), [store]);
+
+  useEffect(() => {
+    const controller = new AbortController();
+    setSnapshot((current) => ({ ...current, loading: true, error: null }));
+    client.select(cache, query, controller.signal).then(
+      (view) => {
+        if (controller.signal.aborted) {
+          client.closeView(view.viewId);
+          return;
+        }
+        store.showView(view, JSON.stringify([cache, query]));
+        setSnapshot({ view, loading: false, error: null });
+      },
+      (error: unknown) => {
+        if (!controller.signal.aborted) setSnapshot((current) => ({ ...current, loading: false, error: toCacheError(error) }));
+      },
+    );
+    return () => controller.abort();
+  }, [client, store, cache, query, reselection]);
+
+  const connection = useCacheConnection();
+  const previousConnection = useRef(connection);
+  useEffect(() => {
+    const previous = previousConnection.current;
+    previousConnection.current = connection;
+    if (connection === 'CONNECTED' && previous === 'RECONNECTING') reselect();
+  }, [connection, reselect]);
+
+  useCacheEvents({ caches: [cache], types: ['CACHE_UPDATED', 'CACHE_LOADED', 'CACHE_REFRESHED', 'CACHE_SYNCED'] }, (events) => {
+    const current = viewRef.current;
+    if (current && events.some((event) => event.version > current.version)) reselect();
+  });
