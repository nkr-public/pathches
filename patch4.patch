+import { useEffect, useRef } from 'react';
+import type { CacheClient, WorkspaceActivity } from '@dec/cache';
+import { useOptionalCacheClient } from '@dec/cache-react';
+import { useWorkspaceLifecycle } from '../../react/hooks/useWorkspaceLifecycle.ts';
+import type { RefCache } from '../refCaches.ts';
+
+interface BindingProps {
+  workspaceId: string;
+  refCaches: readonly RefCache[];
+}
+
+function useRefCacheSubscription(client: CacheClient, workspaceId: string, refCaches: readonly RefCache[], activity: WorkspaceActivity): void {
+  const activityRef = useRef(activity);
+  activityRef.current = activity;
+  const subscribed = useRef(false);
+
+  useEffect(() => {
+    let cancelled = false;
+    const names = refCaches.map((c) => c.name);
+    subscribed.current = false;
+    void client
+      .register([...refCaches])
+      .then(() => {
+        if (cancelled) return;
+        subscribed.current = true;
+        return client.subscribe(workspaceId, names, activityRef.current);
+      })
+      .catch((error: unknown) => console.error(`ref caches of workspace "${workspaceId}" could not be registered`, error));
+    return () => {
+      cancelled = true;
+      if (subscribed.current) void client.unsubscribe(workspaceId).catch(() => undefined);
+      subscribed.current = false;
+    };
+  }, [client, workspaceId, refCaches]);
+
+  useEffect(() => {
+    if (subscribed.current) void client.setActivity(workspaceId, activity).catch(() => undefined);
+  }, [client, workspaceId, activity]);
+}
+
+function HostedRefCaches({ client, hostId, workspaceId, refCaches }: BindingProps & { client: CacheClient; hostId: string }) {
+  const { isActive } = useWorkspaceLifecycle(undefined, hostId);
+  useRefCacheSubscription(client, workspaceId, refCaches, isActive ? 'ACTIVE' : 'BACKGROUND');
+  return null;
+}
+
+function StandaloneRefCaches({ client, workspaceId, refCaches }: BindingProps & { client: CacheClient }) {
+  useRefCacheSubscription(client, workspaceId, refCaches, 'ACTIVE');
+  return null;
+}
+
+export function RefCacheBinding({ hostId, workspaceId, refCaches }: BindingProps & { hostId: string | null }) {
+  const client = useOptionalCacheClient();
+  if (!refCaches.length) return null;
+  if (!client) throw new Error(`@dec/workspace: workspace "${workspaceId}" declares ref caches but no <CacheProvider> is mounted`);
+  return hostId ? <HostedRefCaches client={client} hostId={hostId} workspaceId={workspaceId} refCaches={refCaches} /> : <StandaloneRefCaches client={client} workspaceId={workspaceId} refCaches={refCaches} />;
+}
