+import { useMemo, useSyncExternalStore } from 'react';
+import type { CacheClient, CacheRuntime } from '@dec/cache';
+import { useCacheClient } from '../CacheProvider.tsx';
+
+interface StatusStore {
+  subscribe(notify: () => void): () => void;
+  read(): CacheRuntime | null;
+}
+
+function createStatusStore(client: CacheClient, cache: string): StatusStore {
+  let runtime: CacheRuntime | null = null;
+  let receivedEvent = false;
+  return {
+    read: () => runtime,
+    subscribe(notify) {
+      let active = true;
+      const stop = client.on({ caches: [cache], types: ['CACHE_STATUS_CHANGED'] }, (events) => {
+        const latest = events.findLast((event) => event.runtime);
+        if (!latest?.runtime) return;
+        receivedEvent = true;
+        runtime = latest.runtime;
+        notify();
+      });
+      client.status(cache).then(
+        (current) => {
+          if (!active || receivedEvent) return;
+          runtime = current;
+          notify();
+        },
+        () => undefined,
+      );
+      return () => {
+        active = false;
+        stop();
+      };
+    },
+  };
+}
+
+export function useCacheStatus(cache: string): CacheRuntime | null {
+  const client = useCacheClient();
+  const store = useMemo(() => createStatusStore(client, cache), [client, cache]);
+  return useSyncExternalStore(store.subscribe, store.read, store.read);
+}
