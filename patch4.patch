+import { useEffect, useRef } from 'react';
+import type { WorkspaceActivity } from '@dec/cache';
+import { useCacheClient } from '../CacheProvider.tsx';
+
+export function useCacheSubscription(workspaceId: string, caches: string[], activity: WorkspaceActivity): void {
+  const client = useCacheClient();
+  const cachesRef = useRef(caches);
+  cachesRef.current = caches;
+  const activityRef = useRef(activity);
+  const sentActivityRef = useRef<WorkspaceActivity | null>(null);
+  activityRef.current = activity;
+  const cachesKey = JSON.stringify(caches);
+
+  useEffect(() => {
+    const subscribedActivity = activityRef.current;
+    sentActivityRef.current = subscribedActivity;
+    client.subscribe(workspaceId, cachesRef.current, subscribedActivity).catch(reportError);
+    return () => {
+      sentActivityRef.current = null;
+      client.unsubscribe(workspaceId).catch(reportError);
+    };
+  }, [client, workspaceId, cachesKey]);
+
+  useEffect(() => {
+    if (sentActivityRef.current === null || sentActivityRef.current === activity) return;
+    sentActivityRef.current = activity;
+    client.setActivity(workspaceId, activity).catch(reportError);
+  }, [client, workspaceId, activity]);
+}
