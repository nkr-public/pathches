+export type LoadMode = 'MOUNT' | 'REFRESH';
+
+export interface LoadResult {
+  source: 'CACHE' | 'NETWORK' | 'EMPTY';
+  revalidate: boolean;
+  error?: string;
+}
+
+export interface LoadEngineOptions {
+  persistence: PersistenceEngine;
+  headers: () => Record<string, string>;
+  now: () => number;
+  persistenceFailed: (entry: CacheEntry, error: unknown) => void;
+}
+
+export interface FetchedDataset {
+  payload: DatasetPayload;
+  url: string;
+}
+
+interface PendingLoad {
+  mode: LoadMode;
+  promise: Promise<void>;
+}
+
+const CHUNK_ROWS = 4096;
+
+const isAbort = (e: unknown): boolean => (e as { name?: string } | null)?.name === 'AbortError';
+
+const abortError = (): Error => Object.assign(new Error('Aborted'), { name: 'AbortError' });
+
+const networkError = (url: string, e: unknown): unknown => {
+  if (isAbort(e) || e instanceof CacheError) return e;
+  const status = e instanceof ApiRequestError ? ` (HTTP ${e.status})` : '';
+  return new CacheError('NETWORK', `loading "${url}" failed${status}: ${(e as Error | null)?.message ?? String(e)}`, { cause: e });
+};
+
+function* payloadChunks(payload: DatasetPayload, schema: Schema, url: string): Generator<Row[]> {
+  const columns = schema.columns;
+  if (payload.ipc) {
+    for (const batch of tableFromIPC(payload.ipc).batches) {
+      const vectors = columns.map((c) => batch.getChild(c.id));
+      for (let start = 0; start < batch.numRows; start += CHUNK_ROWS) {
+        const end = Math.min(batch.numRows, start + CHUNK_ROWS);
+        const rows: Row[] = [];
+        for (let r = start; r < end; r++) {
+          const row: Record<string, unknown> = {};
+          for (let c = 0; c < columns.length; c++) row[columns[c].id] = toEngineValue(columns[c], vectors[c]?.get(r));
+          rows.push(row as Row);
+        }
+        yield rows;
+      }
+    }
+    return;
+  }
+  if (!payload.rows) throw new CacheError('NETWORK', `api "${url}" returned no data`);
+  const ids = schema.ids;
+  for (let start = 0; start < payload.rows.length; start += CHUNK_ROWS) {
+    const rows: Row[] = [];
+    for (const raw of payload.rows.slice(start, start + CHUNK_ROWS)) {
+      if (raw === null || typeof raw !== 'object' || ids.some((id) => raw[id] === null || raw[id] === undefined)) {
+        throw new CacheError('VALIDATION', `api "${url}" returned a row without "${ids.join(', ')}"`);
+      }
+      const row: Record<string, unknown> = {};
+      for (const column of columns) row[column.id] = toEngineValue(column, raw[column.id]);
+      rows.push(row as Row);
+    }
+    yield rows;
+  }
+}
+
+export class LoadEngine {
+  private readonly options: LoadEngineOptions;
+  private readonly pending = new Map<string, PendingLoad>();
+
+  constructor(options: LoadEngineOptions) {
+    this.options = options;
+  }
+
+  share(cache: string, mode: LoadMode, start: () => Promise<void>): Promise<void> {
+    const pending = this.pending.get(cache);
+    if (pending && (pending.mode === mode || mode === 'MOUNT')) return pending.promise;
+    const previous = pending?.promise.catch(() => undefined) ?? Promise.resolve();
+    const next: PendingLoad = { mode, promise: previous.then(start) };
+    this.pending.set(cache, next);
+    const done = (): void => {
+      if (this.pending.get(cache) === next) this.pending.delete(cache);
+    };
+    next.promise.then(done, done);
+    return next.promise;
+  }
+
+  isPending(cache: string): boolean {
+    return this.pending.has(cache);
+  }
+
+  async mount(entry: CacheEntry, signal: AbortSignal): Promise<LoadResult> {
+    const { definition } = entry;
+    const { persistence, now } = this.options;
+    let table = entry.createTable(now);
+    let restored = false;
+    let damaged = false;
+    const store = definition.persistence.enabled ? await persistence.openStore(entry.name, (e) => this.options.persistenceFailed(entry, e)) : null;
+    if (store) {
+      try {
+        const info = await persistence.restore(entry.name, store, table);
+        restored = info !== null;
+        damaged = info !== null && (info.recovered || info.torn);
+      } catch (e) {
+        this.options.persistenceFailed(entry, e);
+        table.dispose();
+        await persistence.clear(entry.name).catch(() => undefined);
+        table = entry.createTable(now);
+        damaged = true;
+      }
+      store.attach(table);
+    }
+    if (signal.aborted) {
+      store?.detach();
+      table.dispose();
+      throw abortError();
+    }
+    entry.attach(table, store);
+    const marker = store ? await persistence.readMarker(entry.name) : null;
+    const endpoint = definition.api.load;
+    const fresh = !damaged && this.isFresh(entry, marker, endpoint?.url ?? null);
+    const cached: LoadResult = { source: restored ? 'CACHE' : 'EMPTY', revalidate: false };
+    if (damaged) return this.recover(entry, endpoint, signal, cached);
+    switch (definition.loading.strategy) {
+      case 'CACHE_ONLY':
+        return cached;
+      case 'CACHE_FIRST':
+        if (restored && fresh) return cached;
+        break;
+      case 'STALE_WHILE_REVALIDATE':
+        if (restored) return { ...cached, revalidate: !fresh };
+        break;
+      case 'NETWORK_FIRST':
+      case 'NETWORK_ONLY':
+        break;
+    }
+    try {
+      const payload = await this.fetchPayload(entry, endpoint, signal);
+      if (!payload) return cached;
+      await this.fill(entry, payload, signal);
+      return { source: 'NETWORK', revalidate: false };
+    } catch (e) {
+      if (isAbort(e) || !restored || definition.loading.strategy === 'NETWORK_ONLY') throw e;
+      return { ...cached, error: (e as Error).message };
+    }
+  }
+
+  private async recover(entry: CacheEntry, endpoint: ApiEndpoint | undefined, signal: AbortSignal, cached: LoadResult): Promise<LoadResult> {
+    try {
+      const payload = await this.fetchPayload(entry, endpoint, signal);
+      if (!payload) return { ...cached, error: `the local copy of cache "${entry.name}" was damaged and no load api is configured` };
+      await this.fill(entry, payload, signal);
+      return { source: 'NETWORK', revalidate: false };
+    } catch (e) {
+      if (isAbort(e) || cached.source === 'EMPTY') throw e;
+      return { ...cached, revalidate: true, error: (e as Error).message };
+    }
+  }
+
+  fetchRefresh(entry: CacheEntry, signal: AbortSignal): Promise<FetchedDataset | null> {
+    return this.fetchPayload(entry, entry.definition.api.refresh ?? entry.definition.api.load, signal);
+  }
+
+  async fill(entry: CacheEntry, dataset: FetchedDataset, signal: AbortSignal): Promise<void> {
+    const table = entry.requireTable();
+    const { payload, url } = dataset;
+    const maxRows = entry.definition.loading.maxRows;
+    const slice = createSlicer();
+    const schema = entry.definition.schema;
+    async function* chunks(): AsyncGenerator<Row[]> {
+      let total = 0;
+      for (const rows of payloadChunks(payload, schema, url)) {
+        total += rows.length;
+        if (maxRows !== undefined && total > maxRows) throw new CacheError('VALIDATION', `api "${url}" returned more than ${maxRows} rows for cache "${entry.name}"`);
+        yield rows;
+        await slice();
+      }
+    }
+    entry.quiet++;
+    try {
+      if (payload.ipc && maxRows === undefined) {
+        if (signal.aborted) throw abortError();
+        if (table.loadIpc(payload.ipc)) return;
+      }
+      await table.loadAsync(chunks(), { mode: 'replace', signal });
+    } finally {
+      entry.quiet--;
+    }
+  }
+
+  private async fetchPayload(entry: CacheEntry, endpoint: ApiEndpoint | undefined, signal: AbortSignal): Promise<FetchedDataset | null> {
+    if (!endpoint) return null;
+    let payload: DatasetPayload | 'NOT_CONFIGURED';
+    try {
+      payload = await datasetAdapter(endpoint).fetch(endpoint, { cache: entry.name, schema: entry.definition.schema, headers: this.options.headers(), signal });
+    } catch (e) {
+      throw networkError(endpoint.url, e);
+    }
+    if (signal.aborted) throw abortError();
+    return payload === 'NOT_CONFIGURED' ? null : { payload, url: endpoint.url };
+  }
+
+  private isFresh(entry: CacheEntry, marker: SyncMarker | null, url: string | null): boolean {
+    const { definition } = entry;
+    if (!marker || marker.syncedAt === null) return false;
+    if (marker.definitionVersion !== definition.version || marker.schemaVersion !== definition.schema.version || marker.url !== url) return false;
+    const ttl = definition.loading.ttlMs;
+    return ttl === undefined || this.options.now() - marker.syncedAt <= ttl;
+  }
+}
