+import type { CacheRows, CacheView } from '../../protocol/runtime.ts';
+import type { CacheHandle, SelectionManagerOptions, SelectionService } from '../contracts.ts';
+import { searchRows } from './ByteSearch.ts';
+import { foldNeedle } from './normalize.ts';
+import { buildSelectionIndex, selectionColumns } from './SelectionIndex.ts';
+import type { SelectionIndex } from './SelectionIndex.ts';
+import { abortedError, TimeSlicer } from './TimeSlicer.ts';
+
+const MAX_WINDOW = 500;
+const VIEW_OVERHEAD_BYTES = 128;
+
+interface IndexBuild {
+  readonly version: number;
+  readonly table: Table;
+  readonly controller: AbortController;
+  readonly promise: Promise<SelectionIndex>;
+  waiters: number;
+}
+
+interface CacheSelection {
+  index: SelectionIndex | null;
+  build: IndexBuild | null;
+  columns: string[];
+  ids: string[];
+}
+
+interface SelectionView {
+  readonly cache: string;
+  readonly clientId: string;
+  readonly positions: Uint32Array | null;
+  readonly indexId: number;
+  readonly count: number;
+  lastAccessAt: number;
+}
+
+export class SelectionManager implements SelectionService {
+  private readonly options: SelectionManagerOptions;
+  private readonly selections = new Map<string, CacheSelection>();
+  private readonly views = new Map<string, SelectionView>();
+  private nextIndexId = 0;
+  private nextViewId = 0;
+
+  constructor(options: SelectionManagerOptions) {
+    this.options = options;
+  }
+
+  async select(cache: CacheHandle, clientId: string, text: string, signal: AbortSignal): Promise<CacheView> {
+    if (cache.table === null) throw new CacheError('NOT_MOUNTED', `cache "${cache.name}" is not mounted`);
+    if (signal.aborted) throw abortedError();
+    const index = await this.currentIndex(cache, signal);
+    const needle = foldNeedle(text);
+    const positions = needle.length === 0 ? null : await searchRows(index, needle, new TimeSlicer(this.options.sliceMs, signal, this.options.now));
+    const count = positions === null ? index.size : positions.length;
+    const viewId = `${cache.name}:${(++this.nextViewId).toString(36)}`;
+    this.views.set(viewId, { cache: cache.name, clientId, positions, indexId: index.id, count, lastAccessAt: this.options.now() });
+    return { viewId, cache: cache.name, count, version: index.version };
+  }
+
+  rows(viewId: string, start: number, end: number): CacheRows {
+    const view = this.views.get(viewId);
+    const selection = view ? this.selections.get(view.cache) : undefined;
+    const index = selection?.index;
+    if (!view || !selection || !index || index.id !== view.indexId) throw new CacheError('UNKNOWN_VIEW', `view "${viewId}" is unknown or stale`);
+    view.lastAccessAt = this.options.now();
+    const from = Math.min(Math.max(0, Math.floor(start) || 0), view.count);
+    const to = Math.min(Math.max(from, Math.floor(end) || 0), view.count, from + MAX_WINDOW);
+    const length = to - from;
+    const keys = new Array<PrimaryKey>(length);
+    const positions = view.positions;
+    for (let i = 0; i < length; i++) keys[i] = index.keys[positions === null ? from + i : positions[from + i]];
+    const columns = selection.columns;
+    const columnValues = columns.map((column) => index.table.values(column, keys));
+    const values = new Array<unknown[]>(length);
+    for (let i = 0; i < length; i++) {
+      const row = new Array<unknown>(columns.length);
+      for (let c = 0; c < columns.length; c++) row[c] = columnValues[c][i];
+      values[i] = row;
+    }
+    return { viewId, start: from, columns, keys: this.cacheKeys(selection, index.table, keys, columnValues), values };
+  }
+
+  closeView(viewId: string): void {
+    this.views.delete(viewId);
+  }
+
+  closeClient(clientId: string): void {
+    for (const [viewId, view] of this.views) if (view.clientId === clientId) this.views.delete(viewId);
+  }
+
+  invalidate(cache: string): void {
+    this.selections.delete(cache);
+  }
+
+  memoryBytes(cache: string): number {
+    let bytes = this.selections.get(cache)?.index?.bytes ?? 0;
+    for (const view of this.views.values()) {
+      if (view.cache === cache) bytes += VIEW_OVERHEAD_BYTES + (view.positions?.buffer.byteLength ?? 0);
+    }
+    return bytes;
+  }
+
+  sweep(now: number): void {
+    const ttl = this.options.viewTtlMs;
+    for (const [viewId, view] of this.views) if (now - view.lastAccessAt > ttl) this.views.delete(viewId);
+  }
+
+  private async currentIndex(cache: CacheHandle, signal: AbortSignal): Promise<SelectionIndex> {
+    for (;;) {
+      const table = cache.table;
+      if (table === null) throw new CacheError('NOT_MOUNTED', `cache "${cache.name}" is not mounted`);
+      const selection = this.selectionOf(cache);
+      const index = selection.index;
+      if (index && index.version === cache.version && index.table === table) return index;
+      selection.index = null;
+      let build = selection.build;
+      if (!build || build.version !== cache.version || build.table !== table) build = this.startBuild(cache, table, selection);
+      const built = await this.waitForBuild(build, signal);
+      if (this.selections.get(cache.name)?.index === built && built.version === cache.version && built.table === cache.table) return built;
+    }
+  }
+
+  private selectionOf(cache: CacheHandle): CacheSelection {
+    let selection = this.selections.get(cache.name);
+    if (!selection) {
+      const columns = selectionColumns(cache.definition);
+      selection = { index: null, build: null, columns, ids: cache.definition.schema.ids };
+      this.selections.set(cache.name, selection);
+    }
+    return selection;
+  }
+
+  private startBuild(cache: CacheHandle, table: Table, selection: CacheSelection): IndexBuild {
+    const controller = new AbortController();
+    const slicer = new TimeSlicer(this.options.sliceMs, controller.signal, this.options.now);
+    const promise = buildSelectionIndex(++this.nextIndexId, cache.definition, cache.version, table, slicer).then(
+      (index) => {
+        if (selection.build === build) {
+          selection.build = null;
+          if (this.selections.get(cache.name) === selection) selection.index = index;
+        }
+        return index;
+      },
+      (error: unknown) => {
+        if (selection.build === build) selection.build = null;
+        throw error;
+      },
+    );
+    const build: IndexBuild = { version: cache.version, table, controller, promise, waiters: 0 };
+    promise.catch(() => undefined);
+    selection.build = build;
+    return build;
+  }
+
+  private waitForBuild(build: IndexBuild, signal: AbortSignal): Promise<SelectionIndex> {
+    build.waiters++;
+    return new Promise((resolve, reject) => {
+      let settled = false;
+      const release = (): boolean => {
+        if (settled) return false;
+        settled = true;
+        signal.removeEventListener('abort', abandon);
+        build.waiters--;
+        return true;
+      };
+      const abandon = (): void => {
+        if (!release()) return;
+        if (build.waiters === 0) build.controller.abort();
+        reject(abortedError());
+      };
+      signal.addEventListener('abort', abandon, { once: true });
+      build.promise.then(
+        (index) => {
+          if (release()) resolve(index);
+        },
+        (error: unknown) => {
+          if (release()) reject(error);
+        },
+      );
+    });
+  }
+
+  private cacheKeys(selection: CacheSelection, table: Table, keys: readonly PrimaryKey[], columnValues: Encodable[][]): CacheKey[] {
+    const ids = selection.ids;
+    const idValues = ids.map((id) => {
+      const c = selection.columns.indexOf(id);
+      return c >= 0 ? columnValues[c] : table.values(id, keys);
+    });
+    const out = new Array<CacheKey>(keys.length);
+    if (ids.length === 1) {
+      const single = idValues[0];
+      for (let i = 0; i < keys.length; i++) out[i] = single[i] as CacheKey;
+      return out;
+    }
+    const row: Record<string, unknown> = {};
+    for (let i = 0; i < keys.length; i++) {
+      for (let k = 0; k < ids.length; k++) row[ids[k]] = idValues[k][i];
+      out[i] = rowKey(ids, row);
+    }
+    return out;
+  }
+}
