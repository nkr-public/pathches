+import { useEffect, useMemo, useRef, useState } from 'react';
+import { toCacheError, type CacheError, type CacheEvent, type CacheKey, type CacheRow } from '@dec/cache';
+import { useCacheClient } from '../CacheProvider.tsx';
+import { useCacheEvents } from './useCacheEvents.ts';
+
+export interface CacheRowsState {
+  rows: ReadonlyMap<CacheKey, CacheRow | null>;
+  loading: boolean;
+  error: CacheError | null;
+}
+
+const EMPTY_ROWS: ReadonlyMap<CacheKey, CacheRow | null> = new Map();
+
+function touchesKeys(events: CacheEvent[], keys: ReadonlySet<CacheKey>): boolean {
+  return events.some((event) => event.reset || !event.keys || event.keys.some((key) => keys.has(key)));
+}
+
+export function useCacheRows(cache: string, keys: CacheKey[], columns?: string[]): CacheRowsState {
+  const client = useCacheClient();
+  const keysKey = JSON.stringify(keys);
+  const columnsKey = columns ? JSON.stringify(columns) : '';
+  const requestedKeys = useMemo(() => keys, [keysKey]);
+  const requestedColumns = useMemo(() => columns, [columnsKey]);
+  const keySet = useMemo(() => new Set(requestedKeys), [requestedKeys]);
+  const [revision, setRevision] = useState(0);
+  const [state, setState] = useState<CacheRowsState>({ rows: EMPTY_ROWS, loading: false, error: null });
+  const rowsRef = useRef(state.rows);
+  rowsRef.current = state.rows;
+
+  useEffect(() => {
+    if (!requestedKeys.length) {
+      setState({ rows: EMPTY_ROWS, loading: false, error: null });
+      return;
+    }
+    let active = true;
+    setState((current) => ({ ...current, loading: true }));
+    client.get(cache, requestedKeys, requestedColumns).then(
+      (found) => {
+        if (!active) return;
+        const rows = new Map<CacheKey, CacheRow | null>();
+        requestedKeys.forEach((key, index) => rows.set(key, found[index] ?? null));
+        setState({ rows, loading: false, error: null });
+      },
+      (error: unknown) => {
+        if (active) setState({ rows: rowsRef.current, loading: false, error: toCacheError(error) });
+      },
+    );
+    return () => {
+      active = false;
+    };
+  }, [client, cache, requestedKeys, requestedColumns, revision]);
+
+  useCacheEvents({ caches: [cache], types: ['CACHE_UPDATED', 'CACHE_LOADED', 'CACHE_REFRESHED', 'CACHE_SYNCED'] }, (events) => {
+    if (keySet.size && touchesKeys(events, keySet)) setRevision((current) => current + 1);
+  });
+
+  return state;
+}
