+import { useEffect, useRef } from 'react';
+import type { CacheEvent, CacheEventFilter } from '@dec/cache';
+import { useCacheClient } from '../CacheProvider.tsx';
+
+export function useCacheEvents(filter: CacheEventFilter, listener: (events: CacheEvent[]) => void): void {
+  const client = useCacheClient();
+  const listenerRef = useRef(listener);
+  listenerRef.current = listener;
+  const filterRef = useRef(filter);
+  filterRef.current = filter;
+  const filterKey = JSON.stringify([filter.caches ?? null, filter.types ?? null]);
