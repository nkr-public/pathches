+import { useEffect, useSyncExternalStore, type RefObject } from 'react';
+
+export interface OutlineSection {
+  id: string;
+  label: string;
+  target: RefObject<HTMLElement | null>;
+}
+
+const sectionsByWorkspace = new Map<string, readonly OutlineSection[]>();
+const listeners = new Set<() => void>();
+const NO_SECTIONS: readonly OutlineSection[] = [];
+
+const emit = (): void => {
+  for (const listener of [...listeners]) listener();
+};
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => void listeners.delete(listener);
+}
+
+export function useOutline(workspaceId: string | undefined, sections: readonly OutlineSection[]): void {
+  useEffect(() => {
+    if (!workspaceId) return;
+    sectionsByWorkspace.set(workspaceId, sections);
+    emit();
+    return () => {
+      if (sectionsByWorkspace.get(workspaceId) !== sections) return;
+      sectionsByWorkspace.delete(workspaceId);
+      emit();
+    };
+  }, [workspaceId, sections]);
+}
+
+export function useOutlineSections(workspaceId: string | null | undefined): readonly OutlineSection[] {
+  const read = () => (workspaceId ? sectionsByWorkspace.get(workspaceId) ?? NO_SECTIONS : NO_SECTIONS);
+  return useSyncExternalStore(subscribe, read, read);
+}
+
+export function revealSection(section: OutlineSection): void {
+  const element = section.target.current;
+  if (!element) return;
+  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+  element.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
+  if (!element.hasAttribute('tabindex')) element.setAttribute('tabindex', '-1');
+  element.focus({ preventScroll: true });
+}
