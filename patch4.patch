+import type { CacheEventBatch } from '../../protocol/messages.ts';
+import { CLIENT_LOCK_PREFIX } from '../../protocol/messages.ts';
+import type { ClientRegistryOptions, ClientService } from '../contracts.ts';
+
+export class ClientRegistry implements ClientService {
+  private readonly options: ClientRegistryOptions;
+  private readonly clients = new Map<string, (message: CacheEventBatch) => void>();
+  private readonly watched = new Set<string>();
+
+  constructor(options: ClientRegistryOptions) {
+    this.options = options;
+  }
+
+  open(clientId: string, send: (message: CacheEventBatch) => void): void {
+    this.clients.set(clientId, send);
+    const locks = this.options.locks;
+    if (!locks || this.watched.has(clientId)) return;
+    this.watched.add(clientId);
+    locks
+      .request(CLIENT_LOCK_PREFIX + clientId, { mode: 'exclusive' }, () => {
+        this.watched.delete(clientId);
+        this.close(clientId);
+      })
+      .catch(() => {
+        this.watched.delete(clientId);
+      });
+  }
+
+  close(clientId: string): void {
+    if (!this.clients.delete(clientId)) return;
+    this.options.closed(clientId);
+  }
+
+  has(clientId: string): boolean {
+    return this.clients.has(clientId);
+  }
+
+  count(): number {
+    return this.clients.size;
+  }
+}
