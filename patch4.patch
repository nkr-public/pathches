+import {
+  CacheError,
+  type CacheClientMessage,
+  type CacheCommand,
+  type CacheFailure,
+  type CachePayload,
+  type CachePriority,
+  type CacheRequest,
+  type CacheResponse,
+  type CacheResult,
+} from '../protocol/messages.ts';
+
+interface PendingRequest {
+  resolve(result: unknown): void;
+  reject(error: CacheError): void;
+  release(): void;
+}
+
+type Sender = (message: CacheClientMessage) => void;
+
+export class RpcChannel {
+  private nextId = 1;
+  private sender: Sender | null = null;
+  private readonly pending = new Map<number, PendingRequest>();
+
+  constructor(
+    private readonly clientId: string,
+    private readonly timeoutMs: number,
+  ) {}
+
+  attach(sender: Sender): void {
+    this.sender = sender;
+  }
+
+  detach(error: CacheError): void {
+    this.sender = null;
+    this.rejectAll(error);
+  }
+
+  request<C extends CacheCommand>(
+    command: C,
+    payload: CachePayload<C>,
+    priority: CachePriority,
+    signal?: AbortSignal,
+  ): Promise<CacheResult<C>> {
+    if (signal?.aborted) return Promise.reject(new CacheError('ABORTED', `${command} aborted`));
+    const sender = this.sender;
+    if (!sender) return Promise.reject(new CacheError('DISCONNECTED', `${command} sent while disconnected`));
+    const id = this.nextId++;
+    return new Promise<CacheResult<C>>((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.cancel(id);
+        this.take(id)?.reject(new CacheError('TIMEOUT', `${command} timed out after ${this.timeoutMs} ms`));
+      }, this.timeoutMs);
+      const abort = () => {
+        this.cancel(id);
+        this.take(id)?.reject(new CacheError('ABORTED', `${command} aborted`));
+      };
+      signal?.addEventListener('abort', abort, { once: true });
+      this.pending.set(id, {
+        resolve: resolve as (result: unknown) => void,
+        reject,
+        release: () => {
+          clearTimeout(timer);
+          signal?.removeEventListener('abort', abort);
+        },
+      });
+      try {
+        sender(this.buildRequest(id, command, payload, priority));
+      } catch (error) {
+        this.take(id)?.reject(new CacheError('DISCONNECTED', `${command} could not be sent`, { cause: error }));
+      }
+    });
+  }
+
+  notify<C extends CacheCommand>(command: C, payload: CachePayload<C>, priority: CachePriority): void {
+    try {
+      this.sender?.(this.buildRequest(this.nextId++, command, payload, priority));
+    } catch {
+      return;
+    }
+  }
+
+  receive(response: CacheResponse): void {
+    const request = this.take(response.id);
+    if (!request) return;
+    if (response.ok) request.resolve(response.result);
+    else request.reject(CacheError.from(response.error));
+  }
+
+  rejectAll(error: CacheError): void {
+    const requests = [...this.pending.values()];
+    this.pending.clear();
+    for (const request of requests) {
+      request.release();
+      request.reject(error);
+    }
+  }
+
+  private buildRequest<C extends CacheCommand>(
+    id: number,
+    command: C,
+    payload: CachePayload<C>,
+    priority: CachePriority,
+  ): CacheRequest {
+    return { type: 'req', id, clientId: this.clientId, command, payload, priority, timeoutMs: this.timeoutMs } as CacheRequest;
+  }
+
+  private cancel(id: number): void {
+    try {
+      this.sender?.({ type: 'cancel', id, clientId: this.clientId });
+    } catch {
+      return;
+    }
+  }
+
+  private take(id: number): PendingRequest | undefined {
+    const request = this.pending.get(id);
+    if (!request) return undefined;
+    this.pending.delete(id);
+    request.release();
+    return request;
+  }
+}
+
+export function toCacheError(error: unknown): CacheError {
+  if (error instanceof CacheError) return error;
+  if (isFailure(error)) return CacheError.from(error);
+  return new CacheError('INTERNAL', error instanceof Error ? error.message : String(error), { cause: error });
+}
+
+function isFailure(value: unknown): value is CacheFailure {
+  return typeof value === 'object' && value !== null && 'code' in value && 'message' in value;
+}
