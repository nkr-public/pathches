+  values(): IterableIterator<CacheEntry> {
+    return this.entries.values();
+  }
+
+  select(names?: readonly string[]): CacheEntry[] {
+    return names ? names.map((name) => this.require(name)) : [...this.entries.values()];
+  }
+
+  validate(definitions: readonly CacheDefinition[]): void {
+    if (!Array.isArray(definitions)) throw new CacheError('INVALID_REQUEST', 'definitions must be an array');
+    const names = new Set<string>();
+    for (const definition of definitions) {
+      validateDefinition(definition);
+      if (names.has(definition.name)) throw new CacheError('INVALID_DEFINITION', `cache "${definition.name}" is defined twice`);
+      names.add(definition.name);
+    }
+  }
+
+  compare(definition: CacheDefinition): RegistrationChange {
+    const existing = this.entries.get(definition.name)?.definition;
+    if (!existing) return 'NEW';
+    const same = existing.version === definition.version && existing.schema.version === definition.schema.version && existing.storage === definition.storage;
+    return same ? 'SAME' : 'CHANGED';
+  }
+
+  set(entry: CacheEntry): void {
+    this.entries.set(entry.name, entry);
+  }
+
+  delete(name: string): void {
+    this.entries.delete(name);
+  }
+}
