+import type { CacheDefinition, CacheEvictionPolicy, CacheLoadingPolicy, CacheSelectionPolicy, CacheStorage, CacheSyncPolicy } from '@dec/cache';
+import type { DatasetApi } from '@dec/client-api';
+
+export type RefCache = CacheDefinition;
+
+export interface RefCacheOptions {
+  name: string;
+  api: DatasetApi;
+  version?: number;
+  storage?: CacheStorage;
+  loading?: CacheLoadingPolicy;
+  persisted?: boolean;
+  eviction?: CacheEvictionPolicy;
+  sync?: CacheSyncPolicy;
+  selection?: Partial<CacheSelectionPolicy>;
+}
+
+export const REF_CACHE_DEFAULTS = {
+  loading: { strategy: 'CACHE_FIRST', ttlMs: 3_600_000 } satisfies CacheLoadingPolicy,
+  eviction: { enabled: true, idleTimeoutMs: 300_000 } satisfies CacheEvictionPolicy,
+  sync: { enabled: true, trigger: 'STARTUP' } satisfies CacheSyncPolicy,
+};
+
+export function defineRefCache(options: RefCacheOptions): RefCache {
+  const { api } = options;
+  const visible = api.schema.columns.filter((c) => !c.hidden).map((c) => c.id);
+  return {
+    name: options.name,
+    version: options.version ?? 1,
+    storage: options.storage ?? 'ARROW',
+    schema: api.schema,
+    api: { load: { url: api.url, method: 'GET' } },
+    loading: options.loading ?? REF_CACHE_DEFAULTS.loading,
+    persistence: { enabled: options.persisted ?? true },
+    eviction: options.eviction ?? REF_CACHE_DEFAULTS.eviction,
+    sync: options.sync ?? REF_CACHE_DEFAULTS.sync,
+    selection: {
+      columns: options.selection?.columns ?? api.mainColumns ?? visible,
+      ...(options.selection?.orderBy ? { orderBy: options.selection.orderBy } : {}),
+    },
+  };
+}
