@@ -0,0 +1,140 @@
+import { ApiRequestError } from '@dec/client-api';
+import { TableError, TableStoreError } from '@dec/data-engine';
+import { CacheError, PROTOCOL_VERSION } from '../protocol/messages.ts';
+import type { CacheCancel, CacheFailure, CacheRequest, CacheResponse } from '../protocol/messages.ts';
+import type { CacheManager } from './CacheManager.ts';
+import type { CachePort, CacheServer } from './contracts.ts';
+
+const toFailure = (e: unknown): CacheFailure => {
+  if (e instanceof CacheError) return e.toFailure();
+  const message = (e as Error | null)?.message ?? String(e);
+  if (e instanceof TableError) {
+    if (e.code === 'DUPLICATE_KEY' || e.code === 'NOT_FOUND') return { code: e.code, message };
+    if (e.code === 'DISPOSED') return { code: 'NOT_MOUNTED', message };
+    if (e.code === 'UNKNOWN_ENGINE') return { code: 'INTERNAL', message };
+    return { code: 'VALIDATION', message };
+  }
+  if (e instanceof TableStoreError) return { code: 'PERSISTENCE', message };
+  if (e instanceof ApiRequestError) return { code: 'NETWORK', message };
+  if ((e as { name?: string } | null)?.name === 'AbortError') return { code: 'ABORTED', message: 'request aborted' };
+  return { code: 'INTERNAL', message };
+};
+
+const isRequest = (data: unknown): data is CacheRequest | CacheCancel => {
+  const m = data as { type?: unknown; id?: unknown; clientId?: unknown } | null;
+  return !!m && (m.type === 'req' || m.type === 'cancel') && typeof m.id === 'number' && typeof m.clientId === 'string' && !!m.clientId;
+};
+
+export class WorkerCacheServer implements CacheServer {
+  private readonly manager: CacheManager;
+  private readonly running = new Map<string, AbortController>();
+
+  constructor(manager: CacheManager) {
+    this.manager = manager;
+  }
+
+  connect(port: CachePort): void {
+    port.onmessage = (event) => this.receive(port, event.data);
+    port.start?.();
+  }
+
+  dispose(): Promise<void> {
+    for (const ctrl of this.running.values()) ctrl.abort(new CacheError('DISCONNECTED', 'cache worker is shutting down'));
+    this.running.clear();
+    return this.manager.dispose();
+  }
+
+  private receive(port: CachePort, data: unknown): void {
+    if (!isRequest(data)) return;
+    const slot = `${data.clientId}:${data.id}`;
+    if (data.type === 'cancel') {
+      this.running.get(slot)?.abort(new CacheError('ABORTED', 'request cancelled'));
+      return;
+    }
+    const ctrl = new AbortController();
+    this.running.set(slot, ctrl);
+    const timer = data.timeoutMs && data.timeoutMs > 0 ? setTimeout(() => ctrl.abort(new CacheError('TIMEOUT', `${data.command} timed out after ${data.timeoutMs} ms`)), data.timeoutMs) : null;
+    const reply = (response: CacheResponse): void => {
+      if (timer) clearTimeout(timer);
+      if (this.running.get(slot) === ctrl) this.running.delete(slot);
+      port.postMessage(response);
+    };
+    const aborted = new Promise<never>((_, reject) => {
+      const fail = (): void => reject(ctrl.signal.reason instanceof CacheError ? ctrl.signal.reason : new CacheError('ABORTED', 'request aborted'));
+      if (ctrl.signal.aborted) fail();
+      else ctrl.signal.addEventListener('abort', fail, { once: true });
+    });
+    aborted.catch(() => undefined);
+    Promise.race([Promise.resolve().then(() => this.execute(port, data, ctrl.signal)), aborted]).then(
+      (result) => reply({ type: 'res', id: data.id, ok: true, result }),
+      (e) => reply({ type: 'res', id: data.id, ok: false, error: toFailure(e) }),
+    );
+  }
+
+  private execute(port: CachePort, request: CacheRequest, signal: AbortSignal): unknown {
+    const { clientId, priority } = request;
+    const m = this.manager;
+    if (request.command === 'HELLO') {
+      const { protocol, scope } = request.payload;
+      if (protocol !== PROTOCOL_VERSION) throw new CacheError('PROTOCOL', `protocol ${String(protocol)} is not supported, expected ${PROTOCOL_VERSION}`);
+      return m.hello(clientId, scope, (batch) => port.postMessage(batch)).then((restarted) => ({ protocol: PROTOCOL_VERSION, restarted }));
+    }
+    if (!m.hasClient(clientId)) throw new CacheError('PROTOCOL', `client "${clientId}" must send HELLO first`);
+    switch (request.command) {
+      case 'BYE':
+        return m.bye(clientId);
+      case 'SET_CREDENTIALS':
+        return m.setCredentials(request.payload.headers);
+      case 'REGISTER':
+        return m.register(request.payload.definitions);
+      case 'UNREGISTER':
+        return m.unregister(request.payload.name, request.payload.discardChanges);
+      case 'SUBSCRIBE':
+        return m.subscribe(clientId, request.payload.workspaceId, request.payload.caches, request.payload.activity);
+      case 'SET_ACTIVITY':
+        return m.setActivity(clientId, request.payload.workspaceId, request.payload.activity);
+      case 'UNSUBSCRIBE':
+        return m.unsubscribe(clientId, request.payload.workspaceId);
+      case 'WATCH':
+        return m.watch(clientId, request.payload.caches);
+      case 'SELECT':
+        return m.select(clientId, request.payload.cache, request.payload.text, signal, priority);
+      case 'ROWS':
+        return m.rows(request.payload.viewId, request.payload.start, request.payload.end);
+      case 'CLOSE_VIEW':
+        return m.closeView(request.payload.viewId);
+      case 'GET':
+        return m.get(request.payload.cache, request.payload.keys, request.payload.columns, priority);
+      case 'INSERT':
+        return m.insert(request.payload.cache, request.payload.row, priority);
+      case 'UPDATE':
+        return m.update(request.payload.cache, request.payload.key, request.payload.patch, priority);
+      case 'DELETE':
+        return m.delete(request.payload.cache, request.payload.key, priority);
+      case 'REVERT':
+        return m.revert(request.payload.cache, request.payload.keys, priority);
+      case 'REFRESH':
+        return m.refresh(request.payload.cache, priority);
+      case 'SYNC':
+        return m.sync(request.payload.caches, priority);
+      case 'CHANGE_SUMMARY':
+        return m.changeSummary(request.payload.caches);
+      case 'UPDATE_ALL':
+        return m.updateAll(request.payload.caches, priority);
+      case 'PERSIST':
+        return m.persist(request.payload.cache, priority);
+      case 'EVICT':
+        return m.evict(request.payload.cache);
+      case 'CLEAR':
+        return m.clear(request.payload.cache, request.payload.discardChanges);
+      case 'STATUS':
+        return m.status(request.payload.cache);
+      case 'LIST':
+        return m.list();
+      case 'MEMORY':
+        return m.memory();
+      default:
+        throw new CacheError('INVALID_REQUEST', `unknown command "${String((request as { command?: unknown }).command)}"`);
+    }
+  }
+}
