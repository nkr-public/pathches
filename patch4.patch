+import { useCallback, useEffect, useMemo, useState } from 'react';
+import type { CacheChangeSummary, CacheUpdateAllResult } from '@dec/cache';
+import { useCacheClient } from '../CacheProvider.tsx';
+import { useCacheEvents } from './useCacheEvents.ts';
+
+export interface UpdateAllState {
+  summary: Record<string, CacheChangeSummary> | null;
+  refreshSummary(): Promise<Record<string, CacheChangeSummary>>;
+  run(): Promise<CacheUpdateAllResult[]>;
+  running: boolean;
+  results: CacheUpdateAllResult[] | null;
+}
+
+export function useUpdateAll(caches?: string[]): UpdateAllState {
+  const client = useCacheClient();
+  const cachesKey = caches ? JSON.stringify(caches) : '';
+  const targets = useMemo(() => caches, [cachesKey]);
+  const [summary, setSummary] = useState<Record<string, CacheChangeSummary> | null>(null);
+  const [running, setRunning] = useState(false);
+  const [results, setResults] = useState<CacheUpdateAllResult[] | null>(null);
+
+  const refreshSummary = useCallback(async () => {
+    const next = await client.changeSummary(targets);
+    setSummary(next);
+    return next;
+  }, [client, targets]);
+
+  const run = useCallback(async () => {
+    setRunning(true);
+    try {
+      const outcome = await client.updateAll(targets);
+      setResults(outcome);
+      await refreshSummary();
+      return outcome;
+    } finally {
+      setRunning(false);
+    }
+  }, [client, targets, refreshSummary]);
+
+  useEffect(() => {
+    refreshSummary().catch(reportError);
+  }, [refreshSummary]);
+
+  useCacheEvents({ caches: targets, types: ['CACHE_UPDATED', 'CACHE_SYNCED', 'CACHE_REFRESHED'] }, () => {
+    refreshSummary().catch(reportError);
+  });
+
+  return { summary, refreshSummary, run, running, results };
+}
