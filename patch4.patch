+import type { ApiEndpoint, CacheDefinition } from '../../protocol/definition.ts';
+import { CacheError } from '../../protocol/messages.ts';
+import { hasDatasetAdapter } from '../load/adapters.ts';
+import { hasSyncAdapter } from '../sync/adapters.ts';
+
+const STRATEGIES = ['CACHE_FIRST', 'NETWORK_FIRST', 'CACHE_ONLY', 'NETWORK_ONLY', 'STALE_WHILE_REVALIDATE'];
+const METHODS = ['GET', 'POST', 'PUT', 'PATCH'];
+const COLUMN_TYPES = ['string', 'int', 'float', 'bool', 'date', 'timestamp', 'bigint', 'decimal'];
+
+const isPositive = (value: unknown): boolean => value === undefined || (typeof value === 'number' && Number.isFinite(value) && value > 0);
+
+const isVersion = (value: unknown): boolean => typeof value === 'number' && Number.isInteger(value) && value >= 0;
+
+export function validateDefinition(definition: CacheDefinition): void {
+  const name = typeof definition?.name === 'string' ? definition.name : '';
+  const fail = (message: string): never => {
+    throw new CacheError('INVALID_DEFINITION', `cache "${name}": ${message}`);
+  };
+  if (!/^[A-Za-z0-9._-]{1,64}$/.test(name)) fail('name must be 1-64 characters among letters, digits, ".", "_" and "-"');
+  if (!isVersion(definition.version)) fail('version must be a non-negative integer');
+  if (definition.storage !== 'ARROW' && definition.storage !== 'OBJECT') fail('storage must be ARROW or OBJECT');
+  const schema = definition.schema;
+  if (!schema || !Array.isArray(schema.columns) || !schema.columns.length) fail('schema needs columns');
+  if (!isVersion(schema.version)) fail('schema.version must be a non-negative integer');
+  const columns = new Set<string>();
+  for (const column of schema.columns) {
+    if (typeof column?.id !== 'string' || !column.id) fail('every column needs an id');
+    if (columns.has(column.id)) fail(`column "${column.id}" is declared twice`);
+    if (!COLUMN_TYPES.includes(column.type)) fail(`column "${column.id}" has an unknown type "${String(column.type)}"`);
+    columns.add(column.id);
+  }
+  const known = (id: string, where: string): void => {
+    if (!columns.has(id)) fail(`${where} "${id}" is not a declared column`);
+  };
+  if (!Array.isArray(schema.ids) || !schema.ids.length) fail('schema.ids must name at least one key column');
