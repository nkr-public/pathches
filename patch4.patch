+import type { CacheKey } from '../../protocol/definition.ts';
+import type { CacheEvent } from '../../protocol/events.ts';
+import type { CacheEventBatch } from '../../protocol/messages.ts';
+import type { EventBusOptions, EventService } from '../contracts.ts';
+
+interface EventClient {
+  readonly send: (message: CacheEventBatch) => void;
+  watched: ReadonlySet<string> | null;
+  readonly followed: Map<string, number>;
+}
+
+interface PendingUpdate {
+  slot: number;
+  keys: Set<CacheKey> | null;
+}
+
+export class EventBus implements EventService {
+  private readonly options: EventBusOptions;
+  private readonly clients = new Map<string, EventClient>();
+  private queue: (CacheEvent | null)[] = [];
+  private readonly updates = new Map<string, PendingUpdate>();
+  private readonly statuses = new Map<string, number>();
+  private timer: ReturnType<typeof setTimeout> | null = null;
+
+  constructor(options: EventBusOptions) {
+    this.options = options;
+  }
+
+  publish(event: CacheEvent): void {
+    if (event.type === 'CACHE_UPDATED') this.queueUpdate(event);
+    else if (event.type === 'CACHE_STATUS_CHANGED') this.queueStatus(event);
+    else this.queue.push(event);
+    if (this.timer === null) this.timer = setTimeout(() => this.flush(), this.options.flushMs);
+  }
+
+  addClient(clientId: string, send: (message: CacheEventBatch) => void): void {
+    const existing = this.clients.get(clientId);
+    this.clients.set(clientId, { send, watched: existing?.watched ?? new Set(), followed: existing?.followed ?? new Map() });
+  }
+
+  removeClient(clientId: string): void {
+    this.clients.delete(clientId);
+  }
+
+  watch(clientId: string, caches: readonly string[] | null): void {
+    const client = this.clients.get(clientId);
+    if (client) client.watched = caches === null ? null : new Set(caches);
+  }
+
+  follow(clientId: string, caches: readonly string[]): void {
+    const client = this.clients.get(clientId);
+    if (!client) return;
+    for (const cache of caches) client.followed.set(cache, (client.followed.get(cache) ?? 0) + 1);
+  }
+
+  unfollow(clientId: string, caches: readonly string[]): void {
+    const client = this.clients.get(clientId);
+    if (!client) return;
+    for (const cache of caches) {
+      const count = client.followed.get(cache) ?? 0;
+      if (count <= 1) client.followed.delete(cache);
+      else client.followed.set(cache, count - 1);
+    }
+  }
+
+  flush(): void {
+    if (this.timer !== null) {
+      clearTimeout(this.timer);
+      this.timer = null;
+    }
+    const events = this.drain();
+    if (events.length === 0) return;
+    for (const client of this.clients.values()) {
+      const delivered = events.filter((event) => this.receives(client, event.cache));
+      if (delivered.length === 0) continue;
+      try {
+        client.send({ type: 'events', events: delivered });
+      } catch (error) {
+        console.error('[@dec/cache] event delivery failed', error);
+      }
+    }
+  }
+
+  private receives(client: EventClient, cache: string): boolean {
+    return client.watched === null || client.watched.has(cache) || client.followed.has(cache);
+  }
+
+  private drain(): CacheEvent[] {
+    const events: CacheEvent[] = [];
+    for (const pending of this.updates.values()) {
+      const event = this.queue[pending.slot];
+      if (event && pending.keys !== null) event.keys = [...pending.keys];
+    }
+    for (const event of this.queue) if (event !== null) events.push(event);
+    this.queue = [];
+    this.updates.clear();
+    this.statuses.clear();
+    return events;
+  }
+
+  private queueStatus(event: CacheEvent): void {
+    const previous = this.statuses.get(event.cache);
+    if (previous !== undefined) this.queue[previous] = null;
+    this.statuses.set(event.cache, this.queue.length);
+    this.queue.push(event);
+  }
+
+  private queueUpdate(event: CacheEvent): void {
+    const pending = this.updates.get(event.cache);
+    const incoming = event.reset || !event.keys ? null : event.keys;
+    let keys: Set<CacheKey> | null;
+    if (!pending) {
+      keys = incoming && incoming.length <= this.options.maxKeys ? new Set(incoming) : null;
+    } else {
+      this.queue[pending.slot] = null;
+      keys = pending.keys;
+      if (keys !== null && incoming !== null) {
+        for (const key of incoming) keys.add(key);
+        if (keys.size > this.options.maxKeys) keys = null;
+      } else {
+        keys = null;
+      }
+    }
+    const merged: CacheEvent = { ...event };
+    delete merged.keys;
+    if (keys === null) merged.reset = true;
+    else delete merged.reset;
+    this.updates.set(event.cache, { slot: this.queue.length, keys });
+    this.queue.push(merged);
+  }
