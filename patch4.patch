+import { useId, useMemo, useRef, useState, type KeyboardEvent } from 'react';
+import { ChevronsUpDown, X } from 'lucide-react';
+import { useT } from '@dec/i18n/react';
+import { Badge, Floating, SearchInput, cn } from '@dec/ui';
+import type { CacheKey, CacheRow } from '@dec/cache';
+import { messages } from '../i18n/index.ts';
+import { useCacheRows } from '../hooks/useCacheRows.ts';
+import { SelectionTable, type SelectionColumn, type SelectionTableHandle } from './SelectionTable.tsx';
+
+export interface CacheSelectProps {
+  cache: string;
+  columns: SelectionColumn[];
+  labelColumn?: string;
+  formatLabel?(row: CacheRow): string;
+  value: CacheKey[];
+  onChange(keys: CacheKey[]): void;
+  multiple?: boolean;
+  placeholder?: string;
+  disabled?: boolean;
+  popoverHeight?: number;
+  className?: string;
+  'aria-label'?: string;
+}
+
+const DEFAULT_COLUMN_WIDTH = 160;
+const CHECKBOX_COLUMN_WIDTH = 36;
+
+export function CacheSelect({
+  cache,
+  columns,
+  labelColumn,
+  formatLabel,
+  value,
+  onChange,
+  multiple = false,
+  placeholder,
+  disabled = false,
+  popoverHeight = 320,
+  className,
+  'aria-label': ariaLabel,
+}: CacheSelectProps) {
+  const t = useT(messages);
+  const tableId = useId();
+  const fieldRef = useRef<HTMLDivElement | null>(null);
+  const panelRef = useRef<HTMLDivElement | null>(null);
+  const tableRef = useRef<SelectionTableHandle | null>(null);
+  const [open, setOpen] = useState(false);
+  const [text, setText] = useState('');
+  const labelColumns = useMemo(() => (formatLabel || !labelColumn ? undefined : [labelColumn]), [formatLabel, labelColumn]);
+  const { rows } = useCacheRows(cache, value, labelColumns);
+  const panelWidth = columns.reduce(
+    (total, column) => total + (column.width ?? DEFAULT_COLUMN_WIDTH),
+    multiple ? CHECKBOX_COLUMN_WIDTH : 0,
+  );
+
+  const labelOf = (key: CacheKey): string => {
+    const row = rows.get(key);
+    if (!row) return String(key);
+    if (formatLabel) return formatLabel(row);
+    const label = labelColumn ? row[labelColumn] : undefined;
+    return label === null || label === undefined ? String(key) : String(label);
+  };
+
+  const openPanel = () => {
+    if (!disabled) setOpen(true);
+  };
+
+  const close = () => {
+    const focusInside = panelRef.current?.contains(document.activeElement) ?? false;
+    setOpen(false);
+    setText('');
+    if (focusInside) fieldRef.current?.focus({ preventScroll: true });
+  };
+
+  const remove = (key: CacheKey) => onChange(value.filter((selected) => selected !== key));
+
+  const handleTableChange = (keys: CacheKey[]) => {
+    onChange(keys);
+    if (!multiple) close();
+  };
+
+  const handleFieldKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
+    if (disabled) return;
+    if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
+      event.preventDefault();
+      openPanel();
+    } else if (event.key === 'Backspace' && multiple && value.length) {
+      event.preventDefault();
+      remove(value[value.length - 1]);
+    }
+  };
+
+  const handleSearchKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === 'Tab') {
+      close();
+      return;
+    }
+    tableRef.current?.handleKeyDown(event);
+  };
+
+  return (
+    <>
+      <div
+        ref={fieldRef}
+        role="combobox"
+        tabIndex={disabled ? -1 : 0}
+        aria-label={ariaLabel}
+        aria-haspopup="dialog"
+        aria-expanded={open}
+        aria-controls={open ? tableId : undefined}
+        aria-disabled={disabled || undefined}
+        onClick={() => (open ? close() : openPanel())}
+        onKeyDown={handleFieldKeyDown}
+        className={cn(
+          'relative flex min-h-8 w-full min-w-0 flex-wrap items-center gap-1 rounded-ui-sm border border-default bg-input py-[3px] pl-2 pr-7 text-left text-[13px] text-primary outline-none transition-colors duration-120',
+          disabled
+            ? 'cursor-not-allowed opacity-50'
+            : 'hover:border-strong focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-focus aria-expanded:border-accent',
+          className,
+        )}
+      >
+        {value.length === 0 ? (
+          <span className="flex-1 truncate text-muted">{placeholder ?? t('select.placeholder')}</span>
+        ) : multiple ? (
+          value.map((key) => {
+            const label = labelOf(key);
+            return (
+              <Badge key={key} variant="neutral" size="lg" className="max-w-48 pr-0.5">
+                <span className="truncate">{label}</span>
+                {!disabled && (
+                  <button
+                    type="button"
+                    tabIndex={-1}
+                    aria-label={t('select.remove', { label })}
+                    onMouseDown={(event) => event.preventDefault()}
+                    onClick={(event) => {
+                      event.stopPropagation();
+                      remove(key);
+                    }}
+                    className="flex size-4 items-center justify-center rounded-[4px] text-muted hover:bg-hover hover:text-primary"
+                  >
+                    <X className="size-3" />
+                  </button>
+                )}
+              </Badge>
+            );
+          })
+        ) : (
+          <span className="flex-1 truncate">{labelOf(value[0])}</span>
+        )}
+        <ChevronsUpDown className="pointer-events-none absolute right-2 top-1/2 size-3.5 -translate-y-1/2 text-muted" />
+      </div>
+      <Floating
+        open={open}
+        anchorRef={fieldRef}
+        floatingRef={panelRef}
+        placement="bottom-start"
+        matchWidth
+        onDismiss={close}
+        role="dialog"
+        aria-label={ariaLabel}
+        className="flex flex-col overflow-hidden"
+        style={{ width: `min(${panelWidth}px, calc(100vw - 16px))` }}
+      >
+        <div className="border-b border-subtle p-1.5">
+          <SearchInput
+            autoFocus
+            data-autofocus
+            size="sm"
+            value={text}
+            placeholder={t('select.search')}
+            aria-controls={tableId}
+            onChange={(event) => setText(event.target.value)}
+            onKeyDown={handleSearchKeyDown}
+          />
+        </div>
+        <SelectionTable
+          ref={tableRef}
+          id={tableId}
+          cache={cache}
+          columns={columns}
+          text={text}
+          value={value}
+          onChange={handleTableChange}
+          multiple={multiple}
+          height={popoverHeight}
+          aria-label={ariaLabel ?? t('select.results')}
+        />
+      </Floating>
+    </>
+  );
+}
