@@ -0,0 +1,110 @@
+import type { CachePriority } from '../../protocol/messages.ts';
+
+type TaskKind = 'READ' | 'WRITE';
+
+interface Task {
+  kind: TaskKind;
+  priority: CachePriority;
+  run: () => Promise<unknown>;
+  resolve: (value: unknown) => void;
+  reject: (error: unknown) => void;
+}
+
+interface Lane {
+  queue: Task[];
+  readers: number;
+  writing: boolean;
+}
+
+let channel: MessageChannel | null = null;
+const waiting: (() => void)[] = [];
+
+export function yieldToEvents(): Promise<void> {
+  return new Promise((resolve) => {
+    if (typeof MessageChannel === 'undefined') {
+      setTimeout(resolve, 0);
+      return;
+    }
+    if (!channel) {
+      channel = new MessageChannel();
+      channel.port1.onmessage = () => waiting.shift()?.();
+    }
+    waiting.push(resolve);
+    channel.port2.postMessage(null);
+  });
+}
+
+export function createSlicer(sliceMs = 8): () => Promise<void> {
+  let started = performance.now();
+  return async () => {
+    if (performance.now() - started < sliceMs) return;
+    await yieldToEvents();
+    started = performance.now();
+  };
+}
+
+export class TaskScheduler {
+  private readonly lanes = new Map<string, Lane>();
+
+  read<T>(cache: string, priority: CachePriority, run: () => Promise<T>): Promise<T> {
+    return this.enqueue(cache, 'READ', priority, run);
+  }
+
+  write<T>(cache: string, priority: CachePriority, run: () => Promise<T>): Promise<T> {
+    return this.enqueue(cache, 'WRITE', priority, run);
+  }
+
+  private enqueue<T>(cache: string, kind: TaskKind, priority: CachePriority, run: () => Promise<T>): Promise<T> {
+    let lane = this.lanes.get(cache);
+    if (!lane) {
+      lane = { queue: [], readers: 0, writing: false };
+      this.lanes.set(cache, lane);
+    }
+    const target = lane;
+    return new Promise<T>((resolve, reject) => {
+      const task: Task = { kind, priority, run, resolve: resolve as (value: unknown) => void, reject };
+      const at = priority === 'INTERACTIVE' ? target.queue.findIndex((t) => t.priority === 'BACKGROUND') : -1;
+      if (at < 0) target.queue.push(task);
+      else target.queue.splice(at, 0, task);
+      this.pump(cache);
+    });
+  }
+
+  private pump(cache: string): void {
+    const lane = this.lanes.get(cache);
+    if (!lane) return;
+    while (lane.queue.length && !lane.writing) {
+      const next = lane.queue[0];
+      if (next.kind === 'WRITE' && lane.readers) break;
+      lane.queue.shift();
+      this.start(cache, lane, next);
+    }
+    if (!lane.queue.length && !lane.readers && !lane.writing) this.lanes.delete(cache);
+  }
+
+  private start(cache: string, lane: Lane, task: Task): void {
+    if (task.kind === 'WRITE') lane.writing = true;
+    else lane.readers++;
+    const finish = (): void => {
+      if (task.kind === 'WRITE') lane.writing = false;
+      else lane.readers--;
+      this.pump(cache);
+    };
+    let running: Promise<unknown>;
+    try {
+      running = task.run();
+    } catch (e) {
+      running = Promise.reject(e);
+    }
+    running.then(
+      (value) => {
+        finish();
+        task.resolve(value);
+      },
+      (error) => {
+        finish();
+        task.reject(error);
+      },
+    );
+  }
+}
