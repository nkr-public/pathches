+import { useT } from '@dec/i18n/react';
+import { ListTree } from 'lucide-react';
+import { useActiveWorkspaceId } from '@dec/workspace';
+import { messages } from '../../i18n/index.ts';
+import { revealSection, useOutlineSections } from '../outline.ts';
+import { SidePanelEmpty } from './SidePanel.tsx';
+
+export function OutlinePanel() {
+  const t = useT(messages);
+  const sections = useOutlineSections(useActiveWorkspaceId());
+
+  if (sections.length === 0) {
+    return <SidePanelEmpty icon={<ListTree size={18} />} title={t('shell.outlinePanel.empty')} hint={t('shell.outlinePanel.emptyHint')} />;
+  }
+
+  return (
+    <nav aria-label={t('shell.outline')}>
+      <ol className="sp-outline">
+        {sections.map((s) => (
+          <li key={s.id}>
+            <button type="button" className="sp-outline-item" onClick={() => revealSection(s)}>
+              {s.label}
+            </button>
+          </li>
+        ))}
+      </ol>
+    </nav>
+  );
+}
