+import type { CacheSyncResult, CacheUpdateAllResult } from '../../protocol/runtime.ts';
+import type { CacheEntry } from '../entry/CacheEntry.ts';
+import { noopSyncAdapter, syncAdapter } from './adapters.ts';
+
+export interface SyncEngineOptions {
+  headers: () => Record<string, string>;
+}
+
+const messageOf = (e: unknown): string => (e as Error | null)?.message ?? String(e);
+
+export class SyncEngine {
+  private readonly options: SyncEngineOptions;
+
+  constructor(options: SyncEngineOptions) {
+    this.options = options;
+  }
+
+  pushConfigured(entry: CacheEntry): boolean {
+    const endpoint = entry.definition.api.updateAll;
+    return !!endpoint && syncAdapter(endpoint) !== noopSyncAdapter;
+  }
+
+  async pull(entry: CacheEntry, signal: AbortSignal): Promise<CacheSyncResult> {
+    const endpoint = entry.definition.api.sync;
+    const result: CacheSyncResult = { cache: entry.name, status: 'NOT_CONFIGURED', applied: 0, conflicts: 0 };
+    if (!endpoint || !entry.definition.sync.enabled) return result;
+    const table = entry.requireTable();
+    const changes = await syncAdapter(endpoint).pull(
+      endpoint,
+      { cache: entry.name, syncedAt: entry.syncedAt ?? null, version: entry.version, headers: this.options.headers() },
+      signal,
+    );
+    if (changes === 'NOT_CONFIGURED') return result;
+    const outcome = table.applyRemote(changes);
+    return { ...result, status: 'DONE', applied: outcome.applied, conflicts: outcome.conflicts.length };
+  }
+
+  async push(entry: CacheEntry, signal: AbortSignal): Promise<CacheUpdateAllResult> {
+    const endpoint = entry.definition.api.updateAll;
+    const result: CacheUpdateAllResult = { cache: entry.name, status: 'NOT_CONFIGURED', confirmed: 0, rejected: 0, conflicts: 0 };
+    if (!endpoint || !this.pushConfigured(entry)) return result;
+    const table = entry.requireTable();
+    const changeSet = table.pendingCommits()[0] ?? table.prepareCommit();
+    if (!changeSet) return { ...result, status: 'SKIPPED' };
+    let results;
+    try {
+      results = await syncAdapter(endpoint).push(endpoint, changeSet, signal, this.options.headers());
+    } catch (e) {
+      const outcome = table.rejectCommit(changeSet.commitId, messageOf(e));
+      return { ...result, status: 'FAILED', rejected: outcome.rejected.length, conflicts: outcome.conflicts.length, error: messageOf(e) };
+    }
+    if (results === 'NOT_CONFIGURED') {
+      table.rejectCommit(changeSet.commitId, 'NOT_CONFIGURED');
+      return result;
+    }
+    const outcome = table.confirmCommit(changeSet.commitId, results);
+    return {
+      ...result,
+      status: outcome.rejected.length || outcome.conflicts.length ? 'FAILED' : 'DONE',
+      confirmed: outcome.confirmed.length,
+      rejected: outcome.rejected.length,
+      conflicts: outcome.conflicts.length,
+    };
+  }
+}
