+import { useEffect, useId, useRef, type ReactNode } from 'react';
+import { X } from 'lucide-react';
+import { useT } from '@dec/i18n/react';
+import { messages } from '../../i18n/index.ts';
+import './sidepanel.css';
+
+interface SidePanelProps {
+  title: string;
+  onClose: () => void;
+  footer?: ReactNode;
+  children: ReactNode;
+}
+
+export function SidePanel({ title, onClose, footer, children }: SidePanelProps) {
+  const t = useT(messages);
+  const titleId = useId();
+  const root = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    root.current?.focus({ preventScroll: true });
+  }, [title]);
+
+  return (
+    <div
+      ref={root}
+      className="sp-root"
+      role="dialog"
+      aria-labelledby={titleId}
+      tabIndex={-1}
+      onKeyDown={(e) => {
+        if (e.key !== 'Escape' || e.defaultPrevented) return;
+        e.stopPropagation();
+        onClose();
+      }}
+    >
+      <header className="sp-header">
+        <h2 id={titleId} className="sp-title">{title}</h2>
+        <button type="button" className="sp-close" aria-label={t('shell.panel.close')} onClick={onClose}>
+          <X size={14} aria-hidden="true" />
+        </button>
+      </header>
+      <div className="sp-body ui-scroll">{children}</div>
+      {footer && <footer className="sp-footer">{footer}</footer>}
+    </div>
+  );
+}
+
+export function SidePanelSection({ title, children }: { title: string; children: ReactNode }) {
+  const id = useId();
+  return (
+    <section className="sp-section" aria-labelledby={id}>
+      <h3 id={id} className="sp-section-title">{title}</h3>
+      {children}
+    </section>
+  );
+}
+
+export function SidePanelEmpty({ icon, title, hint }: { icon: ReactNode; title: string; hint?: string }) {
+  return (
+    <div className="sp-empty">
+      <span className="sp-empty-icon" aria-hidden="true">{icon}</span>
+      <p className="sp-empty-title">{title}</p>
+      {hint && <p className="sp-empty-hint">{hint}</p>}
+    </div>
+  );
+}
