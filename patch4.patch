+import type { CacheClientMessage, CacheServerMessage } from '../protocol/messages.ts';
+import type { CacheClientOptions, CacheTransportKind } from './types.ts';
+
+export interface TransportListener {
+  message(message: CacheServerMessage): void;
+  failure(reason: unknown): void;
+}
+
+export interface CacheTransport {
+  post(message: CacheClientMessage): void;
+  close(): void;
+}
+
+export function detectTransport(options: CacheClientOptions): CacheTransportKind {
+  if (options.transport) return options.transport;
+  if (options.createSharedWorker || typeof SharedWorker !== 'undefined') return 'SHARED_WORKER';
+  if (options.createWorker || typeof Worker !== 'undefined') return 'DEDICATED_WORKER';
+  return 'IN_PROCESS';
+}
+
+export async function openTransport(
+  kind: CacheTransportKind,
+  options: CacheClientOptions,
+  listener: TransportListener,
+): Promise<CacheTransport> {
+  if (kind === 'SHARED_WORKER') return openSharedWorker(options, listener);
+  if (kind === 'DEDICATED_WORKER') return openDedicatedWorker(options, listener);
+  return openInProcess(listener);
+}
+
+function openSharedWorker(options: CacheClientOptions, listener: TransportListener): CacheTransport {
+  const worker =
+    options.createSharedWorker?.() ??
+    new SharedWorker(new URL('../processors/shared.worker.ts', import.meta.url), { type: 'module', name: 'dec-cache' });
+  const port = worker.port;
+  worker.onerror = (event) => listener.failure(event);
+  port.onmessage = (event: MessageEvent<CacheServerMessage>) => listener.message(event.data);
+  port.onmessageerror = (event) => listener.failure(event);
+  port.start();
+  return {
+    post: (message) => port.postMessage(message),
+    close: () => {
+      worker.onerror = null;
+      port.onmessage = null;
+      port.onmessageerror = null;
+      port.close();
+    },
+  };
+}
+
+function openDedicatedWorker(options: CacheClientOptions, listener: TransportListener): CacheTransport {
+  const worker =
+    options.createWorker?.() ?? new Worker(new URL('../processors/dedicated.worker.ts', import.meta.url), { type: 'module' });
+  worker.onerror = (event) => listener.failure(event);
+  worker.onmessage = (event: MessageEvent<CacheServerMessage>) => listener.message(event.data);
+  worker.onmessageerror = (event) => listener.failure(event);
+  return {
+    post: (message) => worker.postMessage(message),
+    close: () => worker.terminate(),
+  };
+}
+
+async function openInProcess(listener: TransportListener): Promise<CacheTransport> {
+  const { createCacheServer } = await import('../processors/index.ts');
+  const server = createCacheServer();
+  const channel = new MessageChannel();
+  server.connect(channel.port2);
+  channel.port1.onmessage = (event: MessageEvent<CacheServerMessage>) => listener.message(event.data);
+  channel.port1.onmessageerror = (event) => listener.failure(event);
+  channel.port1.start();
+  return {
+    post: (message) => channel.port1.postMessage(message),
+    close: () => {
+      channel.port1.onmessage = null;
+      channel.port1.close();
+      void server.dispose();
+    },
+  };
+}
