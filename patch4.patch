+  }
+
+  private isStale(generation: number): boolean {
+    return this.disposed || generation !== this.generation;
+  }
+
+  private setState(state: CacheConnectionState): void {
+    if (this.state === state) return;
+    this.state = state;
+    for (const listener of [...this.connectionListeners]) listener(state);
+  }
+
+  private readonly handlePageHide = (): void => {
+    if (this.state === 'CONNECTED') this.rpc.notify('BYE', undefined, priorityOf('BYE'));
+  };
+
+  private readonly handlePageShow = (event: PageTransitionEvent): void => {
+    if (event.persisted) this.handleFailure(new CacheError('DISCONNECTED', 'Page restored from the back-forward cache'));
+  };
+}
