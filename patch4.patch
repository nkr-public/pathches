+import { useMemo } from 'react';
+import type { CacheKey, CacheRow } from '@dec/cache';
+import { useCacheClient } from '../CacheProvider.tsx';
+
+export interface CacheMutation {
+  insert(row: CacheRow): Promise<CacheKey>;
+  update(key: CacheKey, patch: CacheRow): Promise<void>;
+  remove(key: CacheKey): Promise<void>;
+  revert(keys?: CacheKey[]): Promise<void>;
+}
+
+export function useCacheMutation(cache: string): CacheMutation {
+  const client = useCacheClient();
+  return useMemo(
+    () => ({
+      insert: (row) => client.insert(cache, row),
+      update: (key, patch) => client.update(cache, key, patch),
+      remove: (key) => client.delete(cache, key),
+      revert: (keys) => client.revert(cache, keys),
+    }),
+    [client, cache],
+  );
+}
