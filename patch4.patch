+import type { ColumnType } from '@dec/core';
+
+export const SEPARATOR = 1;
+
+const DIACRITICS = /[̀-ͯ]/g;
+const encoder = new TextEncoder();
+
+export function foldText(text: string): string {
+  return text.toLowerCase().normalize('NFD').replace(DIACRITICS, '');
+}
+
+function pad(value: number, length: number): string {
+  return String(value).padStart(length, '0');
+}
+
+export function formatValue(value: unknown, type: ColumnType | undefined): string | null {
+  switch (typeof value) {
+    case 'string':
+      return value;
+    case 'number':
+      return Number.isFinite(value) ? String(value) : null;
+    case 'bigint':
+    case 'boolean':
+      return String(value);
+    default:
+      if (!(value instanceof Date) || Number.isNaN(value.getTime())) return null;
+      if (type === 'date') return `${value.getUTCFullYear()}-${pad(value.getUTCMonth() + 1, 2)}-${pad(value.getUTCDate(), 2)}`;
+      return value.toISOString().slice(0, 19).replace('T', ' ');
+  }
+}
+
+export function foldNeedle(text: string): Uint8Array {
+  const bytes = encoder.encode(foldText(text.trim()));
+  let length = 0;
+  for (let i = 0; i < bytes.length; i++) if (bytes[i] !== SEPARATOR) bytes[length++] = bytes[i];
+  return bytes.subarray(0, length);
+}
+
+export class FoldedTextWriter {
+  bytes: Uint8Array;
+  length = 0;
+  readonly histogram = new Uint32Array(256);
+
+  constructor(capacity: number) {
+    this.bytes = new Uint8Array(Math.max(capacity, 1024));
+  }
+
+  writeText(text: string): void {
+    const n = text.length;
+    this.reserve(n);
+    const bytes = this.bytes;
+    const histogram = this.histogram;
+    const start = this.length;
+    let at = start;
+    for (let i = 0; i < n; i++) {
+      let c = text.charCodeAt(i);
+      if (c >= 128) {
+        this.writeFolded(text, start, at);
+        return;
+      }
+      if (c >= 65 && c <= 90) c += 32;
+      bytes[at++] = c;
+      histogram[c]++;
+    }
+    this.length = at;
+  }
+
+  writeSeparator(): void {
+    this.reserve(1);
+    this.bytes[this.length++] = SEPARATOR;
+    this.histogram[SEPARATOR]++;
+  }
+
+  private writeFolded(text: string, start: number, partialEnd: number): void {
+    const histogram = this.histogram;
+    for (let i = start; i < partialEnd; i++) histogram[this.bytes[i]]--;
+    const folded = foldText(text);
+    this.length = start;
+    this.reserve(folded.length * 3);
+    const written = encoder.encodeInto(folded, this.bytes.subarray(start)).written;
+    const end = start + written;
+    for (let i = start; i < end; i++) histogram[this.bytes[i]]++;
+    this.length = end;
+  }
+
+  private reserve(extra: number): void {
+    const needed = this.length + extra;
+    if (needed <= this.bytes.length) return;
+    let capacity = this.bytes.length * 2;
+    while (capacity < needed) capacity *= 2;
+    const next = new Uint8Array(capacity);
+    next.set(this.bytes.subarray(0, this.length));
+    this.bytes = next;
+  }
+}
