+import type { SelectionIndex } from './SelectionIndex.ts';
+import type { TimeSlicer } from './TimeSlicer.ts';
+
+function rarestByteOffset(needle: Uint8Array, histogram: Uint32Array): number {
+  let best = 0;
+  for (let i = 1; i < needle.length; i++) if (histogram[needle[i]] < histogram[needle[best]]) best = i;
+  return best;
+}
+
+function rowContaining(offsets: Uint32Array, from: number, size: number, position: number): number {
+  let low = from;
+  let high = size - 1;
+  while (low < high) {
+    const middle = (low + high + 1) >>> 1;
+    if (offsets[middle] <= position) low = middle;
+    else high = middle - 1;
+  }
+  return low;
+}
+
+export async function searchRows(index: SelectionIndex, needle: Uint8Array, slicer: TimeSlicer): Promise<Uint32Array> {
+  const { text, offsets, size } = index;
+  const length = needle.length;
+  const anchor = rarestByteOffset(needle, index.histogram);
+  const anchorByte = needle[anchor];
+  if (index.histogram[anchorByte] === 0) return new Uint32Array(0);
+  let positions = new Uint32Array(1024);
+  let count = 0;
+  let row = 0;
+  let from = anchor;
+  let probes = 0;
+  const limit = text.length - length + anchor;
+  while (from <= limit) {
+    const hit = text.indexOf(anchorByte, from);
+    if (hit < 0 || hit > limit) break;
+    const start = hit - anchor;
+    let matched = true;
+    for (let j = 0; j < length; j++) {
+      if (text[start + j] !== needle[j]) {
+        matched = false;
+        break;
+      }
+    }
+    if (matched) {
+      row = rowContaining(offsets, row, size, start);
+      if (count === positions.length) {
+        const grown = new Uint32Array(Math.min(size, positions.length * 2));
+        grown.set(positions);
+        positions = grown;
+      }
+      positions[count++] = row;
+      from = offsets[row + 1] + anchor;
+      row++;
+    } else {
+      from = hit + 1;
+    }
+    if ((++probes & 1023) === 0 && slicer.shouldPause()) await slicer.pause();
+  }
+  return positions.length - count > 4096 ? positions.slice(0, count) : positions.subarray(0, count);
+}
