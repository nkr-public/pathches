+    if (typeof value.url !== 'string' || !value.url.startsWith('/') || value.url.startsWith('//')) fail(`api.${key}.url must be a relative URL starting with "/"`);
+    if (!METHODS.includes(value.method)) fail(`api.${key}.method "${String(value.method)}" is not supported`);
+    const adapter = value.adapter ?? 'default';
+    if (!hasAdapter(adapter)) throw new CacheError('UNKNOWN_ADAPTER', `cache "${name}": api.${key} uses unknown adapter "${adapter}"`);
+  };
+  endpoint('load', api.load, hasDatasetAdapter);
+  endpoint('refresh', api.refresh, hasDatasetAdapter);
+  endpoint('sync', api.sync, hasSyncAdapter);
+  endpoint('updateAll', api.updateAll, hasSyncAdapter);
