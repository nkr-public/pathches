+import { createContext, useCallback, useContext, useEffect, useRef, useState, useSyncExternalStore, type ReactNode } from 'react';
+import { createCacheClient, type CacheClient, type CacheClientOptions, type CacheConnectionState } from '@dec/cache';
+
+const CacheClientContext = createContext<CacheClient | null>(null);
+
+export type CacheProviderProps = { children: ReactNode } & (
+  | { client: CacheClient; options?: never }
+  | { options: CacheClientOptions; client?: never }
+);
+
+export function CacheProvider({ client: providedClient, options, children }: CacheProviderProps) {
+  const [ownedClient, setOwnedClient] = useState<CacheClient | null>(null);
+  const optionsRef = useRef(options);
+
+  useEffect(() => {
+    if (providedClient || !optionsRef.current) return;
+    const created = createCacheClient(optionsRef.current);
+    setOwnedClient(created);
+    return () => {
+      created.dispose();
+      setOwnedClient(null);
+    };
+  }, [providedClient]);
+
+  const client = providedClient ?? ownedClient;
+  if (!client) return null;
+  return <CacheClientContext.Provider value={client}>{children}</CacheClientContext.Provider>;
+}
+
+export function useOptionalCacheClient(): CacheClient | null {
+  return useContext(CacheClientContext);
+}
+
+export function useCacheClient(): CacheClient {
+  const client = useContext(CacheClientContext);
+  if (!client) throw new Error('useCacheClient must be used inside a CacheProvider');
+  return client;
+}
+
+export function useCacheConnection(): CacheConnectionState {
+  const client = useCacheClient();
+  const subscribe = useCallback((notify: () => void) => client.onConnection(notify), [client]);
+  const read = useCallback(() => client.connection(), [client]);
+  return useSyncExternalStore(subscribe, read, read);
+}
