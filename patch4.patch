+
+export interface CacheCommandMap {
+  HELLO: { payload: { protocol: number; scope: string }; result: { protocol: number; restarted: boolean } };
+  BYE: { payload: void; result: void };
+  SET_CREDENTIALS: { payload: { headers: Record<string, string> }; result: void };
+  REGISTER: { payload: { definitions: CacheDefinition[] }; result: void };
+  UNREGISTER: { payload: { name: string; discardChanges?: boolean }; result: void };
+  SUBSCRIBE: { payload: { workspaceId: string; caches: string[]; activity: WorkspaceActivity }; result: void };
+  SET_ACTIVITY: { payload: { workspaceId: string; activity: WorkspaceActivity }; result: void };
+  UNSUBSCRIBE: { payload: { workspaceId: string }; result: void };
+  WATCH: { payload: { caches: string[] | null }; result: void };
+  SELECT: { payload: { cache: string; text: string }; result: CacheView };
+  ROWS: { payload: { viewId: string; start: number; end: number }; result: CacheRows };
+  CLOSE_VIEW: { payload: { viewId: string }; result: void };
+  GET: { payload: { cache: string; keys: CacheKey[]; columns?: string[] }; result: (CacheRow | null)[] };
+  INSERT: { payload: { cache: string; row: CacheRow }; result: CacheKey };
+  UPDATE: { payload: { cache: string; key: CacheKey; patch: CacheRow }; result: void };
+  DELETE: { payload: { cache: string; key: CacheKey }; result: void };
+  REVERT: { payload: { cache: string; keys?: CacheKey[] }; result: void };
+  REFRESH: { payload: { cache: string }; result: void };
+  SYNC: { payload: { caches?: string[] }; result: CacheSyncResult[] };
+  CHANGE_SUMMARY: { payload: { caches?: string[] }; result: Record<string, CacheChangeSummary> };
+  UPDATE_ALL: { payload: { caches?: string[] }; result: CacheUpdateAllResult[] };
+  PERSIST: { payload: { cache: string }; result: void };
+  EVICT: { payload: { cache: string }; result: void };
+  CLEAR: { payload: { cache: string; discardChanges?: boolean }; result: void };
+  STATUS: { payload: { cache: string }; result: CacheRuntime };
+  LIST: { payload: void; result: CacheRuntime[] };
+  MEMORY: { payload: void; result: CacheMemoryStats };
+}
+
+export type CacheCommand = keyof CacheCommandMap;
+
+export type CachePayload<C extends CacheCommand> = CacheCommandMap[C]['payload'];
+
+export type CacheResult<C extends CacheCommand> = CacheCommandMap[C]['result'];
+
+export type CacheRequest = {
+  [C in CacheCommand]: {
+    type: 'req';
+    id: number;
+    clientId: string;
+    command: C;
+    payload: CachePayload<C>;
+    priority: CachePriority;
+    timeoutMs?: number;
+  };
+}[CacheCommand];
+
+export interface CacheCancel {
+  type: 'cancel';
+  id: number;
+  clientId: string;
+}
+
+export type CacheClientMessage = CacheRequest | CacheCancel;
+
+export interface CacheFailure {
+  code: CacheErrorCode;
+  message: string;
+}
+
+export type CacheResponse =
+  | { type: 'res'; id: number; ok: true; result: unknown }
+  | { type: 'res'; id: number; ok: false; error: CacheFailure };
+
+export interface CacheEventBatch {
+  type: 'events';
+  events: CacheEvent[];
+}
+
+export type CacheServerMessage = CacheResponse | CacheEventBatch;
+
+export type CacheErrorCode =
+  | 'INVALID_DEFINITION'
+  | 'INVALID_REQUEST'
+  | 'UNKNOWN_CACHE'
+  | 'UNKNOWN_VIEW'
+  | 'UNKNOWN_ADAPTER'
+  | 'NOT_MOUNTED'
+  | 'VALIDATION'
+  | 'DUPLICATE_KEY'
+  | 'NOT_FOUND'
+  | 'DIRTY'
+  | 'NETWORK'
+  | 'PERSISTENCE'
+  | 'TIMEOUT'
+  | 'ABORTED'
+  | 'DISCONNECTED'
+  | 'PROTOCOL'
+  | 'INTERNAL';
+
+export class CacheError extends Error {
+  readonly code: CacheErrorCode;
