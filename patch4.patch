+  readonly offsets: Uint32Array;
+  readonly histogram: Uint32Array;
+  readonly keys: PrimaryKey[];
+  readonly bytes: number;
+}
+
+interface SortKeys {
+  numbers: Float64Array | null;
+  texts: (string | null)[] | null;
+  type: ColumnType | undefined;
+}
+
+const CHECK_MASK = 1023;
+
+export function selectionColumns(definition: CacheDefinition): string[] {
+  const columns = definition.selection.columns;
+  if (columns.length > 0) return columns;
+  return definition.schema.columns.filter((column) => !column.hidden).map((column) => column.id);
+}
+
+function columnTypes(definition: CacheDefinition): Map<string, ColumnType> {
+  const types = new Map<string, ColumnType>();
+  for (const column of definition.schema.columns) types.set(column.id, column.type);
+  return types;
+}
+
+function numericValue(value: unknown, type: ColumnType | undefined): number {
+  switch (typeof value) {
+    case 'number':
+      return value;
+    case 'bigint':
+      return Number(value);
+    case 'boolean':
+      return value ? 1 : 0;
+    case 'string':
+      return type === 'date' || type === 'timestamp' ? Date.parse(value) : value === '' ? NaN : Number(value);
+    default:
+      return value instanceof Date ? value.getTime() : NaN;
+  }
+}
+
+function recordSortKey(keys: SortKeys, ordinal: number, value: unknown): void {
+  if (keys.numbers !== null) {
+    if (ordinal >= keys.numbers.length) {
+      const grown = new Float64Array(keys.numbers.length * 2 + 16);
+      grown.set(keys.numbers);
+      keys.numbers = grown;
+    }
+    keys.numbers[ordinal] = numericValue(value, keys.type);
+    return;
+  }
+  const text = formatValue(value, keys.type);
+  keys.texts!.push(text === null ? null : foldText(text));
+}
+
+function comparatorFor(keys: SortKeys, descending: boolean): OrdinalComparator {
+  const direction = descending ? -1 : 1;
+  const numbers = keys.numbers;
+  if (numbers !== null) {
+    return (a, b) => {
+      const x = numbers[a];
+      const y = numbers[b];
+      const xMissing = x !== x;
+      const yMissing = y !== y;
+      if (xMissing || yMissing) return xMissing === yMissing ? a - b : xMissing ? 1 : -1;
+      return x < y ? -direction : x > y ? direction : a - b;
+    };
+  }
+  const texts = keys.texts!;
+  return (a, b) => {
+    const x = texts[a];
+    const y = texts[b];
+    if (x === null || y === null) return x === y ? a - b : x === null ? 1 : -1;
+    return x < y ? -direction : x > y ? direction : a - b;
+  };
+}
+
+function growOffsets(offsets: Uint32Array, needed: number): Uint32Array {
+  if (needed < offsets.length) return offsets;
+  const grown = new Uint32Array(Math.max(needed + 1, offsets.length * 2));
+  grown.set(offsets);
+  return grown;
+}
+
+export async function buildSelectionIndex(id: number, definition: CacheDefinition, version: number, table: Table, slicer: TimeSlicer): Promise<SelectionIndex> {
+  const columns = selectionColumns(definition);
+  const types = columnTypes(definition);
+  const columnTypeList = columns.map((column) => types.get(column));
+  const orderBy = definition.selection.orderBy ?? null;
+  const expected = table.size;
+  const orderType = orderBy ? types.get(orderBy.field) : undefined;
+  const sortKeys: SortKeys | null = orderBy
+    ? orderType === 'string' || orderType === undefined
+      ? { numbers: null, texts: [], type: orderType }
+      : { numbers: new Float64Array(expected), texts: null, type: orderType }
+    : null;
+  const writer = new FoldedTextWriter(expected * (columns.length * 12 + 1));
+  const scanned: PrimaryKey[] = [];
+  let offsets: Uint32Array = new Uint32Array(expected + 1);
+  let keyChars = 0;
+  let count = 0;
+  for (const [key, row] of table.scan()) {
+    offsets = growOffsets(offsets, count + 1);
+    offsets[count] = writer.length;
+    for (let c = 0; c < columns.length; c++) {
+      const text = formatValue(row[columns[c]], columnTypeList[c]);
+      if (text !== null) writer.writeText(text);
+      writer.writeSeparator();
+    }
+    if (sortKeys !== null) recordSortKey(sortKeys, count, row[orderBy!.field]);
+    scanned.push(key);
+    keyChars += key.length;
+    count++;
+    if ((count & CHECK_MASK) === 0 && slicer.shouldPause()) await slicer.pause();
+  }
+  offsets = growOffsets(offsets, count);
+  offsets[count] = writer.length;
+  let text: Uint8Array = writer.bytes.slice(0, writer.length);
+  let keys = scanned;
+  if (sortKeys !== null && count > 1) {
+    const identity = new Uint32Array(count);
+    for (let i = 0; i < count; i++) identity[i] = i;
+    const order = await sortOrder(identity, comparatorFor(sortKeys, orderBy!.direction === 'DESC'), slicer);
+    const sortedText = new Uint8Array(text.length);
+    const sortedOffsets = new Uint32Array(count + 1);
+    const sortedKeys = new Array<PrimaryKey>(count);
+    let at = 0;
+    for (let p = 0; p < count; p++) {
+      const r = order[p];
+      const from = offsets[r];
+      const to = offsets[r + 1];
+      sortedOffsets[p] = at;
+      sortedText.set(text.subarray(from, to), at);
+      at += to - from;
+      sortedKeys[p] = scanned[r];
+      if ((p & CHECK_MASK) === CHECK_MASK && slicer.shouldPause()) await slicer.pause();
+    }
+    sortedOffsets[count] = at;
+    text = sortedText;
+    offsets = sortedOffsets;
+    keys = sortedKeys;
+  } else if (offsets.length > count + 1) {
+    offsets = offsets.slice(0, count + 1);
+  }
+  const bytes = text.byteLength + offsets.byteLength + 1024 + count * 8 + count * 16 + keyChars * 2;
+  return { id, version, table, size: count, text, offsets, histogram: writer.histogram, keys, bytes };
+}
