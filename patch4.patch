+import { useSyncExternalStore } from 'react';
+import { subscribeApiErrors, type ApiFailure } from '@dec/client-api';
+import { listStoreWorkspaces, subscribeStoreWorkspaces, type StoreWorkspace, type StoreWorkspaceEvent } from '@dec/workspace';
+
+export type NotificationKind = 'apiError' | 'apiUnreachable' | 'storeError' | 'saveFailed' | 'savePartial' | 'conflict';
+export type NotificationTone = 'danger' | 'warning';
+
+export interface AppNotification {
+  id: string;
+  kind: NotificationKind;
+  tone: NotificationTone;
+  params: Record<string, string | number>;
+  detail: string;
+  source: string;
+  time: number;
+  read: boolean;
+  repeat: number;
+  storeWorkspaceId?: string;
+}
+
+const MAX_ENTRIES = 100;
+const MERGE_WINDOW_MS = 30_000;
+
+let entries: readonly AppNotification[] = [];
+const listeners = new Set<() => void>();
+let seq = 0;
+
+const emit = (): void => {
+  for (const listener of [...listeners]) listener();
+};
+
+const signatureOf = (n: Pick<AppNotification, 'kind' | 'source' | 'detail'>): string => `${n.kind}|${n.source}|${n.detail}`;
+
+function push(input: Omit<AppNotification, 'id' | 'time' | 'read' | 'repeat'>): void {
+  const now = Date.now();
+  const signature = signatureOf(input);
+  const latest = entries[0];
+  if (latest && signatureOf(latest) === signature && now - latest.time < MERGE_WINDOW_MS) {
+    entries = [{ ...latest, time: now, read: false, repeat: latest.repeat + 1 }, ...entries.slice(1)];
+  } else {
+    entries = [{ ...input, id: `n-${++seq}`, time: now, read: false, repeat: 1 }, ...entries].slice(0, MAX_ENTRIES);
+  }
+  emit();
+}
+
+function fromApiFailure(failure: ApiFailure): void {
+  const unreachable = failure.status === 0;
+  push({
+    kind: unreachable ? 'apiUnreachable' : 'apiError',
+    tone: unreachable || failure.status >= 500 ? 'danger' : 'warning',
+    params: { status: failure.status },
+    detail: failure.message,
+    source: `${failure.method} ${failure.path}`,
+  });
+}
+
+function fromWorkspaceEvent(event: StoreWorkspaceEvent): void {
+  const storeWorkspaceId = event.workspaceId;
+  switch (event.type) {
+    case 'store:error':
+      push({ kind: 'storeError', tone: 'danger', params: { store: event.store }, detail: event.error, source: event.store, storeWorkspaceId });
+      return;
+    case 'updateAll:failed':
+      push({ kind: 'saveFailed', tone: 'danger', params: {}, detail: event.error ?? event.outcome?.errors[0]?.message ?? '', source: storeWorkspaceId, storeWorkspaceId });
+      return;
+    case 'updateAll:succeeded':
+      if (event.outcome?.status !== 'partial') return;
+      push({
+        kind: 'savePartial',
+        tone: 'warning',
+        params: { saved: event.outcome.saved, failed: event.outcome.failed + event.outcome.conflicts },
+        detail: event.outcome.errors[0]?.message ?? '',
+        source: storeWorkspaceId,
+        storeWorkspaceId,
+      });
+      return;
+    case 'conflict':
+      push({ kind: 'conflict', tone: 'warning', params: { count: event.keys.length, store: event.store }, detail: event.keys.slice(0, 5).join(', '), source: event.store, storeWorkspaceId });
+      return;
+    default:
+      return;
+  }
+}
+
+const watched = new Map<StoreWorkspace, () => void>();
+
+function syncWatchedWorkspaces(): void {
+  const current = new Set(listStoreWorkspaces());
+  for (const [workspace, stop] of watched) {
+    if (current.has(workspace)) continue;
+    stop();
+    watched.delete(workspace);
+  }
+  for (const workspace of current) {
+    if (!watched.has(workspace)) watched.set(workspace, workspace.on('*', fromWorkspaceEvent));
+  }
+}
+
+let started = false;
+
+function startListening(): void {
+  if (started) return;
+  started = true;
+  subscribeApiErrors(fromApiFailure);
+  subscribeStoreWorkspaces(syncWatchedWorkspaces);
+  syncWatchedWorkspaces();
+}
+
+function subscribe(listener: () => void): () => void {
+  startListening();
+  listeners.add(listener);
+  return () => void listeners.delete(listener);
+}
+
+const readEntries = (): readonly AppNotification[] => entries;
+
+export function useNotifications(): readonly AppNotification[] {
+  return useSyncExternalStore(subscribe, readEntries, readEntries);
+}
+
+export function useUnreadCount(): number {
+  return useSyncExternalStore(subscribe, () => countUnread(entries), () => 0);
+}
+
+function countUnread(list: readonly AppNotification[]): number {
+  let count = 0;
+  for (const n of list) if (!n.read) count++;
+  return count;
+}
+
+export function markAllRead(): void {
+  if (!entries.some((n) => !n.read)) return;
+  entries = entries.map((n) => (n.read ? n : { ...n, read: true }));
+  emit();
+}
+
+export function clearNotifications(): void {
+  entries = [];
+  emit();
+}
