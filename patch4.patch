+import type { Table } from '@dec/data-engine';
+import type { CacheDefinition } from '../protocol/definition.ts';
+import type { CacheEvent, CacheEventBatch } from '../protocol/index.ts';
+import type { CacheResidency, CacheRows, CacheView, WorkspaceActivity } from '../protocol/runtime.ts';
+
+export interface CacheHandle {
+  readonly name: string;
+  readonly definition: CacheDefinition;
+  readonly version: number;
+  readonly table: Table | null;
+}
+
+export interface SelectionService {
+  select(cache: CacheHandle, clientId: string, text: string, signal: AbortSignal): Promise<CacheView>;
+  rows(viewId: string, start: number, end: number): CacheRows;
+  closeView(viewId: string): void;
+  closeClient(clientId: string): void;
+  invalidate(cache: string): void;
+  memoryBytes(cache: string): number;
+  sweep(now: number): void;
+}
+
+export interface SelectionManagerOptions {
+  now: () => number;
+  viewTtlMs: number;
+  sliceMs: number;
+}
+
+export interface ResidencyCandidate {
+  readonly name: string;
+  readonly mounted: boolean;
+  readonly busy: boolean;
+  readonly protected: boolean;
+  readonly memoryBytes: number;
+  readonly lastAccessAt: number;
+  readonly evictionEnabled: boolean;
+  readonly idleTimeoutMs: number | null;
+  readonly priority: number;
+}
+
+export interface ResidencyHost {
+  candidates(): Iterable<ResidencyCandidate>;
+  mount(cache: string): Promise<void>;
+  unmount(cache: string): Promise<void>;
+  residencyChanged(cache: string, residency: CacheResidency): void;
+}
+
+export interface ResidencyService {
+  subscribe(clientId: string, workspaceId: string, caches: readonly string[], activity: WorkspaceActivity): void;
+  setActivity(clientId: string, workspaceId: string, activity: WorkspaceActivity): void;
+  unsubscribe(clientId: string, workspaceId: string): void;
+  closeClient(clientId: string): void;
+  forget(cache: string): void;
+  residency(cache: string): CacheResidency;
+  consumers(cache: string): number;
+  wanted(cache: string): boolean;
+  touch(cache: string): void;
+  usedBytes(): number;
+  evaluate(): Promise<void>;
+  start(): void;
+  stop(): void;
+}
+
+export interface ResidencyManagerOptions {
+  host: ResidencyHost;
+  budgetBytes: number;
+  tickMs: number;
+  defaultIdleTimeoutMs: number;
+  now: () => number;
+}
+
+export interface LockManagerLike {
+  request<T>(name: string, options: { mode: 'exclusive' }, callback: (lock: unknown) => Promise<T> | T): Promise<T>;
+}
+
+export interface ClientService {
+  open(clientId: string, send: (message: CacheEventBatch) => void): void;
+  close(clientId: string): void;
+  has(clientId: string): boolean;
+  count(): number;
+}
+
+export interface ClientRegistryOptions {
+  closed: (clientId: string) => void;
+  locks: LockManagerLike | null;
+}
+
+export interface EventService {
+  publish(event: CacheEvent): void;
+  addClient(clientId: string, send: (message: CacheEventBatch) => void): void;
+  removeClient(clientId: string): void;
+  watch(clientId: string, caches: readonly string[] | null): void;
+  follow(clientId: string, caches: readonly string[]): void;
+  unfollow(clientId: string, caches: readonly string[]): void;
+  flush(): void;
+}
+
+export interface EventBusOptions {
+  flushMs: number;
+  maxKeys: number;
+}
+
+export interface CachePort {
+  postMessage(message: unknown, transfer?: Transferable[]): void;
+  onmessage: ((event: MessageEvent) => void) | null;
+  start?(): void;
+}
+
+export interface CacheServerOptions {
+  budgetBytes?: number;
+  storageName?: string;
+  locks?: LockManagerLike | null;
+  now?: () => number;
+}
+
+export interface CacheServer {
+  connect(port: CachePort): void;
+  dispose(): Promise<void>;
+}
