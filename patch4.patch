+import { CacheError } from '../../protocol/messages.ts';
+
+let channel: MessageChannel | null = null;
+const pending: (() => void)[] = [];
+
+function resumeNext(): void {
+  pending.shift()?.();
+}
+
+export function yieldToEventLoop(): Promise<void> {
+  return new Promise((resolve) => {
+    if (channel === null && typeof MessageChannel !== 'undefined') {
+      channel = new MessageChannel();
+      channel.port1.onmessage = resumeNext;
+    }
+    if (channel === null) {
+      setTimeout(resolve, 0);
+      return;
+    }
+    pending.push(resolve);
+    channel.port2.postMessage(null);
+  });
+}
+
+export function abortedError(): CacheError {
+  return new CacheError('ABORTED', 'selection aborted');
+}
+
+export class TimeSlicer {
+  private readonly sliceMs: number;
+  private readonly signal: AbortSignal;
+  private readonly now: () => number;
+  private sliceStart: number;
+
+  constructor(sliceMs: number, signal: AbortSignal, now: () => number) {
+    this.sliceMs = sliceMs;
+    this.signal = signal;
+    this.now = now;
+    this.ensureNotAborted();
+    this.sliceStart = now();
+  }
+
+  shouldPause(): boolean {
+    return this.now() - this.sliceStart >= this.sliceMs;
+  }
+
+  async pause(): Promise<void> {
+    this.ensureNotAborted();
+    await yieldToEventLoop();
+    this.ensureNotAborted();
+    this.sliceStart = this.now();
+  }
+
+  ensureNotAborted(): void {
+    if (this.signal.aborted) throw abortedError();
+  }
+}
