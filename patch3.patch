new file mode 100644
--- /dev/null	(date 1795167440810)
+++ b/frontend/packages/workspace/src/stores/changePreferences.ts	(date 1795167440810)
@@ -0,0 +1,27 @@
+const PREFIX = 'dec-store-persist-changes:';
+const listeners = new Set<() => void>();
+
+const keyOf = (workspaceId: string, store: string): string => `${PREFIX}${workspaceId}:${store}`;
+
+export function readPersistChanges(workspaceId: string, store: string): boolean | null {
+  try {
+    const value = globalThis.localStorage?.getItem(keyOf(workspaceId, store));
+    return value === null || value === undefined ? null : value === 'true';
+  } catch {
+    return null;
+  }
+}
+
+export function writePersistChanges(workspaceId: string, store: string, enabled: boolean): void {
+  try {
+    globalThis.localStorage?.setItem(keyOf(workspaceId, store), String(enabled));
+  } catch {
+    return;
+  }
+  for (const listener of [...listeners]) listener();
+}
+
+export function subscribePersistChanges(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => void listeners.delete(listener);
+}
