@@ -0,0 +1,38 @@
+import { useT } from '@dec/i18n/react';
+import { useEffect, useState } from 'react';
+import { ConfirmDialog } from '@dec/ui';
+import { reloadWithoutPrompt } from '@dec/workspace';
+import { messages } from '../i18n/index.ts';
+
+const isReloadShortcut = (e: KeyboardEvent) =>
+  e.key === 'F5' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'r');
+
+export function ReloadGuard() {
+  const t = useT(messages);
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    const onKeyDown = (e: KeyboardEvent) => {
+      if (!isReloadShortcut(e)) return;
+      e.preventDefault();
+      e.stopPropagation();
+      setOpen(true);
+    };
+    window.addEventListener('keydown', onKeyDown, true);
+    return () => window.removeEventListener('keydown', onKeyDown, true);
+  }, []);
+
+  return (
+    <ConfirmDialog
+      open={open}
+      onOpenChange={setOpen}
+      tone="danger"
+      centered
+      title={t('shell.reload.title')}
+      description={t('shell.reload.description')}
+      confirmLabel={t('shell.reload.confirm')}
+      cancelLabel={t('shell.reload.cancel')}
+      onConfirm={reloadWithoutPrompt}
+    />
+  );
+}
