import type { WorkspaceComponentProps } from '@dec/layout';
import { AccountDef, type FieldRule } from '@dec/cr-factory';
import { extendGenericWorkspace } from './GridWorkspaces.tsx';

const toHeader = (name: string) => name.replace(/([A-Z])/g, ' $1').replace(/^./, (c) => c.toUpperCase());
const toWidth = (f: FieldRule) => Math.min(Math.max((f.size ?? f.max ?? 12) * 8, 100), 280);

const ACCOUNT_COLUMNS = AccountDef.fields.map((f) => ({
  id: f.field,
  headerName: toHeader(f.field),
  width: toWidth(f),
  editable: !f.isPrimaryKey && !f.isGenerated,
}));

const ACCOUNT_KEY = AccountDef.fields.find((f) => f.isPrimaryKey)?.field ?? AccountDef.fields[0].field;

function AccountHeader({ workspaceId }: WorkspaceComponentProps) {
  return (
    <div style={{ padding: '12px 12px 8px' }}>
      <h2 style={{ margin: 0, fontSize: 16 }}>Accounts</h2>
      <p style={{ margin: '4px 0 0', fontSize: 12, opacity: 0.7 }}>Generic workspace · {workspaceId}</p>
    </div>
  );
}

export const AccountGenericWorkspace = extendGenericWorkspace({
  header: AccountHeader,
  columns: ACCOUNT_COLUMNS,
  keyColumn: ACCOUNT_KEY,
  rows: 50_000,
  height: 480,
});
